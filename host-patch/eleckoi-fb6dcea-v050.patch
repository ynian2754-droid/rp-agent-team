+      after,
+      legacySource: LEGACY_SOURCE,
+      ...(!exactAnchor ? { legacyAnchorMissing: true } : {}),
+      ...(legacyStateUnavailable ? {
+        legacyStateUnavailable: true,
+        legacyWorldBeforeJson: String(edit.beforeWorldJson),
+        legacyWorldAfterJson: String(edit.afterWorldJson)
+      } : {}),
+      createdAt: edit.createdAt
+    })
+  }
+
+  imports.sort((left, right) => time(left).localeCompare(time(right)) || left.operationId.localeCompare(right.operationId))
+  for (const operation of imports) {
+    const prior = known.get(operation.operationId)
+    if (prior) {
+      if (JSON.stringify({ ...prior, revision: 0 }) !== JSON.stringify({ ...operation, revision: 0 })) {
+        throw new Error(`Legacy operation changed during repeat conversion: ${operation.operationId}`)
+      }
+      continue
+    }
+    operation.revision = ++revision
+    operations.push(operation)
+    known.set(operation.operationId, operation)
+  }
+  snapshot.version = 2
+  snapshot.stateHistory = { version: 1, operations }
+  return { ...archive, snapshot }
+}
+
+function readLegacyData(databasePath, conversationId) {
+  const database = new Database(databasePath, { readonly: true, fileMustExist: true })
+  try {
+    const version = Number(database.pragma('user_version', { simple: true }))
+    if (version !== 10) throw new Error(`Expected read-only v10 source database, got schema ${version}`)
+    const receipts = database.prepare('SELECT * FROM eleckoi_product_commits WHERE conversationId=? ORDER BY createdAt,runId')
+      .all(conversationId)
+    const edits = database.prepare('SELECT * FROM eleckoi_author_world_edits WHERE conversationId=? ORDER BY revision,createdAt')
+      .all(conversationId)
+    const snapshot = database.prepare('SELECT characterId FROM chat_sessions WHERE id=?').get(conversationId)
+    const settingLibraries = snapshot?.characterId
+      ? { [snapshot.characterId]: legacySettingLibrary(database, snapshot.characterId, conversationId) } : {}
+    return { receipts, edits, settingLibraries }
+  } finally {
+    database.close()
+  }
+}
+
+const CONVERSATION_TABLES = [
+  'chat_sessions', 'chat_session_character_snapshots', 'chat_session_variable_states',
+  'agent_conversations', 'agent_branches', 'conversation_speakers', 'agent_turns',
+  'agent_responses', 'agent_branch_turns', 'agent_openings', 'agent_setting_snapshots'
+]
+
+function readOfficialConversationSnapshot(database, conversationId) {
+  const session = database.prepare('SELECT * FROM chat_sessions WHERE id=?').get(conversationId)
+  if (!session || typeof session.characterId !== 'string' || !session.characterId) {
+    throw new Error(`Conversation ${conversationId} has no official character association`)
+  }
+  const tables = {}
+  for (const table of CONVERSATION_TABLES) {
+    const key = table === 'chat_sessions' || table === 'agent_conversations' ? 'id'
+      : table === 'agent_branch_turns' ? ''
+        : table === 'chat_session_character_snapshots' || table === 'chat_session_variable_states' ? 'sessionId' : 'conversationId'
+    tables[table] = table === 'agent_branch_turns'
+      ? database.prepare(`SELECT p.* FROM agent_branch_turns p JOIN agent_branches b ON b.id=p.branchId WHERE b.conversationId=? ORDER BY p.branchId,p.sequence`).all(conversationId)
+      : database.prepare(`SELECT * FROM ${table} WHERE ${key}=?`).all(conversationId)
+  }
+  if (tables.agent_conversations.length !== 1) throw new Error(`Conversation ${conversationId} has no unique official Agent conversation row`)
+  for (const [table, rows] of Object.entries(tables)) {
+    for (const row of rows) {
+      for (const [column, value] of Object.entries(row)) {
+        if (value !== null && typeof value !== 'string' && typeof value !== 'number') {
+          throw new Error(`Unsupported source value in ${table}.${column}; official archive cells must be scalar`)
+        }
+      }
+    }
+  }
+  return {
+    format: 'eleckoi.desktop-conversation', version: 1, characterId: session.characterId,
+    conversationId, tables
+  }
+}
+
+function readNativeSessionIndex(sessionsRoot) {
+  const byId = new Map()
+  const pending = [resolve(sessionsRoot)]
+  while (pending.length) {
+    const directory = pending.pop()
+    for (const entry of readdirSync(directory, { withFileTypes: true })) {
+      const path = join(directory, entry.name)
+      if (entry.isDirectory()) pending.push(path)
+      else if (entry.isFile() && /^session\.v4\.jsonl$/u.test(entry.name)) {
+        const rows = readFileSync(path, 'utf8').split(/\r?\n/u).filter(line => line.trim()).map((line, index) => {
+          try { return JSON.parse(line) } catch (error) { throw new Error(`Malformed DSH row ${index + 1} in ${path}`, { cause: error }) }
+        })
+        if (!rows.length) throw new Error(`Empty DSH session log: ${path}`)
+        const restore = sessionFormatCatalog.createRestore(rows[0], { recovery: 'strict', validation: 'current' })
+        for (const row of rows.slice(1)) restore.decodeRow(row)
+        const log = restore.finish()
+        if (byId.has(log.header.id)) throw new Error(`Duplicate native DSH session ID: ${log.header.id}`)
+        byId.set(log.header.id, {
+          header: log.header,
+          inheritedEventCount: log.inheritedEventCount,
+          events: log.events
+        })
+      }
+    }
+  }
+  return byId
+}
+
+function readPluginTraceReferences(pluginRoot, runtimeSessionToConversation) {
+  const directory = join(resolve(pluginRoot), 'traces')
+  const pending = [directory]
+  const byConversation = new Map()
+  const unmappedTraceFiles = []
+  const handoffSidecarFiles = []
+  while (pending.length) {
+    const current = pending.pop()
+    let entries
+    try { entries = readdirSync(current, { withFileTypes: true }) }
+    catch (error) {
+      if (error?.code === 'ENOENT' && current === directory) return { byConversation, unmappedTraceFiles, handoffSidecarFiles }
+      throw error
+    }
+    for (const entry of entries) {
+      const path = join(current, entry.name)
+      if (entry.isDirectory()) pending.push(path)
+      else if (entry.isFile() && entry.name.endsWith('.json.handoffs.json')) {
+        handoffSidecarFiles.push(basename(path))
+      } else if (entry.isFile() && entry.name.endsWith('.json')) {
+        const trace = JSON.parse(readFileSync(path, 'utf8'))
+        const rootSessionId = typeof trace.rootSessionId === 'string' ? trace.rootSessionId : ''
+        const conversationId = runtimeSessionToConversation.get(rootSessionId)
+        if (!conversationId) {
+          unmappedTraceFiles.push(basename(path))
+          continue
+        }
+        const references = byConversation.get(conversationId) ?? { sessionIds: new Set(), traceCount: 0 }
+        references.traceCount += 1
+        references.sessionIds.add(rootSessionId)
+        for (const id of Array.isArray(trace.childSessionIds) ? trace.childSessionIds : []) {
+          if (typeof id === 'string' && id) references.sessionIds.add(id)
+        }
+        for (const execution of Array.isArray(trace.executionSessions) ? trace.executionSessions : []) {
+          if (typeof execution?.sessionId === 'string' && execution.sessionId) references.sessionIds.add(execution.sessionId)
+          if (typeof execution?.parentSessionId === 'string' && execution.parentSessionId) references.sessionIds.add(execution.parentSessionId)
+        }
+        byConversation.set(conversationId, references)
+      }
+    }
+  }
+  return { byConversation, unmappedTraceFiles: unmappedTraceFiles.sort(), handoffSidecarFiles: handoffSidecarFiles.sort() }
+}
+
+function sessionArchivesForConversation(requiredIds, sessionIndex) {
+  const closure = new Set(requiredIds)
+  const pending = [...closure]
+  while (pending.length) {
+    const id = pending.pop()
+    const session = sessionIndex.get(id)
+    if (!session) throw new Error(`Required native DSH session is missing: ${id}`)
+    const parent = session.header.parentSession
+    if (typeof parent === 'string' && parent && !closure.has(parent)) {
+      closure.add(parent)
+      pending.push(parent)
+    }
+  }
+  return [...closure].map(id => {
+    const session = sessionIndex.get(id)
+    if (!session) throw new Error(`Required native DSH session is missing: ${id}`)
+    return session
+  })
+}
+
+function stableWrite(path, contents) {
+  try {
+    const existing = readFileSync(path, 'utf8')
+    if (existing !== contents) throw new Error(`Existing conversion output differs; refusing overwrite: ${path}`)
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error
+    writeFileSync(path, contents, { encoding: 'utf8', flag: 'wx' })
+  }
+}
+
+export function convertStoppedV041Copy({ databasePath, sessionsRoot, pluginRoot, outputDirectory }) {
+  const database = new Database(databasePath, { readonly: true, fileMustExist: true })
+  try {
+    const version = Number(database.pragma('user_version', { simple: true }))
+    if (version !== 10) throw new Error(`Expected read-only v10 source database, got schema ${version}`)
+    const sourceConversations = database.prepare(`SELECT s.id,s.characterId,s.updatedAt,a.runtimeThreadId
+      FROM chat_sessions s JOIN agent_conversations a ON a.id=s.id ORDER BY s.createdAt,s.id`).all()
+    if (!sourceConversations.length) throw new Error('The stopped source database contains no official conversations')
+    const sessionIndex = readNativeSessionIndex(sessionsRoot)
+    const runtimeSessionToConversation = new Map()
+    for (const row of sourceConversations) {
+      if (typeof row.runtimeThreadId === 'string' && row.runtimeThreadId) {
+        const previous = runtimeSessionToConversation.get(row.runtimeThreadId)
+        if (previous && previous !== row.id) throw new Error(`Runtime session ID is associated with multiple conversations: ${row.runtimeThreadId}`)
+        runtimeSessionToConversation.set(row.runtimeThreadId, row.id)
+      }
+    }
+    const plugin = JSON.parse(readFileSync(join(resolve(pluginRoot), 'state.json'), 'utf8'))
+    const traceReferences = readPluginTraceReferences(pluginRoot, runtimeSessionToConversation)
+    const output = resolve(outputDirectory)
+    const archivesDirectory = join(output, 'archives')
+    mkdirSync(archivesDirectory, { recursive: true })
+    const manifest = {
+      format: 'eleckoi.v050-stopped-copy-conversion', version: 1, sourceSchema: 10,
+      targetArchive: 'eleckoi.desktop-chat-history@1 + eleckoi.desktop-conversation@2',
+      conversations: []
+    }
+    for (const row of sourceConversations) {
+      const snapshot = readOfficialConversationSnapshot(database, row.id)
+      const productIds = new Set()
+      if (typeof row.runtimeThreadId === 'string' && row.runtimeThreadId) productIds.add(row.runtimeThreadId)
+      for (const response of snapshot.tables.agent_responses) {
+        if (response.dshTurn !== null && typeof response.runtimeThreadId === 'string' && response.runtimeThreadId) {
+          productIds.add(response.runtimeThreadId)
+        }
+      }
+      const traces = traceReferences.byConversation.get(row.id)
+      for (const id of traces?.sessionIds ?? []) productIds.add(id)
+      const sessionLogs = sessionArchivesForConversation(productIds, sessionIndex)
+      const archive = {
+        format: 'eleckoi.desktop-chat-history', version: 1,
+        exportedAt: typeof row.updatedAt === 'string' && row.updatedAt ? row.updatedAt : '1970-01-01T00:00:00.000Z',
+        snapshot,
+        sessionReferences: { version: 1, sessionIds: [...(traces?.sessionIds ?? [])].sort() },
+        sessionLogs
+      }
+      const legacyData = readLegacyData(databasePath, row.id)
+      const converted = convertV041Archive(archive, legacyData, { pluginState: plugin })
+      const file = `conversation-${createHash('sha256').update(row.id).digest('hex').slice(0, 20)}.json`
+      stableWrite(join(archivesDirectory, file), `${JSON.stringify(converted, null, 2)}\n`)
+      manifest.conversations.push({
+        conversationId: row.id,
+        characterId: row.characterId,
+        file: `archives/${file}`,
+        sessionIds: sessionLogs.map(log => log.header.id),
+        traceCount: traces?.traceCount ?? 0,
+        historyRecords: converted.snapshot.stateHistory.operations.length,
+        inactiveLegacyEdits: converted.snapshot.stateHistory.operations.filter(operation => operation.kind === 'edit' && (operation.legacyAnchorMissing || operation.legacyStateUnavailable)).length
+      })
+    }
+    manifest.unmappedTraceFiles = traceReferences.unmappedTraceFiles
+    manifest.handoffSidecars = {
+      count: traceReferences.handoffSidecarFiles.length,
+      files: traceReferences.handoffSidecarFiles,
+      disposition: 'plugin-state archive sidecars; not run trace DTOs'
+    }
+    manifest.traceCount = manifest.conversations.reduce((count, item) => count + item.traceCount, 0)
+    const manifestText = `${JSON.stringify(manifest, null, 2)}\n`
+    stableWrite(join(output, 'manifest.json'), manifestText)
+    return manifest
+  } finally {
+    database.close()
+  }
+}
+
+function argumentsMap(argv) {
+  const result = {}
+  for (let index = 0; index < argv.length; index += 1) {
+    if (!argv[index].startsWith('--')) throw new Error(`Unexpected argument: ${argv[index]}`)
+    const key = argv[index].slice(2)
+    const value = argv[++index]
+    if (!value || value.startsWith('--')) throw new Error(`Missing value for --${key}`)
+    result[key] = value
+  }
+  return result
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
+  const args = argumentsMap(process.argv.slice(2))
+  if (args['source-db'] || args['sessions-root'] || args['plugin-root'] || args['output-dir']) {
+    if (!args['source-db'] || !args['sessions-root'] || !args['plugin-root'] || !args['output-dir']) {
+      throw new Error('Usage: node scripts/prepare-v050-legacy-archive.mjs --source-db <stopped-v10.sqlite3> --sessions-root <dsh-runtime/sessions> --plugin-root <dsh-runtime/home/plugins/rp-agent-team> --output-dir <fresh-conversion-directory>')
+    }
+    const manifest = convertStoppedV041Copy({
+      databasePath: args['source-db'], sessionsRoot: args['sessions-root'],
+      pluginRoot: args['plugin-root'], outputDirectory: args['output-dir']
+    })
+    console.log(`Converted ${manifest.conversations.length} conversations from the stopped schema-v10 copy with exact native Session closure.`)
+    process.exit(0)
+  }
+  if (!args.archive || !args.database || !args.output) {
+    throw new Error('Usage: node scripts/prepare-v050-legacy-archive.mjs --source-db <stopped-v10.sqlite3> --sessions-root <dsh-runtime/sessions> --plugin-root <dsh-runtime/home/plugins/rp-agent-team> --output-dir <fresh-conversion-directory>')
+  }
+  const archive = JSON.parse(readFileSync(args.archive, 'utf8'))
+  const conversationId = record(record(archive.snapshot).tables?.chat_sessions?.[0]).id
+  if (typeof conversationId !== 'string' || !conversationId) throw new Error('Archive has no source conversation ID')
+  const legacyData = readLegacyData(args.database, conversationId)
+  const pluginState = args['plugin-state'] ? JSON.parse(readFileSync(args['plugin-state'], 'utf8')) : undefined
+  const converted = convertV041Archive(archive, legacyData, { pluginState })
+  writeFileSync(args.output, `${JSON.stringify(converted, null, 2)}\n`, 'utf8')
+  console.log(`Prepared v0.5 archive: ${converted.snapshot.stateHistory.operations.length} durable history records (source DB opened read-only).`)
+}
