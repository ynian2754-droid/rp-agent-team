+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {resolve} from 'node:path'
+import {matchesImportTarget, validateStoppedCopyInput} from '../scripts/import-v050-stopped-copy.mjs'
+
+const keys=['databasePath','runtimeDataRoot','profileDirectory','workspaceRoot','productMediaRoot']
+const target=Object.fromEntries(keys.map(key=>[key,resolve('target',key)]))
+
+test('import mapping reuse requires all five normalized target paths to match',()=>{
+ assert.equal(matchesImportTarget(target,target),true)
+ for(const key of keys) {
+  assert.equal(matchesImportTarget({...target,[key]:resolve('other',key)},target),false,`${key} changes the target identity`)
+  const legacy={...target};delete legacy[key]
+  assert.equal(matchesImportTarget(legacy,target),false,`legacy target without ${key} is rejected`)
+ }
+ assert.equal(matchesImportTarget(undefined,target),false)
+ assert.equal(matchesImportTarget(null,target),false)
+})
+
+test('valid stopped-copy collections accept one conversation and two presets',()=>{
+ const products={format:'eleckoi.v041-portable-product-export',sourceSchema:10,
+  characters:[{sourceId:'character-a',file:'products/character-a.json'}],
+  presets:[{sourceId:'preset-a',file:'products/preset-a.json'},{sourceId:'preset-b',file:'products/preset-b.json'}]}
+ const manifest={format:'eleckoi.v050-stopped-copy-conversion',version:1,sourceSchema:10,
+  conversations:[{conversationId:'conversation-a',characterId:'character-a',file:'conversations/a.json'}]}
+ const attachments={format:'eleckoi.v041-portable-attachments',version:1,attachments:[]}
+ assert.equal(validateStoppedCopyInput(products,manifest,attachments),true)
+})
+
+test('stopped-copy input still enforces pinned schema and collection shapes',()=>{
+ const products={format:'eleckoi.v041-portable-product-export',sourceSchema:9,characters:[],presets:[]}
+ const manifest={format:'eleckoi.v050-stopped-copy-conversion',version:1,sourceSchema:10,conversations:[]}
+ const attachments={format:'eleckoi.v041-portable-attachments',version:1,attachments:[]}
+ assert.throws(()=>validateStoppedCopyInput(products,manifest,attachments),/fixed stopped v0.4.1 copy export/)
+ assert.throws(()=>validateStoppedCopyInput({...products,sourceSchema:10},{...manifest,conversations:{}},attachments),/invalid product or conversation collections/)
+})
