+import test from 'node:test'
+import assert from 'node:assert/strict'
+import {existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync} from 'node:fs'
+import {dirname, isAbsolute, join, relative, resolve} from 'node:path'
+import {tmpdir} from 'node:os'
+import {exportV041StoppedCopyProducts, resolveLegacyProductModule} from '../scripts/export-v041-stopped-copy-products.mjs'
+
+test('product export requires the legacy module before staging or copying the source database',async()=>{
+ const root=mkdtempSync(join(tmpdir(),'v050-product-export-required-module-'))
+ const output=join(root,'output')
+ try {
+  await assert.rejects(exportV041StoppedCopyProducts({databasePath:join(root,'missing.sqlite3'),
+   mediaRoot:join(root,'missing-media'),outputDirectory:output}),/Missing required legacy ProductData module/)
+  assert.equal(existsSync(output),false)
+ } finally {
+  rmSync(root,{recursive:true,force:true})
+ }
+})
+
+test('legacy ProductData module paths resolve to an absolute built-module path',()=>{
+ const root=mkdtempSync(join(tmpdir(),'v050-product-export-module-path-'))
+ const modulePath=join(root,'lib','index.js')
+ try {
+  mkdirSync(dirname(modulePath),{recursive:true})
+  writeFileSync(modulePath,'export default function legacyProductData() {}\n')
+  const resolved=resolveLegacyProductModule(relative(process.cwd(),modulePath))
+  assert.equal(resolved,resolve(modulePath))
+  assert.equal(isAbsolute(resolved),true)
+ } finally {
+  rmSync(root,{recursive:true,force:true})
+ }
+})
