+      ...(Number.isSafeInteger(continuation.data.inputEventSeq) ? { inputEventSeq: continuation.data.inputEventSeq } : {}) }
+  }
+  const startIndex = events.findIndex(event => event?.type === 'turn/start' && event.data?.turn === turn)
+  const endIndex = events.findIndex((event, index) => index > startIndex && event?.type === 'turn/end' && event.data?.turn === turn)
+  if (!input) {
