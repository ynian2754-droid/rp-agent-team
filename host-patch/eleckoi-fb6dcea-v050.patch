@@ -0,0 +1,29 @@
+import { readFileSync } from 'node:fs'
+import { runInNewContext } from 'node:vm'
+import { expect, it } from 'vitest'
+
+it('binds native React before loading public trajectory components, without mounting the shell', async () => {
+  let registration: any
+  const context: any = {
+    window: { __ModuleLoader__: { load: (value: any) => { registration = value } } },
+  }
+  runInNewContext(readFileSync(new URL('../packages/dsh-client-conversations/src/client.js', import.meta.url), 'utf8'), context)
+  const react = { lazy: (load: unknown) => ({ load }) }
+  const modules: Record<string, unknown> = {
+    react, 'react/jsx-runtime': { jsx() {}, jsxs() {} },
+    'react-dom': { createPortal() {} }, 'react-dom/client': { createRoot() {} },
+  }
+  const plugin = registration.factory((name: string) => {
+    if (!(name in modules)) throw new Error(`Unexpected module ${name}`)
+    return modules[name]
+  })
+  expect(context.__ELECKOI_DSH_PLATFORM__).toBeUndefined()
+  const page = plugin.loadTrajectoryComponents()
+  // This VM intentionally has no browser protocol loader; module initialization
+  // must happen synchronously before the browser's import starts.
+  await page.catch(() => undefined)
+  expect(context.__ELECKOI_DSH_PLATFORM__).toEqual({
+    react, jsxRuntime: modules['react/jsx-runtime'],
+    reactDom: modules['react-dom'], reactDomClient: modules['react-dom/client'],
+  })
+})
