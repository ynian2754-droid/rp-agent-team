@@ -0,0 +1,104 @@
+import { createHash } from 'node:crypto'
+import { mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs'
+import { basename, join, resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+function argsMap(argv) {
+  const result = {}
+  for (let index = 0; index < argv.length; index += 1) {
+    if (!argv[index].startsWith('--')) throw new Error(`Unexpected argument: ${argv[index]}`)
+    const key = argv[index].slice(2)
+    const value = argv[++index]
+    if (!value || value.startsWith('--')) throw new Error(`Missing value for --${key}`)
+    result[key] = value
+  }
+  return result
+}
+
+function writeBytesStable(path, bytes) {
+  try {
+    const prior = readFileSync(path)
+    if (!prior.equals(bytes)) throw new Error(`Existing attachment export differs; refusing overwrite: ${path}`)
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error
+    writeFileSync(path, bytes, { flag: 'wx' })
+  }
+}
+
+function readReference(value, type, counts) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`Invalid ${type} attachment reference`)
+  const id = value.attachmentId
+  const match = typeof id === 'string' && /^sha256:([a-f0-9]{64})$/u.exec(id)
+  if (!match) throw new Error(`Unsupported ${type} attachment identity`)
+  const sha256 = match[1]
+  const key = `${type}:${sha256}`
+  const current = counts.get(key) ?? { type, sha256, names: new Set(), mediaType: undefined, references: 0, expectedBytes: undefined }
+  current.references += 1
+  if (typeof value.name === 'string') current.names.add(value.name)
+  if (type === 'image') {
+    if (typeof value.mediaType !== 'string') throw new Error('Image attachment is missing mediaType')
+    if (current.mediaType && current.mediaType !== value.mediaType) throw new Error(`Conflicting image media types for ${id}`)
+    current.mediaType = value.mediaType
+  }
+  if (Number.isSafeInteger(value.bytes)) {
+    if (current.expectedBytes !== undefined && current.expectedBytes !== value.bytes) throw new Error(`Conflicting attachment byte counts for ${id}`)
+    current.expectedBytes = value.bytes
+  }
+  counts.set(key, current)
+}
+
+export function exportV041StoppedCopyAttachments({ conversionDirectory, attachmentRoot }) {
+  const conversion = resolve(conversionDirectory)
+  const source = resolve(attachmentRoot)
+  const archiveDirectory = join(conversion, 'archives')
+  const counts = new Map()
+  for (const file of readdirSync(archiveDirectory).filter(name => name.endsWith('.json')).sort()) {
+    const archive = JSON.parse(readFileSync(join(archiveDirectory, file), 'utf8'))
+    for (const log of archive.sessionLogs ?? []) for (const event of log.events ?? []) {
+      const data = event?.data ?? {}
+      const message = event.type === 'user/message' ? data : event.type === 'assistant/message' ? data.message : undefined
+      for (const block of message?.content ?? []) {
+        if (block?.type === 'image' || block?.type === 'file') readReference(block.attachment, block.type, counts)
+      }
+    }
+  }
+
+  const directory = join(conversion, 'products', 'attachments')
+  mkdirSync(directory, { recursive: true })
+  const manifest = { format: 'eleckoi.v041-portable-attachments', version: 1, source: 'stopped-copy DSH attachment store', attachments: [] }
+  for (const item of [...counts.values()].sort((left, right) => left.type.localeCompare(right.type) || left.sha256.localeCompare(right.sha256))) {
+    const objectDirectory = item.type === 'image' ? 'objects' : 'file-objects'
+    const sourcePath = join(source, objectDirectory, item.sha256.slice(0, 2), item.sha256)
+    const bytes = readFileSync(sourcePath)
+    const digest = createHash('sha256').update(bytes).digest('hex')
+    if (digest !== item.sha256) throw new Error(`Stopped-copy attachment digest mismatch: ${basename(sourcePath)}`)
+    if (item.expectedBytes !== undefined && item.expectedBytes !== bytes.length) throw new Error(`Stopped-copy attachment size mismatch: ${basename(sourcePath)}`)
+    const file = `${item.type}-${item.sha256}.bin`
+    writeBytesStable(join(directory, file), bytes)
+    manifest.attachments.push({
+      sourceId: `sha256:${item.sha256}`, type: item.type, file: `products/attachments/${file}`,
+      names: [...item.names].sort(), ...(item.mediaType ? { mediaType: item.mediaType } : {}),
+      bytes: bytes.length, sha256: digest, referenceCount: item.references
+    })
+  }
+  const manifestPath = join(conversion, 'attachments.json')
+  const manifestText = `${JSON.stringify(manifest, null, 2)}\n`
+  try {
+    const prior = JSON.parse(readFileSync(manifestPath, 'utf8'))
+    if (prior.format !== manifest.format || prior.version !== manifest.version) throw new Error('Existing attachment manifest belongs to another exporter')
+    if (JSON.stringify(prior) !== JSON.stringify(manifest)) throw new Error(`Existing attachment manifest differs: ${manifestPath}`)
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error
+    writeFileSync(manifestPath, manifestText, { encoding: 'utf8', flag: 'wx' })
+  }
+  return manifest
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  const args = argsMap(process.argv.slice(2))
+  if (!args['conversion-dir'] || !args['attachment-root']) {
+    throw new Error('Usage: node scripts/export-v041-stopped-copy-attachments.mjs --conversion-dir <prepared-conversion-directory> --attachment-root <stopped-copy/dsh-runtime/home/attachments/v1>')
+  }
+  const manifest = exportV041StoppedCopyAttachments({ conversionDirectory: args['conversion-dir'], attachmentRoot: args['attachment-root'] })
+  console.log(`Exported ${manifest.attachments.length} referenced attachment objects (${manifest.attachments.reduce((total, item) => total + item.referenceCount, 0)} references).`)
+}
diff --git a/scripts/export-v041-stopped-copy-products.mjs b/scripts/export-v041-stopped-copy-products.mjs
new file mode 100644
index 0000000..afdd379
--- /dev/null
+++ b/scripts/export-v041-stopped-copy-products.mjs
@@ -0,0 +1,188 @@
+import { createHash } from 'node:crypto'
+import { copyFileSync, cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { basename, join, resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { Context } from '@deepseek-ai/cordis'
+
+function argsMap(argv) {
+  const result = {}
+  for (let index = 0; index < argv.length; index += 1) {
+    if (!argv[index].startsWith('--')) throw new Error(`Unexpected argument: ${argv[index]}`)
+    const key = argv[index].slice(2)
+    const value = argv[++index]
+    if (!value || value.startsWith('--')) throw new Error(`Missing value for --${key}`)
+    result[key] = value
+  }
+  return result
+}
+
+export function resolveLegacyProductModule(modulePath) {
+  if (typeof modulePath !== 'string' || !modulePath.trim()) {
+    throw new Error('Missing required legacy ProductData module path (--legacy-product-module)')
+  }
+  const resolved = resolve(modulePath)
+  if (!existsSync(resolved) || !statSync(resolved).isFile()) {
+    throw new Error(`Legacy ProductData module must be a built file: ${resolved}`)
+  }
+  return resolved
+}
+
+function stableWrite(path, contents) {
+  try {
+    if (readFileSync(path, 'utf8') !== contents) throw new Error(`Existing product export differs; refusing overwrite: ${path}`)
+  } catch (error) {
+    if (error?.code !== 'ENOENT') throw error
+    writeFileSync(path, contents, { encoding: 'utf8', flag: 'wx' })
+  }
+}
+
+function fileName(kind, sourceId) {
+  const digest = createHash('sha256').update(sourceId).digest('hex').slice(0, 20)
+  return `${kind}-${digest}.json`
+}
+
+function references(document) {
+  const preset = document?.preset ?? document
+  const result = []
+  const modelTags = [...(Array.isArray(preset.model_tags) ? preset.model_tags : []),
+    ...(Array.isArray(preset.modelTags) ? preset.modelTags : [])]
+  for (const tag of modelTags) {
+    if (typeof (tag.provider_id ?? tag.providerId) === 'string' && typeof tag.id === 'string') {
+      const providerId = tag.provider_id ?? tag.providerId
+      result.push({ ...(providerId ? { providerId } : {}), model: tag.id,
+        source: 'agent-preset.modelTags', outcome: providerId ? 'reference' : 'provider-unresolved' })
+    }
+  }
+  const subagent = preset.subagent_model_selection ?? preset.subagentModelSelection
+  if (subagent && typeof (subagent.config_id ?? subagent.configId) === 'string' && typeof subagent.model === 'string') {
+    result.push({ configId: subagent.config_id ?? subagent.configId, model: subagent.model, source: 'agent-preset.subagentModelSelection' })
+  }
+  for (const [toolGroup, configId] of Object.entries(preset.tool_model_config_ids ?? preset.toolModelConfigIds ?? {})) {
+    if (typeof configId === 'string') result.push({ configId, source: `agent-preset.toolModelConfigIds.${toolGroup}` })
+  }
+  for (const version of Array.isArray(preset.versions) ? preset.versions : []) {
+    for (const reference of references(version)) result.push({ ...reference, source: `agent-preset.versions.${reference.source}` })
+  }
+  return result
+}
+
+export async function exportV041StoppedCopyProducts({ databasePath, mediaRoot, outputDirectory, legacyProductModule }) {
+  const oldProductModulePath = resolveLegacyProductModule(legacyProductModule)
+  const sourceDb = resolve(databasePath)
+  const sourceMedia = resolve(mediaRoot)
+  const output = resolve(outputDirectory)
+
+  const temp = mkdtempSync(join(tmpdir(), 'v050-official-product-export-'))
+  const tempDatabase = join(temp, 'product.sqlite3')
+  const tempMedia = join(temp, 'media')
+  const previous = Object.fromEntries(['ELECKOI_DATABASE_PATH', 'ELECKOI_MEDIA_ROOT', 'ELECKOI_WORKSPACE_ROOT']
+    .map(key => [key, process.env[key]]))
+  const ctx = new Context()
+  try {
+    copyFileSync(sourceDb, tempDatabase)
+    for (const suffix of ['-wal', '-shm']) {
+      try { copyFileSync(`${sourceDb}${suffix}`, `${tempDatabase}${suffix}`) }
+      catch (error) { if (error?.code !== 'ENOENT') throw error }
+    }
+    cpSync(sourceMedia, tempMedia, { recursive: true, force: false, errorOnExist: false })
+    const workspace = join(temp, 'workspace')
+    mkdirSync(workspace, { recursive: true })
+    process.env.ELECKOI_DATABASE_PATH = tempDatabase
+    process.env.ELECKOI_MEDIA_ROOT = tempMedia
+    process.env.ELECKOI_WORKSPACE_ROOT = workspace
+
+    const oldDataModule = await import(pathToFileURL(oldProductModulePath))
+    await ctx.plugin(oldDataModule.default)
+    const data = ctx.eleckoiProductData
+    const characters = data.readCharacters()
+    const presets = data.readAgentPresetCatalog()
+    const productsDirectory = join(output, 'products')
+    const characterDirectory = join(productsDirectory, 'characters')
+    const presetDirectory = join(productsDirectory, 'presets')
+    mkdirSync(characterDirectory, { recursive: true })
+    mkdirSync(presetDirectory, { recursive: true })
+
+    const manifest = {
+      format: 'eleckoi.v041-portable-product-export', version: 1, sourceSchema: 10,
+      exporter: 'ElecKoi v0.4.1 official ProductDataStore export APIs',
+      activeCharacterId: characters.active_character_id,
+      activePresetId: presets.activePresetId,
+      characters: [], presets: [], modelReferences: []
+    }
+    for (const character of characters.items) {
+      const exported = data.exportCharacter(character.id, 'json')
+      if (exported.mimeType !== 'application/json') throw new Error(`Character ${character.id} export was not JSON`)
+      const bytes = Buffer.from(exported.base64, 'base64')
+      if (!bytes.length) throw new Error(`Character ${character.id} exported an empty document`)
+      const file = `products/characters/${fileName('character', character.id)}`
+      stableWrite(join(output, file), bytes.toString('utf8'))
+      manifest.characters.push({ sourceId: character.id, file, fileName: basename(exported.fileName), bytes: bytes.length,
+        sha256: createHash('sha256').update(bytes).digest('hex') })
+    }
+    for (const preset of presets.presets) {
+      const exported = data.exportAgentPreset(preset.id, 'json')
+      if (exported.mimeType !== 'application/json') throw new Error(`Preset ${preset.id} export was not JSON`)
+      const bytes = Buffer.from(exported.base64, 'base64')
+      if (!bytes.length) throw new Error(`Preset ${preset.id} exported an empty document`)
+      const file = `products/presets/${fileName('preset', preset.id)}`
+      stableWrite(join(output, file), bytes.toString('utf8'))
+      const portablePreset = JSON.parse(bytes.toString('utf8'))
+      manifest.presets.push({ sourceId: preset.id, file, fileName: basename(exported.fileName), bytes: bytes.length,
+        sha256: createHash('sha256').update(bytes).digest('hex') })
+      manifest.modelReferences.push(...references(portablePreset).map(value => ({ presetId: preset.id, ...value })))
+    }
+    manifest.modelReferences = [...new Map(manifest.modelReferences.map(value => [JSON.stringify(value), value])).values()]
+    const manifestPath = join(output, 'products.json')
+    const manifestText = `${JSON.stringify(manifest, null, 2)}\n`
+    try {
+      const existing = JSON.parse(readFileSync(manifestPath, 'utf8'))
+      if (existing.format !== manifest.format || existing.sourceSchema !== manifest.sourceSchema) {
+        throw new Error(`Existing product manifest is not this converter's output: ${manifestPath}`)
+      }
+      writeFileSync(manifestPath, manifestText, 'utf8')
+    } catch (error) {
+      if (error?.code !== 'ENOENT') throw error
+      writeFileSync(manifestPath, manifestText, { encoding: 'utf8', flag: 'wx' })
+    }
+    return manifest
+  } finally {
+    await ctx.fiber.dispose()
+    for (const [key, value] of Object.entries(previous)) {
+      if (value === undefined) delete process.env[key]
+      else process.env[key] = value
+    }
+    rmSync(temp, { recursive: true, force: true })
+  }
+}
+
+export function refreshV041StoppedCopyProductReferences({ outputDirectory }) {
+  const output = resolve(outputDirectory)
+  const manifestPath = join(output, 'products.json')
+  const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'))
+  if (manifest.format !== 'eleckoi.v041-portable-product-export' || manifest.sourceSchema !== 10) {
+    throw new Error('Expected the official v0.4.1 portable product export manifest')
+  }
+  manifest.modelReferences = []
+  for (const preset of manifest.presets ?? []) {
+    const document = JSON.parse(readFileSync(join(output, preset.file), 'utf8'))
+    manifest.modelReferences.push(...references(document).map(value => ({ presetId: preset.sourceId, ...value })))
+  }
+  manifest.modelReferences = [...new Map(manifest.modelReferences.map(value => [JSON.stringify(value), value])).values()]
+  writeFileSync(manifestPath, `${JSON.stringify(manifest, null, 2)}\n`, 'utf8')
+  return manifest
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  const args = argsMap(process.argv.slice(2))
+  if (args['refresh-references'] === 'true' && args['output-dir']) {
+    const manifest = refreshV041StoppedCopyProductReferences({ outputDirectory: args['output-dir'] })
+    console.log(`Recorded ${manifest.modelReferences.length} model references from the official portable preset export.`)
+    process.exit(0)
+  }
+  if (!args['source-db'] || !args['media-root'] || !args['output-dir'] || !args['legacy-product-module']) {
+    throw new Error('Usage: node scripts/export-v041-stopped-copy-products.mjs --source-db <stopped-v10.sqlite3> --media-root <stopped-copy/media> --output-dir <conversion-directory> --legacy-product-module <absolute-path-to-built-v0.4.1-ProductData-module>')
+  }
+  const manifest = await exportV041StoppedCopyProducts({ databasePath: args['source-db'], mediaRoot: args['media-root'], outputDirectory: args['output-dir'], legacyProductModule: args['legacy-product-module'] })
+  console.log(`Officially exported ${manifest.characters.length} characters and ${manifest.presets.length} agent presets; model refs: ${manifest.modelReferences.length}.`)
+}
diff --git a/scripts/import-v050-stopped-copy.mjs b/scripts/import-v050-stopped-copy.mjs
new file mode 100644
index 0000000..c1bfac8
--- /dev/null
+++ b/scripts/import-v050-stopped-copy.mjs
@@ -0,0 +1,343 @@
+import { createHash } from 'node:crypto'
+import { createReadStream, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
+import { basename, join, resolve } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { resolveDshDesktopResources, runDshDesktopHeadlessProfile } from '@eleckoi/desktop-host'
+
+const CONVERSION_FORMAT = 'eleckoi.v050-stopped-copy-conversion'
+const ATTACHMENT_FORMAT = 'eleckoi.v041-portable-attachments'
+const IMPORT_TARGET_PATHS = ['databasePath', 'runtimeDataRoot', 'profileDirectory', 'workspaceRoot', 'productMediaRoot']
+
+export function matchesImportTarget(existing, expected) {
+  return !!existing && typeof existing === 'object' && IMPORT_TARGET_PATHS.every(key =>
+    typeof existing[key] === 'string' && resolve(existing[key]) === expected[key])
+}
+
+export function validateStoppedCopyInput(products, manifest, attachments) {
+  if (products?.format !== 'eleckoi.v041-portable-product-export' || products.sourceSchema !== 10
+    || manifest?.format !== CONVERSION_FORMAT || manifest.version !== 1 || manifest.sourceSchema !== 10) {
+    throw new Error('Conversion input is not a fixed stopped v0.4.1 copy export')
+  }
+  if (!Array.isArray(manifest.conversations) || !Array.isArray(products.characters) || !Array.isArray(products.presets)) {
+    throw new Error('Conversion input has invalid product or conversation collections')
+  }
+  if (attachments?.format !== ATTACHMENT_FORMAT || attachments.version !== 1 || !Array.isArray(attachments.attachments)) {
+    throw new Error('Unsupported portable attachment manifest')
+  }
+  return true
+}
+
+function argsMap(argv) {
+  const result = {}
+  for (let index = 0; index < argv.length; index += 1) {
+    if (!argv[index].startsWith('--')) throw new Error(`Unexpected argument: ${argv[index]}`)
+    const key = argv[index].slice(2)
+    const value = argv[++index]
+    if (!value || value.startsWith('--')) throw new Error(`Missing value for --${key}`)
+    result[key] = value
+  }
+  return result
+}
+
+function readJson(path) { return JSON.parse(readFileSync(path, 'utf8')) }
+
+function writeJsonAtomically(path, value) {
+  const temporary = `${path}.tmp-${process.pid}`
+  writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { encoding: 'utf8', flag: 'wx' })
+  renameSync(temporary, path)
+}
+
+export function conversionContentSignature(conversion, products, manifest, attachments) {
+  const hash = createHash('sha256')
+  const add = (label, value) => {
+    const bytes = Buffer.isBuffer(value) ? value : Buffer.from(value)
+    hash.update(`${Buffer.byteLength(label)}:${label}:${bytes.length}:`)
+    hash.update(bytes)
+  }
+  add('products.json', readFileSync(join(conversion, 'products.json')))
+  add('attachments.json', readFileSync(join(conversion, 'attachments.json')))
+  const productFiles = [
+    ...products.characters.map(item => ({ kind: 'character', item })),
+    ...products.presets.map(item => ({ kind: 'preset', item }))
+  ].sort((a, b) => `${a.kind}:${a.item.sourceId}`.localeCompare(`${b.kind}:${b.item.sourceId}`))
+  for (const { kind, item } of productFiles) {
+    add(`product:${kind}:${item.sourceId}`, readFileSync(join(conversion, item.file)))
+  }
+  for (const item of [...attachments.attachments].sort((a, b) => `${a.type}:${a.sha256}`.localeCompare(`${b.type}:${b.sha256}`))) {
+    add(`attachment:${item.type}:${item.sha256}`, readFileSync(join(conversion, item.file)))
+  }
+  for (const item of [...manifest.conversations].sort((a, b) => a.conversationId.localeCompare(b.conversationId))) {
+    add(`conversation:${item.conversationId}:${item.characterId}`, readFileSync(join(conversion, item.file)))
+  }
+  return hash.digest('hex')
+}
+
+function sourceKey(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Malformed attachment reference in archive')
+  if (typeof value.attachmentId !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(value.attachmentId)) throw new Error('Unsupported attachment reference in archive')
+  return value.attachmentId
+}
+
+function portableDocument(directory, item) {
+  const path = join(directory, item.file)
+  const bytes = readFileSync(path)
+  if (bytes.length !== item.bytes || createHash('sha256').update(bytes).digest('hex') !== item.sha256) {
+    throw new Error(`Portable dependency changed after export: ${item.file}`)
+  }
+  return { path, bytes }
+}
+
+async function importCharacter(ctx, item, directory) {
+  const { path, bytes } = portableDocument(directory, item)
+  const preview = ctx.eleckoiCharactersApi.prepareImport([{
+    displayName: basename(path), mimeType: 'application/json', base64: bytes.toString('base64')
+  }], 'eleckoi')
+  if (preview.items.length !== 1 || !preview.items[0]?.importable) throw new Error(`Character import preview refused ${item.sourceId}`)
+  const result = ctx.eleckoiCharactersApi.commitImport(preview.token)
+  if (result.failedMessages.length || result.importedCharacterIds.length !== 1) throw new Error(`Character import did not produce one target ID: ${item.sourceId}`)
+  return result.importedCharacterIds[0]
+}
+
+function importPreset(ctx, item, directory) {
+  const { path, bytes } = portableDocument(directory, item)
+  const result = ctx.eleckoiAgentPresetsApi.import('eleckoi', {
+    displayName: basename(path), mimeType: 'application/json', base64: bytes.toString('base64')
+  })
+  if (!result?.preset?.id) throw new Error(`Agent preset import did not return an ID: ${item.sourceId}`)
+  return result.preset.id
+}
+
+function portableReferenceKey(type, reference) {
+  return `${type}\u0000${sourceKey(reference)}\u0000${reference.name ?? ''}`
+}
+
+async function importAttachments(ctx, manifest, directory) {
+  const saved = new Map()
+  for (const item of manifest.attachments) {
+    const { path, bytes } = portableDocument(directory, item)
+    const ref = item.type === 'image'
+      ? await ctx.attachments.saveImage({ data: bytes, mediaType: item.mediaType, name: item.names[0] })
+      : item.type === 'file'
+        ? await ctx.attachments.saveFileStream({ data: createReadStream(path), name: item.names[0] })
+        : undefined
+    if (!ref) throw new Error(`Unsupported portable attachment type: ${item.type}`)
+    for (const name of item.names) saved.set(`${item.type}\u0000${item.sourceId}\u0000${name}`, { ...ref, name })
+    if (item.names.length === 0) saved.set(`${item.type}\u0000${item.sourceId}\u0000`, ref)
+  }
+  return saved
+}
+
+function rewriteArchive(archive, characterId, savedAttachments) {
+  const rewritten = structuredClone(archive)
+  const sourceCharacterId = rewritten.snapshot.characterId
+  rewritten.snapshot.characterId = characterId
+  // v0.4.1 portable archives may carry the v7-only user counter even though
+  // the stopped-copy source database has already applied Host migration 0008.
+  // The v0.5 schema intentionally removed it; the retained total count remains.
+  for (const row of rewritten.snapshot.tables.chat_sessions) delete row.historyUserMessageCount
+  for (const row of rewritten.snapshot.tables.chat_sessions) {
+    if (row.characterId === sourceCharacterId) row.characterId = characterId
+  }
+  for (const operation of rewritten.snapshot.stateHistory?.operations ?? []) {
+    for (const state of [operation.before, operation.after]) {
+      const library = state?.settingLibrary
+      if (library && typeof library === 'object' && library.characterId === sourceCharacterId) library.characterId = characterId
+    }
+  }
+  for (const log of rewritten.sessionLogs) {
+    for (const event of log.events ?? []) {
+      const data = event?.data ?? {}
+      const message = event.type === 'user/message' ? data : event.type === 'assistant/message' ? data.message : undefined
+      for (const block of message?.content ?? []) {
+        if (block?.type !== 'image' && block?.type !== 'file') continue
+        const old = block.attachment
+        const next = savedAttachments.get(portableReferenceKey(block.type, old))
+        if (!next) throw new Error(`Archive attachment was not exported: ${block.type} ${String(old?.attachmentId)}`)
+        block.attachment = next
+      }
+    }
+  }
+  return rewritten
+}
+
+function assertMappingIsComplete(archive, receipt) {
+  const logIds = new Set(archive.sessionLogs.map(log => log.header.id))
+  for (const id of logIds) if (!receipt.sessions[id]) throw new Error(`Official import omitted Session mapping ${id}`)
+  const messageIds = new Set()
+  for (const log of archive.sessionLogs) for (const event of log.events ?? []) {
+    if (event.type === 'user/message' && typeof event.data?.id === 'string') messageIds.add(event.data.id)
+    if (event.type === 'assistant/message' && typeof event.data?.message?.id === 'string') messageIds.add(event.data.message.id)
+  }
+  for (const id of messageIds) if (receipt.messages[id] !== id) throw new Error(`Official import changed or omitted retained message ID ${id}`)
+  const operationIds = new Set((archive.snapshot.stateHistory?.operations ?? []).map(operation => operation.operationId))
+  for (const id of operationIds) {
+    if (typeof receipt.operations?.[id] !== 'string' || !receipt.operations[id]) {
+      throw new Error(`Official import omitted state operation mapping ${id}`)
+    }
+  }
+  return { sessionCount: logIds.size, messageCount: messageIds.size,
+    operationCount: operationIds.size,
+    eventCount: archive.sessionLogs.reduce((count, log) => count + (log.events?.length ?? 0), 0) }
+}
+
+function historySummary(archive) {
+  const operations = archive.snapshot.stateHistory?.operations ?? []
+  return operations.map(({ operationId, runId, kind, outcome, anchor }) => ({ operationId, ...(runId ? { runId } : {}), kind, outcome, anchor }))
+}
+
+export async function importV050StoppedCopy({ conversionDirectory, runtimeDataRoot, profileDirectory, workspaceRoot, databasePath, mediaRoot, presetTemplatePath, agentPatchPath }) {
+  const conversion = resolve(conversionDirectory)
+  const products = readJson(join(conversion, 'products.json'))
+  const manifest = readJson(join(conversion, 'manifest.json'))
+  const attachments = readJson(join(conversion, 'attachments.json'))
+  validateStoppedCopyInput(products, manifest, attachments)
+
+  const options = { runtimeDataRoot: resolve(runtimeDataRoot), profileDirectory: resolve(profileDirectory),
+    workspaceRoot: resolve(workspaceRoot), productDatabasePath: resolve(databasePath), productMediaRoot: resolve(mediaRoot),
+    resources: resolveDshDesktopResources({
+      ...process.env,
+      ELECKOI_PRESET_TEMPLATE_PATH: resolve(presetTemplatePath),
+      ELECKOI_AGENT_PATCH_PATH: resolve(agentPatchPath)
+    }) }
+  const target = {
+    databasePath: options.productDatabasePath,
+    runtimeDataRoot: options.runtimeDataRoot,
+    profileDirectory: options.profileDirectory,
+    workspaceRoot: options.workspaceRoot,
+    productMediaRoot: options.productMediaRoot
+  }
+  const mapPath = join(conversion, 'official-import-mapping.json')
+  const signature = conversionContentSignature(conversion, products, manifest, attachments)
+  let mapping
+  if (existsSync(mapPath)) {
+    mapping = readJson(mapPath)
+    if (mapping.sourceSignature !== signature || !matchesImportTarget(mapping.target, target)) {
+      throw new Error('Existing import mapping belongs to a different source or target profile')
+    }
+  }
+  mkdirSync(options.runtimeDataRoot, { recursive: true })
+  mkdirSync(options.workspaceRoot, { recursive: true })
+  mkdirSync(options.productMediaRoot, { recursive: true })
+  let ctx
+  let shutdown
+  try {
+    const application = await runDshDesktopHeadlessProfile(options)
+    ctx = application.ctx
+    shutdown = application.shutdown
+    if (!mapping) {
+      const catalog = ctx.eleckoiProductData.readConversationCatalog()
+      const characterCollection = ctx.eleckoiProductData.readCharacters()
+      if (catalog.length || characterCollection.items.length) throw new Error('New product dependencies require an empty target profile and database')
+      const characterMap = {}
+      for (const item of products.characters) characterMap[item.sourceId] = await importCharacter(ctx, item, conversion)
+      const presetMap = {}
+      for (const item of products.presets) presetMap[item.sourceId] = importPreset(ctx, item, conversion)
+      if (products.activeCharacterId && characterMap[products.activeCharacterId]) ctx.eleckoiCharactersApi.select(characterMap[products.activeCharacterId])
+      if (products.activePresetId && presetMap[products.activePresetId]) ctx.eleckoiAgentPresetsApi.setActive(presetMap[products.activePresetId])
+      mapping = {
