diff --git a/apps/desktop-host/src/dshDesktopHeadlessProfile.ts b/apps/desktop-host/src/dshDesktopHeadlessProfile.ts
new file mode 100644
index 0000000..841b132
--- /dev/null
+++ b/apps/desktop-host/src/dshDesktopHeadlessProfile.ts
@@ -0,0 +1,140 @@
+import { delimiter, join } from 'node:path'
+import { existsSync, mkdirSync, writeFileSync } from 'node:fs'
+import {
+  initProfile,
+  loadLayeredEnv,
+  loadProfileDirectory,
+  PROFILE_TEMPLATES,
+  reportSkippedBundles,
+  readProfileManifest,
+  writeProfileBundles
+} from '@deepseek-ai/dsh-app-boot'
+import { runProfile } from '@deepseek-ai/dsh/profile-boot'
+import { ELECKOI_DESKTOP_BUNDLES, ELECKOI_INSTALL_ANCHOR, registerDesktopBundles } from './desktopPluginBundles'
+import type { DshDesktopResourceDescriptors } from './desktopPluginHost'
+
+const TAVILY_BUNDLE = '@eleckoi/dsh-web-search-tavily'
+
+export interface DshDesktopHeadlessProfileOptions {
+  runtimeDataRoot: string
+  workspaceRoot: string
+  productDatabasePath: string
+  productMediaRoot: string
+  resources: DshDesktopResourceDescriptors
+  environment?: Readonly<Record<string, string>>
+  profileDirectory?: string
+  bundles?: string[]
+  patchFiles?: string[]
+}
+
+export function resolveDshDesktopResources(environment: NodeJS.ProcessEnv = process.env): DshDesktopResourceDescriptors {
+  const presetTemplatePath = environment.ELECKOI_PRESET_TEMPLATE_PATH
+  const agentPatchPath = environment.ELECKOI_AGENT_PATCH_PATH
+  if (!presetTemplatePath || !agentPatchPath) {
+    throw new Error('DSH Host did not provide its official desktop resource paths.')
+  }
+  return {
+    presetTemplatePath,
+    agentPatchPath,
+    hostModuleUrl: environment.ELECKOI_DESKTOP_HOST_MODULE_URL ?? import.meta.url,
+    ...(environment.ELECKOI_NODE_BIN_PATH ? { nodeBinPath: environment.ELECKOI_NODE_BIN_PATH } : {}),
+    ...(environment.ELECKOI_PACKAGE_MANAGER_ENTRY_PATH
+      ? { packageManagerEntryPath: environment.ELECKOI_PACKAGE_MANAGER_ENTRY_PATH }
+      : {})
+  }
+}
+
+/** Initialize the same registered desktop bundles for either spawned or in-process profiles. */
+export function initializeDshDesktopProfile(profileDirectory: string, additionalBundles: readonly string[] = []): void {
+  const bundles = [...new Set([...PROFILE_TEMPLATES.web.bundles, ...ELECKOI_DESKTOP_BUNDLES, TAVILY_BUNDLE, ...additionalBundles])]
+  initProfile(profileDirectory, bundles)
+  registerDesktopBundles(profileDirectory)
+  const marker = join(profileDirectory, '.eleckoi-tavily-bundle-v1')
+  const initializeTavily = !existsSync(marker)
+  const manifest = readProfileManifest('dsh', profileDirectory)
+  const registered = manifest.dsh?.profile?.bundles ?? []
+  const required = [...additionalBundles, ...(initializeTavily ? [TAVILY_BUNDLE] : [])]
+  const missing = [...new Set(required)].filter(bundle => !registered.includes(bundle))
+  if (missing.length > 0) writeProfileBundles(profileDirectory, manifest, [...registered, ...missing])
+  if (!initializeTavily) return
+  try {
+    writeFileSync(marker, 'initialized\n', { flag: 'wx' })
+  } catch (error) {
+    if (!(error instanceof Error) || !('code' in error) || error.code !== 'EEXIST') throw error
+  }
+}
+
+/** Boot an isolated desktop profile in the current process and return its official DSH context. */
+export async function runDshDesktopHeadlessProfile(options: DshDesktopHeadlessProfileOptions) {
+  const homeDirectory = join(options.runtimeDataRoot, 'home')
+  const profileDirectory = options.profileDirectory ?? join(homeDirectory, 'profiles', 'desktop')
+  const sessionRoot = join(options.runtimeDataRoot, 'sessions')
+  const overlayPath = join(profileDirectory, 'eleckoi-plugin-host.patch.yml')
+  mkdirSync(profileDirectory, { recursive: true })
+  mkdirSync(sessionRoot, { recursive: true })
+  writeFileSync(overlayPath, [
+    '- id: session-persistence-jsonl',
+    '  config:',
+    `    root: ${JSON.stringify(sessionRoot)}`,
+    '    compression: none',
+    '- id: desktop-product-telemetry',
+    '  disabled: true',
+    '- id: product-analytics',
+    '  disabled: true',
+    '- id: ui-layout',
+    '  disabled: true',
+    '- id: ui-sidebar',
+    '  disabled: true',
+    '- id: ui-settings-general',
+    '  disabled: true',
+    '- id: ui-settings-models',
+    '  disabled: true',
+    ''
+  ].join('\n'))
+  initializeDshDesktopProfile(profileDirectory, options.bundles)
+
+  const environment = {
+    ...process.env,
+    ...options.environment,
+    DSH_HOME: homeDirectory,
+    DSH_SESSION_ROOT: sessionRoot,
+    DSH_CWD: options.workspaceRoot,
+    ELECKOI_SESSION_SNAPSHOT_ROOT: join(options.runtimeDataRoot, 'session-snapshots'),
+    ELECKOI_PRESET_ROOT: join(options.runtimeDataRoot, 'generated-presets'),
+    ELECKOI_PRESET_TEMPLATE_PATH: options.resources.presetTemplatePath,
+    ELECKOI_AGENT_PATCH_PATH: options.resources.agentPatchPath,
+    ELECKOI_DESKTOP_HOST_MODULE_URL: options.resources.hostModuleUrl,
+    ...(options.resources.nodeBinPath ? { ELECKOI_NODE_BIN_PATH: options.resources.nodeBinPath } : {}),
+    ...(options.resources.packageManagerEntryPath
+      ? { ELECKOI_PACKAGE_MANAGER_ENTRY_PATH: options.resources.packageManagerEntryPath }
+      : {}),
+    ELECKOI_SESSION_BRIDGE_ROOT: join(options.runtimeDataRoot, 'session-bridges'),
+    ELECKOI_DATABASE_PATH: options.productDatabasePath,
+    ELECKOI_MEDIA_ROOT: options.productMediaRoot,
+    ELECKOI_WORKSPACE_ROOT: options.workspaceRoot,
+    DSH_TELEMETRY_DISABLED: '1',
+    ELECTRON_RUN_AS_NODE: '1'
+  }
+  Object.assign(process.env, environment)
+  const profile = loadProfileDirectory('dsh', profileDirectory, ELECKOI_INSTALL_ANCHOR)
+  reportSkippedBundles('dsh', profile)
+  const application = await runProfile({
+    environment: loadLayeredEnv('dsh', profileDirectory),
+    profile: 'desktop',
+    resolvedProfile: { profile, installAnchor: ELECKOI_INSTALL_ANCHOR },
+    patchFiles: [overlayPath, ...(options.patchFiles ?? []), options.resources.agentPatchPath],
+    args: ['--no-open', '--port', '0'],
+    ...(options.resources.packageManagerEntryPath ? {
+      packageManager: {
+        command: process.execPath,
+        args: ['--expose-internals', options.resources.packageManagerEntryPath],
+        env: {
+          ELECTRON_RUN_AS_NODE: '1',
+          DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+          PATH: `${options.resources.nodeBinPath ?? ''}${delimiter}${process.env.PATH ?? ''}`
+        }
+      }
+    } : {})
+  })
+  return application
+}
