+      data: 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==' }
+    const prompted = await promptOfficialTurn(ctx, scenario.sessionId, 'PRIORITY_INPUT_MUST_BE_LIMITED', [image, { ...image, name: 'not-selected.png' }])
+    const completed = await waitForCompletedTurn(ctx, scenario.sessionId, prompted.priorEnds, prompted.afterSeq)
+    await prompted.work
+    const status = (await team.getStatus({ conversationId: scenario.conversationId })).run
+    const trace = await team.getTrace({ conversationId: scenario.conversationId, runId: status.runId })
+    assert.equal(status.phase, 'complete', JSON.stringify({ status, events: trace.events.filter(event => event.type.includes('failed')) }))
+    const bodies = completed.inspection.events.filter(event => event.type === 'assistant/message' && event.data?.turn === completed.event.data.turn)
+    assert.equal(bodies.length, 1)
+    assert.equal(textOfMessage(bodies[0]), 'PRIORITY_PUBLICATION')
+    assert.equal(status.members['agent-4'].activations, 2, 'Actor must read its own private draft in a second native Session')
+    assert.equal(status.members['agent-2'].status, requested ? failed ? 'failed' : 'complete' : 'skipped')
+    const actorSessions = trace.executionSessions.filter(execution => execution.agentId === 'agent-4')
+    assert.equal(actorSessions.length, 2)
+    const second = await ctx.sessionController.inspect(actorSessions[1].sessionId)
+    const packet = contextPacketFromSession(second)
+    assert.deepEqual(packet.drafts[0].visibleTo, [], 'Self recipient must normalize to a private draft')
+    assert.equal(packet.drafts[0].text, 'PRIORITY_PRIVATE_DRAFT')
+    results.push({ conversationId: scenario.conversationId, runId: status.runId, concurrency, requested, failed, memberStates: Object.fromEntries(Object.entries(status.members).map(([id, member]) => [id, member.status])) })
+  }
+  return results
+}
