+  conversationId: string
+  sessionId: string
+  fromTurn: number
+  beforeEventSeq: number
+}
+
+export interface ConversationRestorePlan {
+  apply(): void | Promise<void>
+  rollback(): void | Promise<void>
+}
+
+export interface RuntimeExtension {
+  id: string
+  resolveSnapshot(input: {
+    sessionId: string
+    parentSessionId?: string
+    child: boolean
+    phase: string
+    snapshot: Record<string, unknown>
+  }): Record<string, unknown> | void | Promise<Record<string, unknown> | void>
+  setupAgent(input: {
+    agentCtx: unknown
+    agent: unknown
+    sessionId: string
+    child: boolean
+    snapshot: Record<string, unknown>
+    binding: {
+      conversationId: string
+      sessionId: string
+      kind: 'root' | 'child'
+      parentSessionId?: string
+    }
+    getTurnSnapshot(input: {
+      messages: unknown[]
+      turn: number
+      signal?: AbortSignal
+    }): Promise<Record<string, unknown>>
+  }): void | (() => void | Promise<void>) | Promise<void | (() => void | Promise<void>)>
+  /** Override the SDK child's real route before its durable descriptor is written. */
+  resolveChildOptions?(input: {
+    childId: string
+    parentSessionId: string
+    label?: string
+    request: Record<string, unknown>
+  }): Record<string, unknown> | void | Promise<Record<string, unknown> | void>
+  prepareConversationRestore?(input: ConversationRestoreInput): ConversationRestorePlan | undefined | Promise<ConversationRestorePlan | undefined>
+}
+
+export interface RuntimeExtensionRegistration {
+  (): Promise<void>
+  readonly ready: Promise<void>
+}
+
+export interface RuntimeExtensionRegistry {
+  /** Record a local-only request route against its official Session request/header event. */
+  recordLocalDelivery(input: {
+    sessionId: string
+    requestSeq: number
+    provider: string
+    model: string
+  }): { recorded: true }
+  register(extension: RuntimeExtension): RuntimeExtensionRegistration
+  resolveSnapshot(input: {
+    sessionId: string
+    parentSessionId?: string
+    child: boolean
+    phase: string
+    snapshot: Record<string, unknown>
+  }): Promise<Record<string, unknown>>
+  setupAgent(input: Parameters<RuntimeExtension['setupAgent']>[0]): Promise<void>
+  resolveChildOptions(input: Parameters<NonNullable<RuntimeExtension['resolveChildOptions']>>[0]): Promise<Record<string, unknown> | undefined>
+  prepareConversationRestore(input: ConversationRestoreInput): Promise<ConversationRestorePlan>
+  disposeAgent(sessionId: string): Promise<void>
+  dispose(): Promise<void>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    eleckoiRuntimeExtensions: RuntimeExtensionRegistry
+  }
+}
