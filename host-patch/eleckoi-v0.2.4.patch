+      const nestedText = 'Nested read-only context verified.'
+      yield { type: 'block-start', index: 0, blockType: 'text' }
+      yield { type: 'text-delta', index: 0, text: nestedText }
+      yield { type: 'block-end', index: 0, block: { type: 'text', text: nestedText } }
