diff --git a/tools/export-v024-legacy-userdata.py b/tools/export-v024-legacy-userdata.py
new file mode 100644
index 0000000..0a85f37
--- /dev/null
+++ b/tools/export-v024-legacy-userdata.py
@@ -0,0 +1,520 @@
+#!/usr/bin/env python3
+"""Export a read-only ElecKoi 0.2.1 userData backup for the v0.2.4 migrator."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import sqlite3
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+
+TABLES = (
+    "chat_sessions",
+    "chat_session_character_snapshots",
+    "chat_session_variable_states",
+    "agent_conversations",
+    "agent_branches",
+    "conversation_speakers",
+    "agent_turns",
+    "agent_responses",
+    "agent_branch_turns",
+    "agent_openings",
+    "agent_setting_snapshots",
+)
+
+
+def json_default(value: Any) -> Any:
+    if isinstance(value, (bytes, bytearray, memoryview)):
+        return {"$bytesBase64": __import__("base64").b64encode(bytes(value)).decode("ascii")}
+    raise TypeError(f"Unsupported SQLite value: {type(value).__name__}")
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, default=json_default) + "\n", encoding="utf-8")
+
+
+def digest_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def open_database(path: Path) -> sqlite3.Connection:
+    if not path.is_file():
+        raise ValueError(f"Missing legacy product database: {path}")
+    uri = path.resolve().as_uri() + "?mode=ro&immutable=1"
+    return sqlite3.connect(uri, uri=True)
+
+
+def table_names(db: sqlite3.Connection) -> set[str]:
+    return {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+
+
+def table_rows(db: sqlite3.Connection, table: str, conversation_id: str) -> list[dict[str, Any]]:
+    if table not in table_names(db):
+        return []
+    if table == "agent_branch_turns":
+        rows = db.execute(
+            "SELECT p.* FROM agent_branch_turns p JOIN agent_branches b ON b.id=p.branchId "
+            "WHERE b.conversationId=? ORDER BY p.branchId,p.sequence",
+            (conversation_id,),
+        )
+    else:
+        columns = {row[1] for row in db.execute(f'PRAGMA table_info("{table}")')}
+        key = "id" if table in ("chat_sessions", "agent_conversations") else (
+            "sessionId" if table in ("chat_session_character_snapshots", "chat_session_variable_states")
+            else "conversationId"
+        )
+        if key not in columns:
+            return []
+        rows = db.execute(f'SELECT * FROM "{table}" WHERE "{key}"=? ORDER BY rowid', (conversation_id,))
+    names = [item[0] for item in rows.description]
+    return [dict(zip(names, row)) for row in rows]
+
+
+def snapshot_for(db: sqlite3.Connection, conversation_id: str) -> dict[str, Any]:
+    session_rows = table_rows(db, "chat_sessions", conversation_id)
+    if len(session_rows) != 1:
+        raise ValueError(f"Conversation {conversation_id} must have exactly one chat_sessions row")
+    character_id = session_rows[0].get("characterId")
+    if not isinstance(character_id, str) or not character_id:
+        raise ValueError(f"Conversation {conversation_id} has no character binding")
+    return {
+        "format": "eleckoi.desktop-conversation",
+        "version": 1,
+        "characterId": character_id,
+        "conversationId": conversation_id,
+        "tables": {table: table_rows(db, table, conversation_id) for table in TABLES},
+    }
+
+
+def read_session(path: Path, expected_id: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    with path.open("r", encoding="utf-8") as stream:
+        header_line = stream.readline()
+        if not header_line:
+            raise ValueError(f"Empty DSH Session log for {expected_id}")
+        physical = json.loads(header_line)
+        if physical.get("type") != "session" or physical.get("id") != expected_id:
+            raise ValueError(f"DSH Session header mismatch for {expected_id}")
+        header = {
+            "version": physical["version"],
+            "id": physical["id"],
+            "createdAt": physical["createdAt"],
+            "isSeeded": bool(physical.get("isSeeded", False)),
+            "delegationDepth": int(physical.get("delegationDepth", 0)),
+            **({"cwd": physical["cwd"]} if isinstance(physical.get("cwd"), str) else {}),
+            **({"parentSession": physical["parentSession"]} if isinstance(physical.get("parentSession"), str) else {}),
+            **({"origin": physical["origin"]} if physical.get("origin") == "subagent" else {}),
+            **({"agentPreset": physical["agentPreset"]} if isinstance(physical.get("agentPreset"), str) else {}),
+        }
+        events = [json.loads(line) for line in stream if line.strip()]
+    if header["isSeeded"]:
+        raise ValueError(f"Seeded legacy Session {expected_id} needs an explicit inherited-event boundary")
+    if any(not isinstance(event.get("seq"), int) for event in events):
+        raise ValueError(f"Malformed DSH event sequence in {expected_id}")
+    return header, events
+
+
+def index_session_logs(root: Path) -> dict[str, Path]:
+    sessions_root = root / "dsh-runtime" / "sessions"
+    found: dict[str, Path] = {}
+    if not sessions_root.is_dir():
+        return found
+    for path in sessions_root.rglob("session.v4.jsonl"):
+        with path.open("r", encoding="utf-8") as stream:
+            first = stream.readline()
+        if not first:
+            continue
+        header = json.loads(first)
+        session_id = header.get("id")
+        if isinstance(session_id, str):
+            if session_id in found:
+                raise ValueError(f"Duplicate DSH Session log for {session_id}")
+            found[session_id] = path
+    return found
+
+
+def direct_user_message(event: dict[str, Any]) -> dict[str, Any] | None:
+    if event.get("type") != "user/message":
+        return None
+    data = event.get("data") or {}
+    message = data.get("message") if isinstance(data, dict) else None
+    message = message if isinstance(message, dict) else data
+    if message.get("role") != "user" or (message.get("source") or {}).get("kind") != "user":
+        return None
+    return message
+
+
+def message_blocks(message: dict[str, Any]) -> list[dict[str, Any]]:
+    content = message.get("content")
+    if isinstance(content, list):
+        return [item for item in content if isinstance(item, dict)]
+    if isinstance(content, str):
+        return [{"type": "text", "text": content}]
+    return []
+
+
+def message_text(message: dict[str, Any]) -> str:
+    return "".join(str(block.get("text", "")) for block in message_blocks(message) if block.get("type") == "text")
+
+
+def turn_events(events: list[dict[str, Any]]) -> dict[int, list[dict[str, Any]]]:
+    turns: dict[int, list[dict[str, Any]]] = {}
+    current: int | None = None
+    for event in events:
+        kind = event.get("type")
+        data = event.get("data") or {}
+        if kind == "turn/start" and isinstance(data.get("turn"), int):
+            current = data["turn"]
+            turns.setdefault(current, [])
+        if current is not None:
+            turns.setdefault(current, []).append(event)
+        if kind == "turn/end":
+            current = None
+    return turns
+
+
+def historical_messages(snapshot: dict[str, Any], logs: dict[str, tuple[dict[str, Any], list[dict[str, Any]]]]) -> list[dict[str, Any]]:
+    tables = snapshot["tables"]
+    active_branch_id = tables["agent_conversations"][0]["activeBranchId"]
+    branch_path = sorted(
+        (row for row in tables["agent_branch_turns"] if row["branchId"] == active_branch_id),
+        key=lambda row: row["sequence"],
+    )
+    turns_by_id = {row["id"]: row for row in tables["agent_turns"]}
+    responses_by_turn: dict[str, list[dict[str, Any]]] = {}
+    for response in tables["agent_responses"]:
+        responses_by_turn.setdefault(response["turnId"], []).append(response)
+    for responses in responses_by_turn.values():
+        responses.sort(key=lambda row: (row.get("responseIndex", 0), row.get("createdAt", "")))
+
+    output: list[dict[str, Any]] = []
+    for branch_item in branch_path:
+        turn = turns_by_id[branch_item["turnId"]]
+        responses = responses_by_turn.get(turn["id"], [])
+        kind = turn.get("kind")
+        if kind == "opening":
+            opening = next((row for row in tables["agent_openings"] if row.get("turnId") == turn["id"]), None)
+            if opening:
+                output.append({"kind": "opening", "visibleId": "opening", "createdAt": turn.get("createdAt"),
+                               "content": opening.get("content", ""), "sourceTurnId": turn["id"]})
+            continue
+        if kind != "user":
+            continue
+        binding = next((row for row in responses if isinstance(row.get("runtimeThreadId"), str)
+                        and row.get("runtimeThreadId") in logs and isinstance(row.get("dshTurn"), int)), None)
+        if not binding:
+            raise ValueError(f"No DSH binding for active user turn {turn['id']}")
+        runtime_id = binding["runtimeThreadId"]
+        dsh_turn = binding["dshTurn"]
+        events = turn_events(logs[runtime_id][1]).get(dsh_turn)
+        if not events:
+            raise ValueError(f"Missing official DSH turn {runtime_id}/{dsh_turn}")
+        users = [(event, direct_user_message(event)) for event in events]
+        users = [(event, message) for event, message in users if message is not None]
+        if not users:
+            raise ValueError(f"Missing direct user message for active turn {turn['id']}")
+        user_messages = [{
+            "messageId": message.get("id"),
+            "eventSeq": event.get("seq"),
+            "createdAt": datetime.fromtimestamp(event.get("time", 0) / 1000, timezone.utc).isoformat(),
+            "source": message.get("source"),
+            "content": message_blocks(message),
+        } for event, message in users]
+        output.append({
+            "kind": "user",
+            "visibleId": turn["id"],
+            "createdAt": turn.get("createdAt"),
+            "runtimeThreadId": runtime_id,
+            "dshTurn": dsh_turn,
+            "sourceTurnId": turn["id"],
+            "userMessages": user_messages,
+            "content": [block for item in user_messages for block in item["content"]],
+            "text": "".join(message_text({"content": item["content"]}) for item in user_messages),
+            "responses": [],
+        })
+        current = output[-1]
+        for response in responses:
+            response_runtime = response.get("runtimeThreadId")
+            response_turn = response.get("dshTurn")
+            mapped: dict[str, Any] = {
+                "kind": "assistant",
+                "visibleId": response["id"],
+                "createdAt": response.get("createdAt"),
+                "status": response.get("status"),
+                "runtimeThreadId": response_runtime,
+                "dshTurn": response_turn,
+                "sourceResponseId": response["id"],
+            }
+            matching_events = turn_events(logs[response_runtime][1]).get(response_turn, []) if response_runtime in logs and isinstance(response_turn, int) else []
+            candidates = []
+            for event in matching_events:
+                if event.get("type") != "assistant/message":
+                    continue
+                data = event.get("data") or {}
+                message = data.get("message") if isinstance(data, dict) else None
+                if not isinstance(message, dict) or message.get("role") != "assistant":
+                    continue
+                blocks = message_blocks(message)
+                if any(block.get("type") in ("tool-call", "tool-result") for block in blocks):
+                    continue
+                text = message_text(message)
+                if text.strip():
+                    candidates.append((event, message, blocks))
+            if response.get("status") == "completed":
+                if not candidates:
+                    raise ValueError(f"Completed response {response['id']} has no final official DSH assistant message")
+                event, message, blocks = candidates[-1]
+                mapped.update({"assistantSeq": event.get("seq"), "assistantMessageId": message.get("id"),
+                               "content": blocks, "text": message_text(message)})
+            elif candidates:
+                event, message, blocks = candidates[-1]
+                mapped.update({"lastAssistantSeq": event.get("seq"), "lastAssistantMessageId": message.get("id"),
+                               "lastAssistantContent": blocks})
+            current["responses"].append(mapped)
+    return output
+
+
+def legacy_team_runs(root: Path, conversation_id: str, messages: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    runs_root = root / "dsh-runtime" / "home" / "plugins" / "rp-agent-team" / "runs"
+    if not runs_root.is_dir():
+        return []
+    state_path = root / "dsh-runtime" / "home" / "plugins" / "rp-agent-team" / "state.json"
+    state_store_present = state_path.is_file()
+    by_visible_id = {
+        response["visibleId"]: (turn, response)
+        for turn in messages for response in turn.get("responses", [])
+    }
+    result: list[dict[str, Any]] = []
+    for path in sorted(runs_root.glob("*.json")):
+        wrapper = json.loads(path.read_text(encoding="utf-8"))
+        raw = wrapper.get("run") if isinstance(wrapper, dict) else None
+        if not isinstance(raw, dict) or raw.get("conversationId") != conversation_id:
+            continue
+        old_message_id = raw.get("productMessageId")
+        pair = by_visible_id.get(old_message_id)
+        if pair is None:
+            result.append({
+                "runId": raw.get("runId"),
+                "legacyProductMessageId": old_message_id,
+                "rawArchive": str(path.relative_to(root)),
+                "importable": False,
+                "reason": "product-message-not-on-active-history",
+                "stateBaselineBefore": None,
+            })
+            continue
+        turn, response = pair
+        user_messages = turn.get("userMessages", [])
+        if len(user_messages) != 1:
+            raise ValueError(f"Legacy Team run {raw.get('runId')} requires exactly one direct user message")
+        normalized = {
+            **raw,
+            "turn": turn["dshTurn"],
+            "inputMessageId": user_messages[0]["messageId"],
+            "inputEventSeq": user_messages[0]["eventSeq"],
+            "assistantSeq": response.get("assistantSeq"),
+            "assistantMessageId": response.get("assistantMessageId"),
+        }
+        if response.get("status") != "completed":
+            normalized.pop("productMessageId", None)
+            normalized.pop("assistantSeq", None)
+            normalized.pop("assistantMessageId", None)
+        prior_state = raw.get("priorCommittedState")
+        if is_state_snapshot(prior_state):
+            baseline = prior_state
+        elif not state_store_present:
+            # The observed v0.2.1 installation had no shared/private StateStore.
+            # Preserve that fact as an explicit empty checkpoint instead of
+            # mistaking a missing file for unreadable state.
+            baseline = empty_state_snapshot()
+        else:
+            result.append({
+                "runId": raw.get("runId"),
+                "legacyProductMessageId": old_message_id,
+                "rawArchive": str(path.relative_to(root)),
+                "importable": False,
+                "reason": "state-store-present-without-run-baseline",
+                "stateBaselineBefore": None,
+            })
+            continue
+        result.append({
+            "run": normalized,
+            "stateBaselineBefore": baseline,
+            "legacyProductMessageId": old_message_id,
+            "rawArchive": str(path.relative_to(root)),
+            "importable": True,
+        })
+    return result
+
+
+def empty_state_snapshot() -> dict[str, Any]:
+    return {"revision": 0, "namespaces": {}, "pathVersions": {}}
+
+
+def is_state_snapshot(value: Any) -> bool:
+    return (
+        isinstance(value, dict)
+        and isinstance(value.get("revision"), int)
+        and value["revision"] >= 0
+        and isinstance(value.get("namespaces"), dict)
+        and isinstance(value.get("pathVersions"), dict)
+    )
+
+
+def final_state_snapshot(path: Path) -> dict[str, Any] | None:
+    if not path.is_file():
+        return None
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if is_state_snapshot(value):
+        return value
+    # Older StateStore releases stored the conversation records under a
+    # top-level `conversations` member. Keep the file untouched and expose a
+    # normalized final checkpoint only when the envelope is unambiguous.
+    records = value.get("conversations") if isinstance(value, dict) else None
+    if not isinstance(records, dict):
+        raise ValueError(f"Unrecognized legacy Team state store format: {path}")
+    return {"format": "rp-agent-team-state-store", "version": value.get("version"), "conversations": records}
+
+
+def export(root: Path, output: Path) -> dict[str, Any]:
+    database_path = root / "eleckoi-common.sqlite3"
+    if not root.is_dir() or not database_path.is_file():
+        raise ValueError("--user-data must point to a complete backed-up ElecKoi userData folder")
+    if output.exists() and any(output.iterdir()):
+        raise ValueError("--output-dir must be new or empty")
+    output.mkdir(parents=True, exist_ok=True)
+    db = open_database(database_path)
+    try:
+        available = table_names(db)
+        required = {"chat_sessions", "agent_conversations", "agent_branches", "agent_turns", "agent_responses", "agent_branch_turns"}
+        if not required.issubset(available):
+            raise ValueError("Legacy database is missing required conversation tables")
+        logs_by_id = index_session_logs(root)
+        conversation_rows = db.execute("SELECT id FROM chat_sessions ORDER BY createdAt,id").fetchall()
+        archives: list[dict[str, Any]] = []
+        mapping: dict[str, Any] = {"format": "rp-team-v024-legacy-map", "version": 1, "conversations": []}
+        for (conversation_id,) in conversation_rows:
+            snapshot = snapshot_for(db, conversation_id)
+            session_ids = sorted({
+                value for value in [
+                    snapshot["tables"]["agent_conversations"][0].get("runtimeThreadId"),
+                    *(row.get("runtimeThreadId") for row in snapshot["tables"]["agent_responses"]),
+                ] if isinstance(value, str) and value
+            })
+            logs: dict[str, tuple[dict[str, Any], list[dict[str, Any]]]] = {}
+            for session_id in session_ids:
+                path = logs_by_id.get(session_id)
+                if path is None:
+                    raise ValueError(f"Conversation {conversation_id} references missing DSH Session {session_id}")
+                logs[session_id] = read_session(path, session_id)
+            visible_messages = historical_messages(snapshot, logs)
+            run_mappings = legacy_team_runs(root, conversation_id, visible_messages)
+            safe_id = str(conversation_id)
+            archive_path = Path("conversations") / f"{safe_id}.chat-history.json"
+            archive = {
+                "format": "eleckoi.desktop-chat-history",
+                "version": 1,
+                "exportedAt": datetime.now(timezone.utc).isoformat(),
+                "snapshot": snapshot,
+                "sessionLogs": [
+                    {"header": header, "inheritedEventCount": 0, "events": events}
+                    for _, (header, events) in sorted(logs.items())
+                ],
+            }
+            write_json(output / archive_path, archive)
+            archives.append({"conversationId": conversation_id, "path": archive_path.as_posix(), "sessionCount": len(logs)})
+            mapping["conversations"].append({
+                "conversationId": conversation_id,
+                "characterId": snapshot["characterId"],
+                "archivePath": archive_path.as_posix(),
+                "historicalMessages": visible_messages,
+                "teamRuns": [item for item in run_mappings if item.get("importable")],
+                "unmappedTeamRuns": [item for item in run_mappings if not item.get("importable")],
+            })
+
+        private_rows: list[dict[str, Any]] = []
+        if "model_configs" in available:
+            names = [row[1] for row in db.execute('PRAGMA table_info("model_configs")')]
+            private_rows = [dict(zip(names, row)) for row in db.execute('SELECT * FROM "model_configs" ORDER BY rowid')]
+        model_meta = None
+        if "model_config_meta" in available:
+            names = [row[1] for row in db.execute('PRAGMA table_info("model_config_meta")')]
+            model_meta = [dict(zip(names, row)) for row in db.execute('SELECT * FROM "model_config_meta" ORDER BY rowid')]
+        private_path = output / "private" / "model-configs.private.json"
+        write_json(private_path, {"modelConfigMeta": model_meta, "modelConfigs": private_rows})
+        try:
+            os.chmod(private_path, 0o600)
+        except OSError:
+            pass
+
+        old_plugin = root / "dsh-runtime" / "home" / "plugins" / "rp-agent-team"
+        state_path = old_plugin / "state.json"
+        state_store = final_state_snapshot(state_path)
+        if state_store is not None:
+            write_json(output / "private" / "legacy-state-store.private.json", state_store)
+        if old_plugin.is_dir():
+            target = output / "private" / "legacy-rp-agent-team"
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copytree(old_plugin, target, dirs_exist_ok=True)
+        for directory in (
+            root / "blob_storage",
+            root / "media",
+            root / "dsh-runtime" / "home" / "attachments",
+        ):
+            if directory.is_dir() and any(directory.iterdir()):
+                relative_asset = Path("attachments") if directory.name == "attachments" else Path(directory.name)
+                shutil.copytree(directory, output / "assets" / relative_asset, dirs_exist_ok=True)
+
+        manifest = {
+            "format": "eleckoi.v024-legacy-userdata-export",
+            "version": 1,
+            "createdAt": datetime.now(timezone.utc).isoformat(),
+            "source": {"databaseSha256": digest_file(database_path), "readOnly": True},
+            "conversations": archives,
+            "counts": {
+                "conversations": len(archives),
+                "sessionLogs": sum(item["sessionCount"] for item in archives),
+                "historicalTeamRuns": sum(len(item["teamRuns"]) for item in mapping["conversations"]),
+                "unmappedHistoricalTeamRuns": sum(len(item["unmappedTeamRuns"]) for item in mapping["conversations"]),
+                "modelConfigs": len(private_rows),
+                "privateCredentialSidecar": True,
+            },
+            "privateModelConfigPath": "private/model-configs.private.json",
+            "legacyTeamArchivePath": "private/legacy-rp-agent-team" if old_plugin.is_dir() else None,
+            "stateStorePresent": state_path.is_file(),
+            "finalStateStorePath": "private/legacy-state-store.private.json" if state_store is not None else None,
+        }
+        write_json(output / "rp-team-v024-legacy-map.json", mapping)
+        write_json(output / "manifest.json", manifest)
+        return manifest
+    finally:
+        db.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--user-data", type=Path, required=True, help="Read-only copied 0.2.1 userData folder")
+    parser.add_argument("--output-dir", type=Path, required=True, help="New local migration output directory")
+    args = parser.parse_args()
+    try:
+        result = export(args.user_data.resolve(), args.output_dir.resolve())
+    except Exception as error:
+        print(f"Legacy export failed: {error}", file=sys.stderr)
+        return 1
+    print(json.dumps({"outputDir": str(args.output_dir.resolve()), **result["counts"],
+                      "databaseSha256": result["source"]["databaseSha256"]}, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
