+import { expect, it, vi } from 'vitest'
+vi.mock('@deepseek-ai/dsh-client-ui-conversation/client', async () => {
+  const { readFileSync } = await import('node:fs')
+  const { createRequire } = await import('node:module')
+  const { runInNewContext } = await import('node:vm')
+  const require = createRequire(import.meta.url)
+  let registration
+  runInNewContext(readFileSync(require.resolve('@deepseek-ai/dsh-client-ui-conversation/client'), 'utf8'), {
+    window: { __ModuleLoader__: { load: value => { registration = value } } },
+  })
+  return registration.factory(name => ['react', 'react/jsx-runtime', 'react-dom', '@deepseek-ai/cordis'].includes(name)
+    ? require(name) : new Proxy({}, { get: () => () => null }))
+})
+import { projectOfflineTrajectory, scopeOfflineTrajectory } from '../packages/dsh-client-trajectory/src/client/offline-trajectory.ts'
+import * as conversationRuntime from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+it('trial evidence reuses the native assembler and retains actual input, output, usage and turn identity', () => {
+  const event = (seq, type, data, surfaceOp) => ({ seq, type, data, time: 1000 + seq * 10, ...(surfaceOp ? { surfaceOp } : {}) })
+  const events = [
+    event(0, 'turn/start', { turn: 1 }),
+    event(1, 'user/message', { id: 'input', role: 'user', source: { kind: 'user' }, content: [{ type: 'text', text: 'scene' }] }, 'append'),
+    event(2, 'step/start', { turn: 1, step: 1 }),
+    event(3, 'eleckoi/request-context', { requestSeq: 2, context: [{ role: 'user', content: 'ACTUAL_REQUEST' }] }),
+    event(4, 'assistant/message', { turn: 1, step: 1, stream: [], message: { id: 'body', role: 'assistant', source: { kind: 'model' }, content: [{ type: 'text', text: 'REPLY' }] }, usage: { inputTokens: 7, outputTokens: 3 } }, 'append'),
+    event(5, 'step/end', { turn: 1, step: 1 }),
+    event(6, 'turn/end', { turn: 1, reason: { kind: 'completed' } }),
+  ]
+  const snapshot = projectOfflineTrajectory(events, conversationRuntime)
+  expect(snapshot.turnEvents).toMatchObject([{ turn: 1, inputMessageId: 'input', inputEventSeq: 1, status: 'completed' }])
+  expect(snapshot.requests).toHaveLength(1)
+  expect(snapshot.requests[0].context[0].content).toBe('ACTUAL_REQUEST')
+  expect(snapshot.eventNodes.find(node => node.kind === 'assistant').blocks).toMatchObject([{ kind: 'text', text: 'REPLY' }])
+  const replay = projectOfflineTrajectory(events, conversationRuntime)
+  expect(JSON.stringify(replay.eventNodes)).toBe(JSON.stringify(snapshot.eventNodes))
+  expect(JSON.stringify(replay.requests)).toBe(JSON.stringify(snapshot.requests))
+  expect([...replay.eventLocations.keys()]).toEqual([...snapshot.eventLocations.keys()])
+})
+
+it('trial scope hides source-history steps while preserving full native request inputs and identity maps', () => {
+  const snapshot = {
+    turnEvents: [{turn:1},{turn:2}], eventNodes:[{seq:1,kind:'user'},{seq:4,kind:'assistant',turn:2}],
+    eventLocations:new Map([[1,{kind:'turn',turn:{turn:1}}],[4,{kind:'step',turn:{turn:2}}]]),
+    requests:[{purpose:'assistant',turn:1,startSeq:2},{purpose:'assistant',turn:2,startSeq:3,prompt:{messages:['SOURCE_HISTORY','CURRENT_INPUT']}}],
+    systemPrompts:['NATIVE_SYSTEM'], callSchemas:new Map(), partial:null, runningCalls:[],
+  }
+  const scoped=scopeOfflineTrajectory(snapshot,[2])
+  expect(scoped.requests).toEqual([snapshot.requests[1]])
+  expect(scoped.eventNodes).toEqual([snapshot.eventNodes[1]])
+  expect(scoped.turnEvents).toEqual([{turn:2}])
+  expect(scoped.requests[0].prompt.messages).toEqual(['SOURCE_HISTORY','CURRENT_INPUT'])
+  expect(scoped.eventLocations).toBe(snapshot.eventLocations)
+  expect(scoped.systemPrompts).toBe(snapshot.systemPrompts)
+})
