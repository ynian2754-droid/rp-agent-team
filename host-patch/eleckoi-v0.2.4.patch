+  /** Import a pre-0.2.4 archive without changing its visible conversation/message identities. */
+  importLegacy(snapshot: ConversationArchiveSnapshot, characterId: string, runtimeIds: ReadonlyMap<string, string>): {
+    conversationId: string
+    insertedRows: number
+  } {
+    if (snapshot.characterId !== characterId) throw new Error('聊天记录与当前角色不匹配。')
+    const character = this.store.native.prepare('SELECT id FROM characters WHERE id=?').get(characterId)
+    if (!character) throw new Error('当前角色不存在，无法迁移旧聊天记录。')
+
+    const COLUMN_REFS = new Set(['id', 'sessionId', 'conversationId', 'branchId', 'activeBranchId', 'turnId', 'speakerId', 'ownerId', 'runtimeThreadId'])
+    const tables = snapshot.tables as Record<Table, Row[]>
+    let insertedRows = 0
+    this.store.withWriteTx(() => {
+      for (const table of TABLES) {
+        const columns = this.store.native.pragma(`table_info(${table})`) as Array<{ name: string; pk: number }>
+        const allowed = new Set(columns.map((column) => column.name))
+        const primaryKey = columns.filter((column) => column.pk > 0).sort((left, right) => left.pk - right.pk).map((column) => column.name)
+        if (primaryKey.length === 0) throw new Error(`旧聊天表 ${table} 缺少主键，无法安全迁移。`)
+        for (const original of tables[table]) {
+          if (Object.keys(original).some((key) => !allowed.has(key))) throw new Error('旧聊天记录与当前数据库结构不兼容。')
+          const row: Row = { ...original }
+          for (const key of COLUMN_REFS) {
+            if (typeof row[key] !== 'string') continue
+            if (key === 'runtimeThreadId') row[key] = runtimeIds.get(row[key] as string) ?? row[key]!
+          }
+          const where = primaryKey.map((key) => `"${key}"=?`).join(' AND ')
+          const existing = this.store.native.prepare(`SELECT * FROM "${table}" WHERE ${where}`).get(
+            ...primaryKey.map((key) => row[key])
+          ) as Row | undefined
+          if (existing) {
+            if (table === 'chat_sessions' && existing.characterId !== characterId) {
+              throw new Error('旧聊天编号已绑定到另一张角色卡。')
+            }
+            const owner = existing.conversationId ?? existing.sessionId ?? existing.id
+            if (owner !== snapshot.conversationId && table !== 'chat_sessions') {
+              throw new Error(`旧聊天记录的身份 ${table} 已被另一条记录占用。`)
+            }
+            continue
+          }
+          const keys = Object.keys(row)
+          if (keys.length === 0) throw new Error('旧聊天记录数据格式不正确。')
+          this.store.native.prepare(`INSERT INTO "${table}" (${keys.map((key) => `"${key}"`).join(',')}) VALUES (${keys.map(() => '?').join(',')})`)
+            .run(...keys.map((key) => row[key]))
+          insertedRows++
+        }
+      }
+    })
+    return { conversationId: snapshot.conversationId, insertedRows }
+  }
 }
