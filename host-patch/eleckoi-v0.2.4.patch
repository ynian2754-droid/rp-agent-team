+      return {
+        replayedTurns,
+        productRows,
+        teamRuns: importedRuns,
+        summary: {
+          conversationId: item.conversationId,
+          sessionId,
+          turns: history.length,
+          teamRuns: importedRuns,
+          unmappedTeamRuns: item.unmappedTeamRuns?.length ?? 0,
