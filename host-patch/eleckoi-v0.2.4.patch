+import type * as ConversationRuntime from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { ConversationNodeDefinition } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionEvent } from '@deepseek-ai/dsh-session/types'
+import type {} from '@eleckoi/dsh-client-roleplay/projections'
+import { registerTrajectoryMessageDefinitions } from './trajectory-message-definitions.ts'
+import { registerTrajectoryAssistantDefinition } from './trajectory-assistant-definition.ts'
+import { registerTrajectoryToolDefinition } from './trajectory-tool-definition.ts'
+import { registerTrajectoryRequestHeaderDefinition } from './trajectory-request-header-definition.ts'
+import { registerTrajectoryCompactionDefinitions } from './trajectory-compaction-definition.ts'
+import { registerTrajectoryConversationView } from './trajectory-snapshot-builder.ts'
+import { turnOutcomesProjection } from '../../../dsh-client-roleplay/src/host/turn-outcomes-projection.mjs'
+import { adaptTrajectorySnapshot } from '../../../../src/renderer/src/modules/chat/model/trajectorySnapshotAdapter.js'
+import type { TrajectorySnapshot } from './trajectory-contract.ts'
+
+/** Replay native trial evidence through the same definitions as a retained live Session. */
+export function projectOfflineTrajectory(events: readonly SessionEvent[], runtime: Pick<typeof ConversationRuntime, 'ConversationNodeAssembler' | 'UiConversation'>): TrajectorySnapshot {
+  const { ConversationNodeAssembler, UiConversation } = runtime
+  const definitions: ConversationNodeDefinition[] = []
+  const views: unknown[] = []
+  const ctx = { uiConversation: {
+    inspectSystemPrompt: UiConversation.prototype.inspectSystemPrompt,
+    inspectRequestPrompt: UiConversation.prototype.inspectRequestPrompt,
+    events: { register: (definition: ConversationNodeDefinition) => definitions.push(definition) },
+    views: { register: (definition: unknown) => views.push(definition) },
+  } } as unknown as Context
+  for (const register of [registerTrajectoryMessageDefinitions, registerTrajectoryAssistantDefinition,
+    registerTrajectoryToolDefinition, registerTrajectoryRequestHeaderDefinition,
+    registerTrajectoryCompactionDefinitions, registerTrajectoryConversationView]) register(ctx)
+  const assembler = new ConversationNodeAssembler(
+    { entries: () => definitions, fallbackEntry: () => undefined } as never,
+    { entries: () => views } as never)
+  assembler.replaceWindow(events.map(event => ({ type: 'event' as const, event })), false)
+  assembler.activateTarget('trajectory')
+  assembler.flush()
+  const contexts = Object.fromEntries(events.filter(event => event.type === 'eleckoi/request-context')
+    .map(event => { const data = event.data as { requestSeq: number; context: unknown }; return [data.requestSeq, data.context] }))
+  const outcomes = events.reduce((state, event) => turnOutcomesProjection.apply(state, event), turnOutcomesProjection.init())
+  return adaptTrajectorySnapshot(assembler.snapshot('trajectory') as TrajectorySnapshot, contexts, outcomes)
+}
+
+/** Frozen source history remains in request inspectors, not in the trial execution ledger. */
+export function scopeOfflineTrajectory(snapshot: TrajectorySnapshot, visibleTurns?: readonly number[]): TrajectorySnapshot {
+  if (!visibleTurns) return snapshot
+  const allowed = new Set(visibleTurns)
+  const turnAt = (seq: number) => {
+    const location = snapshot.eventLocations.get(seq)
+    return location && 'turn' in location ? location.turn.turn : undefined
+  }
+  return { ...snapshot,
+    ...(snapshot.turnEvents ? { turnEvents: snapshot.turnEvents.filter(event => allowed.has(event.turn)) } : {}),
+    eventNodes: snapshot.eventNodes.filter(node => {
+      const turn = 'turn' in node && typeof node.turn === 'number' ? node.turn : turnAt(node.seq)
+      return turn !== undefined && allowed.has(turn)
+    }),
+    requests: snapshot.requests.filter(request => {
+      const turn = request.purpose === 'assistant' ? request.turn : turnAt(request.startSeq)
+      return turn !== undefined && allowed.has(turn)
+    }),
+  }
+}
