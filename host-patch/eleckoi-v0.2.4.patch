+      patchFiles: [patchPath, join(hostRoot, 'resources', 'dsh', 'desktop-agent.patch.yml')],
+      args: ['--no-open', '--port', '0'],
+      packageManager: {
+        command: process.execPath,
+        args: ['--expose-internals', packageManagerPath],
+        env: { ...process.env, ...hostEnvironment(), ELECTRON_RUN_AS_NODE: '1', DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+          PATH: `${nodeBinPath}${delimiter}${process.env.PATH ?? ''}` },
+      },
+    })
+    const manager = running.ctx.pluginManager
+    const install = await manager.installBundle(pluginRoot)
+    assert.equal(install.application, 'applied', `Could not install RP Team fixture bundle: ${JSON.stringify(install)}`)
+    const ctx = running.ctx
+    const team = ctx.rpAgentTeam
+    assert.ok(team?.startTrial && team?.freezeTrialSnapshot, 'RP Team trial API did not mount in the isolated Host profile.')
+
+    await ctx.credentials.set(apiKeyRef, apiKey)
+    const llmSettings = ctx.settings.describe().find(row => row.ns === 'llm-pi-ai')
+    assert.ok(llmSettings, 'The native pi-ai settings namespace is missing.')
+    await ctx.settings.mutate('llm-pi-ai', [{ op: 'set', path: ['providers', modelProvider], value: {
+      displayName: 'RP Team Trial Local Fixture', api: 'openai-completions',
+      baseURL: `http://127.0.0.1:${server.address().port}/v1`, apiKeyEnv: apiKeyRef,
+      models: [{ id: modelId, name: 'RP Team Trial Native Fixture', contextWindow: 8192, maxTokens: 512,
+        input: ['text'], reasoningEfforts: false }],
+    } }], llmSettings.revision)
+    await ctx.llm.resolveModelInfo(modelProvider, modelId)
+    assert.ok(ctx.llm.listProviders().some(provider => provider.id === modelProvider), 'Local pi-ai model route did not load.')
+
+    const characterId = `trial-fixture-${randomUUID()}`
+    ctx.eleckoiCharactersApi.create({ id: characterId, name: 'RP Team trial fixture card', primaryOpening: '' })
+    const created = await ctx.eleckoiConversationsApi.create({ title: 'RP Team trial fixture source',
+      metadata: { characterId, characterName: 'RP Team trial fixture card' } })
+    const conversationId = created.conversation.id
+    const selection = { provider: modelProvider, model: modelId }
+    await ctx.eleckoiConversationModelsApi.select(conversationId, selection)
+
+    const saved = await team.getConfig({ conversationId })
+    const outputAgent = structuredClone(saved.config.agents.find(agent => agent.id === saved.config.output.agentId))
+    outputAgent.systemPrompt = 'Use rp_team_state_version, then update /trial with rp_team_write_state, then publish the required fixture response with rp_team_publish.'
+    outputAgent.modelRef = 'inherit'
+    outputAgent.triggers = [{ type: 'always' }]
+    outputAgent.execution.after = []
+    outputAgent.communication = { sendTo: [], receiveFrom: [], requestTo: [], requestFrom: [] }
+    outputAgent.context = { sources: [{ type: 'current_input' }] }
+    outputAgent.statePermissions = [{ namespace: 'shared', path: '/trial', access: 'readwrite' }]
+    outputAgent.outputAuthority = { internal: true, draft: true, state: true, user: true }
+    outputAgent.execution.trustedTools = []
+    const config = structuredClone(saved.config)
+    config.agents = [outputAgent]
+    config.state = { definitions: [{ namespace: 'shared', path: '/trial', type: 'object', default: { count: 0 } }] }
+    const committedConfig = await team.saveConfig({ conversationId, expectedRevision: saved.revision, enabled: true, config })
+    assert.equal(committedConfig.enabled, true)
+
+    const sourceArchiveBefore = JSON.parse(await ctx.eleckoiConversationsApi.exportArchive(conversationId))
+    delete sourceArchiveBefore.exportedAt
+    const snapshot = await team.freezeTrialSnapshot({ conversationId })
+    const twoTurns = fullTrial || cancelRetry || hardInterruption || checkpointRetry
+    const scenario = {
+      id: `trial-scenario-${randomUUID()}`, name: 'Isolated native trial checkpoint fixture', snapshotId: snapshot.snapshotId,
+      steps: (twoTurns ? [1, 2] : [1]).map(turn => ({ id: `turn-${turn}`, inputText: `TRIAL_STEP_${turn}`, assertions: [
+        { type: 'body_contains', text: `TRIAL_NATIVE_PUBLICATION_${turn}` },
+        { type: 'state_equals', namespace: 'shared', path: '/trial', value: { count: turn } },
+      ] })),
+    }
+    const variants = (fullTrial ? ['candidate-a', 'candidate-b'] : ['candidate-a']).map(id => {
+      const variantConfig = structuredClone(config)
+      variantConfig.agents[0].systemPrompt += ` Variant ${id}.`
