+    blocks: [{ kind: 'reasoning', text: 'CHAIN_CANARY' }, { kind: 'text', text }],
+    usage: { inputTokens: 7, outputTokens: 3 }, timing: { stepStartTime: 1000, completedTime: 2000 },
+  }       ], eventLocations: new Map(), requests: [], callSchemas: new Map(), runningCalls: [],
