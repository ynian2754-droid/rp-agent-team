+async function importConversation(ctx, exportRoot, item) {
+  if (!item || typeof item.conversationId !== 'string' || typeof item.characterId !== 'string'
+    || typeof item.archivePath !== 'string' || !Array.isArray(item.historicalMessages)
+    || !Array.isArray(item.teamRuns)) {
