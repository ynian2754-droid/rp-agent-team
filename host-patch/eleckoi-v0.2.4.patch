+++ b/tests/dsh-legacy-migration-cli.test.js
@@ -0,0 +1,64 @@
+import { createHash } from 'node:crypto'
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync, existsSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve } from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { afterEach, expect, test } from 'vitest'
+
+const roots = []
+afterEach(() => roots.splice(0).forEach(path => rmSync(path, { recursive: true, force: true })))
+const digest = value => createHash('sha256').update(value).digest('hex')
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'eleckoi-migration-cli-'))
+  roots.push(root)
+  const userData = join(root, 'copy')
+  const exportRoot = join(root, 'export')
+  mkdirSync(userData)
+  mkdirSync(exportRoot)
+  const database = 'closed verified database checkpoint'
+  const map = '{}'
+  const bundle = 'verified bundle bytes'
+  const bundlePath = join(root, 'team.tgz')
+  const databasePath = join(userData, 'eleckoi-common.sqlite3')
+  const progressPath = join(userData, 'v024-migration-progress.json')
+  writeFileSync(databasePath, database)
+  writeFileSync(bundlePath, bundle)
+  writeFileSync(join(exportRoot, 'rp-team-v024-legacy-map.json'), map)
+  writeFileSync(join(exportRoot, 'manifest.json'), JSON.stringify({
+    format: 'eleckoi.v024-legacy-userdata-export', version: 1,
+    source: { readOnly: true, databaseSha256: digest('original database') }
+  }))
+  const progress = {
+    format: 'eleckoi.v024-migration-progress', version: 1, userData,
+    mapSha256: digest(map), sourceDatabaseSha256: digest('original database'),
+    databaseSha256: digest(database), phase: 'complete', bundleSha256: digest(bundle),
+    result: { imported: { conversations: 2, replayedTurns: 3 } }
+  }
+  writeFileSync(progressPath, JSON.stringify(progress))
+  const run = () => spawnSync(process.execPath, [
+    resolve('scripts/migrate-v024-userdata.mjs'), '--user-data-dir', userData,
+    '--export-dir', exportRoot, '--team-bundle', bundlePath
+  ], { encoding: 'utf8', env: { ...process.env, ELECTRON_RUN_AS_NODE: '1' } })
+  return { userData, databasePath, progressPath, run }
+}
+
+test('completed identical migration does not reopen Host or rewrite settings', () => {
+  const item = fixture()
+  const before = readFileSync(item.progressPath, 'utf8')
+  const result = item.run()
+  expect(result.status, result.stderr).toBe(0)
+  expect(JSON.parse(result.stdout)).toMatchObject({ ok: true, alreadyComplete: true })
+  expect(readFileSync(item.progressPath, 'utf8')).toBe(before)
+  expect(existsSync(join(item.userData, 'dsh-runtime'))).toBe(false)
+})
+
+test('changed checkpoint is rejected without replacing the recorded hash', () => {
+  const item = fixture()
+  const before = readFileSync(item.progressPath, 'utf8')
+  writeFileSync(item.databasePath, 'unrelated later changes')
+  const result = item.run()
+  expect(result.status).toBe(1)
+  expect(result.stderr).toContain('database changed after the recorded migration checkpoint')
+  expect(readFileSync(item.progressPath, 'utf8')).toBe(before)
+  expect(existsSync(join(item.userData, 'dsh-runtime'))).toBe(false)
+})
