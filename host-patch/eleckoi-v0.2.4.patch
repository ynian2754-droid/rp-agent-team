+async function runCancellationScenario(ctx, team, baseConfig) {
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team cancellation fixture', stateFixtureConfig(baseConfig, 'CANCEL'))
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId, 'V024_CANCEL_FIXTURE: wait until an actor is running so this turn can be cancelled.')
+  const work = prompt.work.catch(() => undefined)
+  await waitForFixtureRow(row => row.fixture === 'cancel-waiting')
+  const active = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.ok(active?.runId && !['failed', 'cancelled', 'complete'].includes(active.phase), 'Cancellation fixture never had an active Team run')
+  await ctx.sessionController.cancel({ sessionId: scenario.sessionId })
+  const ended = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  await work
+  const receipt = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: active.runId })
+  assert.equal(receipt.outcome, 'unknown', 'An unstaged pre-publication cancellation must not fabricate a Host product receipt')
+  const cancelledStatus = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(cancelledStatus.phase, 'cancelled')
+  assert.equal(cancelledStatus.productCommitStaged, false)
+  assert.equal(ended.inspection.events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === ended.event.data?.turn).length, 0, 'Cancelled fixture must not publish an assistant message')
+  return { ...scenario, runId: active.runId }
+}
