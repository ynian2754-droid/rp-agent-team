+import { filterLocalDeliveryRouteNotice } from '../packages/dsh-client-roleplay/src/host/conversation-context.mjs'
+
+describe('Host Runtime extension registry', () => {
+  it('installs the resolved member preset once before native child execution', async () => {
+    let selected = 'parent-preset'
+    const events = []
+    const agent = { ctx: {}, session: { append: (type, data) => events.push({ type, data }) } }
+    const presets = {
+      composedPreset: () => selected,
+      recompose: vi.fn(async (_ctx, id) => { selected = id })
+    }
+    await selectResolvedChildPreset(presets, agent, 'member-preset')
+    await selectResolvedChildPreset(presets, agent, 'member-preset')
+    expect(presets.recompose).toHaveBeenCalledOnce()
+    expect(events).toEqual([{ type: 'agent-preset/selected', data: { agentPreset: 'member-preset' } }])
+  })
+  it('counts retained user identities despite compression and reused event sequences', () => {
+    const input = id => ({ role: 'user', id, source: { kind: 'user' } })
+    const event = (seq, id) => ({ seq, type: 'user/message', surfaceOp: 'append', data: input(id) })
+    const events = [event(1, 'first'), event(53, 'current'),
+      { seq: 54, type: 'user/message', surfaceOp: 'append', data: { ...input('synthetic'), source: { kind: 'plugin:context' } } },
+      { seq: 55, type: 'assistant/message', surfaceOp: { op: 'replace', startSeq: 1, endSeq: 54 }, data: {} }]
+    expect(activeUserInputIds(events, input('current'))).toEqual(['first', 'current'])
+    expect(activeUserInputIds([event(1, 'first')], input('rerolled-current'))).toEqual(['first', 'rerolled-current'])
+  })
+  it('installs extensions on an already-live stable Session and awaits cleanup', async () => {
