@@ -0,0 +1,403 @@
+import assert from 'node:assert/strict'
+import { execFileSync } from 'node:child_process'
+import { createServer } from 'node:http'
+import { existsSync, mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { tmpdir } from 'node:os'
+import { delimiter, dirname, join, resolve } from 'node:path'
+import { randomUUID } from 'node:crypto'
+import { initProfile, loadLayeredEnv, loadProfileDirectory, PROFILE_TEMPLATES } from '@deepseek-ai/dsh-app-boot'
+import { runProfile } from '@deepseek-ai/dsh/profile-boot'
+import { ELECKOI_DESKTOP_BUNDLES, ELECKOI_INSTALL_ANCHOR, registerDesktopBundles } from '@eleckoi/dsh-runtime'
+
+const require = createRequire(import.meta.url)
+const hostRoot = resolve(import.meta.dirname, '..')
+const pluginRoot = resolve(hostRoot, '..', 'rp-agent-team-plugin')
+const userDataRoot = mkdtempSync(join(tmpdir(), 'rp-team-trial-native-'))
+const keepHome = process.argv.includes('--keep-home')
+const runtimeDataRoot = join(userDataRoot, 'dsh-runtime')
+const home = join(runtimeDataRoot, 'home')
+const profilePath = join(home, 'profiles', 'desktop')
+const sessionRoot = join(runtimeDataRoot, 'sessions')
+const workspaceRoot = join(userDataRoot, 'workspace')
+const mediaRoot = join(userDataRoot, 'media')
+const modelRequests = []
+const modelProvider = 'rp-team-trial-local'
+const modelId = 'rp-team-fixture'
+const apiKeyRef = 'RP_TEAM_TRIAL_LOCAL_API_KEY'
+const apiKey = 'rp-team-local-only-fixture-key'
+const teamBundleName = '@rp-team/dsh-roleplay-team'
+const fullTrial = process.argv.includes('--full')
+const cancelRetry = process.argv.includes('--cancel-retry')
+const hardInterruption = process.argv.includes('--hard-interruption')
+const checkpointRetry = process.argv.includes('--checkpoint-retry')
+let blockNextTurnTwo = cancelRetry || hardInterruption || checkpointRetry
+let blockedCallResolve
+const blockedCall = new Promise(resolveBlocked => { blockedCallResolve = resolveBlocked })
+const packageManagerPath = join(dirname(require.resolve('pnpm')), 'bin', 'pnpm.mjs')
+const nodeBinPath = join(hostRoot, 'resources', 'dsh', 'node-bin')
+
+function hostEnvironment() {
+  return {
+    DSH_HOME: home,
+    DSH_SESSION_ROOT: sessionRoot,
+    DSH_CWD: workspaceRoot,
+    ELECKOI_SESSION_SNAPSHOT_ROOT: join(runtimeDataRoot, 'session-snapshots'),
+    ELECKOI_PRESET_ROOT: join(runtimeDataRoot, 'generated-presets'),
+    ELECKOI_SESSION_BRIDGE_ROOT: join(runtimeDataRoot, 'session-bridges'),
+    ELECKOI_PRESET_TEMPLATE_PATH: join(hostRoot, 'resources', 'dsh', 'agent-preset-template', 'agent.cordis.yml'),
+    ELECKOI_DATABASE_PATH: join(userDataRoot, 'eleckoi-common.sqlite3'),
+    ELECKOI_MEDIA_ROOT: mediaRoot,
+    ELECKOI_WORKSPACE_ROOT: workspaceRoot,
+    DSH_TELEMETRY_DISABLED: '1',
+  }
+}
+
+function sse(res, body, data = {}) {
+  res.write(`data: ${JSON.stringify({
+    id: 'rp-team-trial-fixture', object: 'chat.completion.chunk', created: 1,
+    model: modelId, choices: [{ index: 0, ...body }], ...data,
+  })}\n\n`)
+}
+
+function messageText(message) {
+  if (typeof message?.content === 'string') return message.content
+  if (!Array.isArray(message?.content)) return ''
+  return message.content.map(item => typeof item === 'string' ? item : item?.text ?? '').join('\n')
+}
+
+function toolNames(message) {
+  return (message?.tool_calls ?? message?.toolCalls ?? [])
+    .map(call => call.function?.name ?? call.name).filter(Boolean)
+}
+
+function hasToolCall(messages, name) {
+  return messages.some(message => toolNames(message).includes(name)
+    || message?.function_call?.name === name || message?.functionCall?.name === name)
+}
+
+function selectFixtureReply(body) {
+  const messages = body.messages ?? []
+  const joined = messages.map(messageText).join('\n')
+  const turn = joined.lastIndexOf('TRIAL_STEP_2') > joined.lastIndexOf('TRIAL_STEP_1') ? 2 : 1
+  const marker = `TRIAL_STEP_${turn}`
+  let markerIndex = -1
+  for (let index = 0; index < messages.length; index += 1) {
+    if (messageText(messages[index]).includes(marker)) markerIndex = index
+  }
+  const current = messages.slice(Math.max(0, markerIndex))
+  const names = new Set((body.tools ?? []).map(tool => tool.function?.name ?? tool.name).filter(Boolean))
+  const count = turn
+  const publication = `TRIAL_NATIVE_PUBLICATION_${turn}`
+  let tool
+  if (names.has('rp_team_state_version') && !hasToolCall(current, 'rp_team_state_version')) {
+    tool = { name: 'rp_team_state_version', args: { namespace: 'shared', path: '/trial' } }
+  } else if (names.has('rp_team_write_state') && !hasToolCall(current, 'rp_team_write_state')) {
+    const toolResult = current.filter(message => message?.role === 'tool').map(messageText).join('\n')
+    const version = Number(toolResult.match(/"version"\s*:\s*(\d+)/u)?.[1] ?? 0)
+    tool = { name: 'rp_team_write_state', args: { namespace: 'shared', path: '/trial', value: { count }, expectedVersion: version } }
+  } else if (names.has('rp_team_publish') && !hasToolCall(current, 'rp_team_publish')) {
+    tool = { name: 'rp_team_publish', args: { body: publication } }
+  }
+  return { turn, tool, publication }
+}
+
+async function startLocalModelServer() {
+  const server = createServer(async (req, res) => {
+    if (req.method !== 'POST' || !req.url?.endsWith('/chat/completions')) {
+      res.writeHead(404).end('not found')
+      return
+    }
+    let source = ''
+    for await (const chunk of req) source += chunk
+    const body = JSON.parse(source)
+    assert.equal(req.headers.authorization, `Bearer ${apiKey}`, 'Only the private fixture credential should reach the local adapter.')
+    assert.equal(body.model, modelId)
+    const reply = selectFixtureReply(body)
+    modelRequests.push({ turn: reply.turn, tool: reply.tool?.name, model: body.model })
+    res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' })
+    if (reply.turn === 2 && blockNextTurnTwo) {
+      blockNextTurnTwo = false
+      blockedCallResolve(reply)
+      if (checkpointRetry) {
+        sse(res, { delta: { role: 'assistant', content: 'This fixture intentionally finishes without publishing a body.' }, finish_reason: null })
+        sse(res, { delta: {}, finish_reason: 'stop' }, { usage: { prompt_tokens: 12, completion_tokens: 4, total_tokens: 16 } })
+        res.end('data: [DONE]\n\n')
+        return
+      }
+      if (cancelRetry) {
+        if (reply.tool) {
+          sse(res, { delta: { tool_calls: [{ index: 0, id: `call-${modelRequests.length}`, type: 'function', function: {
+            name: reply.tool.name, arguments: JSON.stringify(reply.tool.args),
+          } }] }, finish_reason: null })
+          sse(res, { delta: {}, finish_reason: 'tool_calls' }, { usage: { prompt_tokens: 12, completion_tokens: 4, total_tokens: 16 } })
+        } else {
+          sse(res, { delta: { role: 'assistant', content: reply.publication }, finish_reason: 'stop' },
+            { usage: { prompt_tokens: 12, completion_tokens: 4, total_tokens: 16 } })
+        }
+      }
+      await new Promise(resolveClose => res.once('close', resolveClose))
+      return
+    }
+    if (reply.tool) {
+      sse(res, { delta: { tool_calls: [{ index: 0, id: `call-${modelRequests.length}`, type: 'function', function: {
+        name: reply.tool.name, arguments: JSON.stringify(reply.tool.args),
+      } }] }, finish_reason: null })
+      sse(res, { delta: {}, finish_reason: 'tool_calls' }, { usage: { prompt_tokens: 24, completion_tokens: 8, total_tokens: 32 } })
+    } else {
+      sse(res, { delta: { role: 'assistant', content: reply.publication }, finish_reason: null })
+      sse(res, { delta: {}, finish_reason: 'stop' }, { usage: { prompt_tokens: 24, completion_tokens: 12, total_tokens: 36 } })
+    }
+    res.end('data: [DONE]\n\n')
+  })
+  await new Promise((resolveListen, reject) => server.listen(0, '127.0.0.1', resolveListen).once('error', reject))
+  return server
+}
+
+async function waitForTrial(team, trialId, maximumMs = 240_000) {
+  const deadline = Date.now() + maximumMs
+  while (Date.now() < deadline) {
+    const trial = (await team.getTrial({ trialId })).trial
+    if (['complete', 'failed', 'cancelled', 'interrupted'].includes(trial.status)) return trial
+    await new Promise(resolveSleep => setTimeout(resolveSleep, 100))
+  }
+  throw new Error(`Trial ${trialId} did not reach a terminal state within ${maximumMs} ms.`)
+}
+
+function timeout(milliseconds, message) {
+  return new Promise((_, reject) => {
+    const timer = setTimeout(() => reject(new Error(message)), milliseconds)
+    timer.unref?.()
+  })
+}
+
+function findWorkerMarker(trialId) {
+  const root = join(tmpdir(), 'rpt')
+  if (!existsSync(root)) return undefined
+  for (const namespace of readdirSync(root, { withFileTypes: true })) {
+    if (!namespace.isDirectory()) continue
+    for (const trialRoot of readdirSync(join(root, namespace.name), { withFileTypes: true })) {
+      if (!trialRoot.isDirectory()) continue
+      const markerPath = join(root, namespace.name, trialRoot.name, '.worker-process.json')
+      try {
+        const marker = JSON.parse(readFileSync(markerPath, 'utf8'))
+        if (marker.trialId === trialId && Number.isSafeInteger(marker.pid)) return marker
+      } catch {}
+    }
+  }
+  return undefined
+}
+
+async function run() {
+  mkdirSync(home, { recursive: true })
+  for (const path of [runtimeDataRoot, sessionRoot, workspaceRoot, mediaRoot]) mkdirSync(path, { recursive: true })
+  Object.assign(process.env, hostEnvironment())
+  const server = await startLocalModelServer()
+  let running
+  try {
+    if (!process.argv.includes('--skip-build')) {
+      execFileSync(process.execPath, ['scripts/build.mjs'], { cwd: pluginRoot, stdio: 'inherit' })
+    }
+    const patchPath = join(userDataRoot, 'trial-profile.patch.yml')
+    writeFileSync(patchPath, [
+      '- id: desktop-product-telemetry', '  disabled: true',
+      '- id: product-analytics', '  disabled: true', '',
+    ].join('\n'))
+    initProfile(profilePath, [...PROFILE_TEMPLATES.web.bundles, ...ELECKOI_DESKTOP_BUNDLES])
+    registerDesktopBundles(profilePath)
+    const loaded = loadProfileDirectory('dsh', profilePath, ELECKOI_INSTALL_ANCHOR)
+    assert.deepEqual(loaded.skippedBundles, [], `Fresh fixture profile is missing native bundles: ${JSON.stringify(loaded.skippedBundles)}`)
+    running = await runProfile({
+      environment: { ...loadLayeredEnv('dsh'), ...hostEnvironment() },
