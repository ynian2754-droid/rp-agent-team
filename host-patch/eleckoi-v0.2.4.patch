+    if (options.model === 'actor' && step === 0) {
+      if (!tools.includes('rp_team_publish')) throw new Error('The configured publisher has no rp_team_publish tool')
+      const id = 'rp-team-v024-publish-' + sessionId
+      const args = JSON.stringify({ body: ${JSON.stringify(FIXTURE_BODY)}, selectedDraftIds: [] })
