+
+class HistoryReplayAdapter extends LlmAdapter {
+  constructor(provider) {
+    super()
+    this.provider = provider
+    this.pending = new Map()
+  }
+
+  providerInfo(provider) { return { id: provider, name: 'Local history replay' } }
+  listModels(provider) {
+    return Promise.resolve([{ provider, id: HISTORY_MODEL, name: 'Local history replay', inputModalities: ['text', 'image'] }])
+  }
+  async resolveModel(provider, model) {
+    if (provider !== this.provider || model !== HISTORY_MODEL) throw new Error('Unknown local history replay route.')
+    return {
+      provider,
+      id: model,
+      name: 'Local history replay',
+      inputModalities: ['text', 'image'],
+      context: { contextWindow: 10_000_000 },
+      defaultMaxTokens: 4096
+    }
+  }
+
+  enqueue(sessionId, response) {
+    const queue = this.pending.get(sessionId) ?? []
+    let startedResolve
+    const started = new Promise(resolve => { startedResolve = resolve })
+    queue.push({ ...response, startedResolve, started })
+    this.pending.set(sessionId, queue)
+    return started
+  }
+
+  async *stream(options) {
+    if (options.purpose === 'session-title') {
+      yield* textChunks('迁移的聊天记录')
+      return
+    }
+    const sessionId = String(options.sessionId ?? '')
+    const response = this.pending.get(sessionId)?.shift()
+    if (!response) throw new Error('Unexpected model call during local history replay.')
+    response.startedResolve()
+    if (response.cancelled) await waitForAbort(options.signal)
+    const text = response.text
+    yield* textChunks(text)
+  }
+}
+
+async function* textChunks(text) {
+  yield { type: 'block-start', index: 0, blockType: 'text' }
+  if (text) yield { type: 'text-delta', index: 0, text }
+  yield { type: 'block-end', index: 0, block: { type: 'text', text } }
+  yield { type: 'finish', reason: { kind: 'stop' } }
+}
+
+function waitForAbort(signal) {
+  if (!signal) return Promise.reject(new Error('A cancelled history replay must have a request signal.'))
+  if (signal.aborted) return Promise.reject(signal.reason ?? new Error('aborted'))
+  return new Promise((resolve, reject) => signal.addEventListener('abort', () => {
+    reject(signal.reason ?? new Error('aborted'))
+  }, { once: true }))
+}
+
+function installLocalOnlyLlmGuard(ctx, provider) {
+  return ctx.on('llm/stream', (options, next) => {
+    if (options.provider !== provider) throw new Error('Legacy import blocked a non-local model request.')
+    return next()
+  }, { global: true, prepend: true })
+}
+
+async function promptContentForHistory(ctx, sessionId, history) {
+  const result = []
+  for (const block of history.content) {
+    if (block.type === 'text') {
+      result.push({ type: 'text', text: block.text })
+    } else if (block.type === 'image') {
+      const reference = block.attachment
+      if (!reference?.attachmentId) throw new Error('旧聊天图片附件缺少稳定引用。')
+      const image = await ctx.attachments.readImage(reference)
+      if (!image?.data || !reference.mediaType) throw new Error('旧聊天图片附件无法读取。')
+      result.push({
+        type: 'image',
+        mediaType: reference.mediaType,
+        data: Buffer.from(image.data).toString('base64'),
+        ...(reference.name ? { name: reference.name } : {})
+      })
+    } else if (block.type === 'file') {
+      const reference = block.attachment
+      if (!reference?.attachmentId || !Number.isSafeInteger(reference.bytes)) throw new Error('旧聊天文件附件缺少稳定引用。')
+      const uploaded = await ctx.fileUploads.uploadStream({
+        sessionId,
+        data: ctx.attachments.readFileStream(reference),
+        name: reference.name
+      })
+      result.push({ type: 'file', receiptId: uploaded.receiptId })
+    } else {
+      throw new Error(`不支持迁移此类型的用户附件：${String(block.type)}`)
+    }
+  }
+  if (!result.some(part => part.type !== 'text' || part.text.trim())) throw new Error('旧聊天用户输入为空，无法重放。')
