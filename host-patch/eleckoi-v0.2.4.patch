+      assert.equal(trial.variants[0].turns.length, 1)
+      assert.equal(modelRequests.length, requestsBeforeRetry, 'Unknown cancelled-request usage must block dispatch on retry.')
+    } else if (checkpointRetry) {
+      trial = await waitForTrial(team, started.trialId)
+      assert.equal(trial.status, 'failed')
+      assert.equal(trial.variants[0].turns.length, 1)
+      assert.equal(trial.usage.reportedTokensKnown, true)
+      assert.equal(modelRequests.length, 4)
+      const firstRunId = trial.variants[0].turns[0].runId
+      await team.retryTrial({ trialId: started.trialId, operationId: randomUUID() })
+      trial = await waitForTrial(team, started.trialId)
+      assert.equal(trial.status, 'complete', trial.failure)
+      assert.equal(trial.variants[0].turns[0].runId, firstRunId, 'Retry reran the committed checkpoint.')
+      assert.equal(modelRequests.length, 7, 'Only the unfinished second turn should be rerun.')
+    } else if (hardInterruption) {
+      await Promise.race([blockedCall, timeout(120_000, 'The native worker did not reach the turn-2 model request.')])
+      await new Promise(resolveSleep => setTimeout(resolveSleep, 1500))
+      const marker = findWorkerMarker(started.trialId)
+      assert.ok(marker?.pid, 'The isolated trial worker PID marker is missing.')
+      execFileSync('taskkill.exe', ['/PID', String(marker.pid), '/F'], { stdio: 'ignore' })
+      trial = await waitForTrial(team, started.trialId)
+      assert.equal(trial.status, 'interrupted', `Expected hard worker exit, got ${trial.status}.`)
+      assert.equal(trial.variants[0].turns.length, 1, 'Hard interruption must preserve the committed turn-1 checkpoint.')
+      assert.ok(trial.usage.requests >= 4, `Recovered request count omitted the interrupted call: ${trial.usage.requests}`)
+      assert.equal(trial.usage.reportedTokensKnown, false, 'A reserved request killed before usage must remain unknown.')
+      const attempt = trial.variants[0].attempts.at(-1)
+      assert.equal(attempt?.status, 'interrupted')
+      assert.ok(attempt?.trajectory?.available, 'The interrupted attempt must retain a trajectory entry.')
+      const trajectory = await team.getTrialTrajectory({ trialId: started.trialId, variantId: 'candidate-a', runId: attempt.runId ?? attempt.attemptId })
+      assert.ok(trajectory.native.visibleTurns.includes(2), 'Recovered native trajectory omitted the interrupted turn.')
+      const requestsBeforeRetry = modelRequests.length
+      const usageBeforeRetry = trial.usage.requests
+      const retried = await team.retryTrial({ trialId: started.trialId, operationId: randomUUID() })
+      assert.equal(retried.status, 'queued')
+      trial = await waitForTrial(team, started.trialId)
+      assert.equal(trial.status, 'failed')
+      assert.equal(trial.failureCode, 'RP_TEAM_TRIAL_BUDGET_USAGE_UNAVAILABLE')
