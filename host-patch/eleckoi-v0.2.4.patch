+
+function contextPacketFromSession(inspection) {
+  const marker = 'Filtered context packet:\n\n'
+  const prompt = inspection.events
+    .filter(event => event.type === 'agent/inbox/spliced')
+    .flatMap(event => event.data?.inserted ?? [])
+    .flatMap(message => message.content ?? [])
+    .map(part => part?.text)
+    .find(text => typeof text === 'string' && text.includes(marker))
+  assert.ok(prompt, `Child Session ${inspection.id} had no filtered RP Team context packet`)
+  const start = prompt.indexOf(marker) + marker.length
+  const end = prompt.indexOf('\n\nCall rp_team_submit_internal', start)
+  return JSON.parse(prompt.slice(start, end < 0 ? undefined : end))
+}
