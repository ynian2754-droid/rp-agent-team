@@ -0,0 +1,170 @@
+/** Host-owned lifecycle for Runtime extensions and their per-Agent hooks. */
+export function installRuntimeExtensionRegistry(ctx, prepareAgent) {
+  const extensions = new Map()
+  const setups = new Map()
+  const pendingSetups = new Map()
+  let disposed = false
+
+  const service = {
+    recordLocalDelivery({ sessionId, requestSeq, provider, model }) {
+      const id = String(sessionId ?? '')
+      if (!id || !Number.isSafeInteger(requestSeq) || requestSeq < 0
+        || typeof provider !== 'string' || !provider
+        || typeof model !== 'string' || !model) {
+        throw new Error('本地交付路由标记参数无效。')
+      }
+      const session = ctx.sessions.get(id)
+      if (!session) throw new Error(`找不到本地交付 Session ${id}。`)
+      const events = session.snapshotEvents()
+      const header = events.find(event => event.seq === requestSeq && event.type === 'request/header')
+      const route = header?.data?.header?.config
+      if (!route || route.provider !== provider || route.model !== model) {
+        throw new Error('本地交付路由标记与正式 request/header 不匹配。')
+      }
+      const existing = events.find(event => event.type === 'eleckoi/local-delivery'
+        && event.data?.requestSeq === requestSeq)
+      if (existing) {
+        if (existing.data.provider !== provider || existing.data.model !== model) {
+          throw new Error('同一 request/header 不能绑定到不同的本地交付路由。')
+        }
+        return { recorded: true }
+      }
+      session.append('eleckoi/local-delivery', { requestSeq, provider, model }, { ignorable: true })
+      return { recorded: true }
+    },
+
+    register(extension) {
+      if (disposed) throw new Error('ElecKoi Runtime extension registry is disposed.')
+      if (!extension || typeof extension.id !== 'string' || !extension.id
+        || typeof extension.resolveSnapshot !== 'function'
+        || typeof extension.setupAgent !== 'function'
+        || (extension.resolveChildOptions !== undefined && typeof extension.resolveChildOptions !== 'function')
+        || (extension.prepareConversationRestore !== undefined && typeof extension.prepareConversationRestore !== 'function')) {
+        throw new Error('Runtime extension must have an id, resolveSnapshot and setupAgent.')
+      }
+      if (extensions.has(extension.id)) throw new Error(`Runtime extension already registered: ${extension.id}`)
+      extensions.set(extension.id, extension)
+      const agents = ctx.agents.list()
+      const byId = new Map(agents.map(agent => [String(agent.id), agent]))
+      const depth = agent => {
+        let count = 0
+        let parentId = agent.session?.header?.parentSession
+        while (parentId && byId.has(String(parentId)) && count < agents.length) {
+          count++
+          parentId = byId.get(String(parentId)).session?.header?.parentSession
+        }
+        return count
+      }
+      const ready = (async () => {
+        for (const agent of agents.sort((left, right) => depth(left) - depth(right))) {
+          await prepareAgent(agent, extension)
+        }
+      })()
+      const unregister = async () => {
+        if (extensions.get(extension.id) !== extension) return
+        extensions.delete(extension.id)
+        for (const [key, dispose] of [...setups]) {
+          if (!key.startsWith(`${extension.id}\0`)) continue
+          setups.delete(key)
+          await dispose?.()
+        }
+      }
+      unregister.ready = ready
+      return unregister
+    },
+
+    async resolveSnapshot(input) {
+      const overlay = {}
+      for (const extension of extensions.values()) {
+        const next = await extension.resolveSnapshot({ ...input, snapshot: { ...input.snapshot, ...overlay } })
+        if (next && typeof next === 'object') Object.assign(overlay, next)
+      }
+      return overlay
+    },
+
+    async setupAgent(input) {
+      const sessionId = String(input.sessionId)
+      const installed = []
+      try {
+        for (const extension of extensions.values()) {
+          const key = `${extension.id}\0${sessionId}`
+          if (setups.has(key)) continue
+          const existing = pendingSetups.get(key)
+          if (existing) { await existing; continue }
+          const pending = Promise.resolve(extension.setupAgent(input)).then(dispose => {
+            const cleanup = typeof dispose === 'function' ? dispose : undefined
+            if (extensions.get(extension.id) === extension) setups.set(key, cleanup)
+            else return cleanup?.()
+          })
+          pendingSetups.set(key, pending)
+          try {
+            await pending
+            if (setups.has(key)) installed.push(key)
+          } finally { pendingSetups.delete(key) }
+        }
+      } catch (error) {
+        for (const key of installed.reverse()) {
+          const dispose = setups.get(key)
+          setups.delete(key)
+          await dispose?.()
+        }
+        throw error
+      }
+    },
+
+    async resolveChildOptions(input) {
+      let options
+      for (const extension of extensions.values()) {
+        if (typeof extension.resolveChildOptions !== 'function') continue
+        const next = await extension.resolveChildOptions(input)
+        if (next && typeof next === 'object' && !Array.isArray(next)) {
+          options = { ...options, ...next }
+        }
+      }
+      return options
+    },
+
+    async prepareConversationRestore(input) {
+      const prepared = []
+      try {
+        for (const extension of extensions.values()) {
+          if (typeof extension.prepareConversationRestore !== 'function') continue
+          const restore = await extension.prepareConversationRestore(input)
+          if (restore) prepared.push(restore)
+        }
+      } catch (error) {
+        for (const restore of prepared.reverse()) await restore.rollback()
+        throw error
+      }
+      return {
+        async apply() {
+          for (const restore of prepared) await restore.apply()
+        },
+        async rollback() {
+          for (const restore of [...prepared].reverse()) await restore.rollback()
+        }
+      }
+    },
+
+    async disposeAgent(sessionId) {
+      const suffix = `\0${String(sessionId)}`
+      for (const [key, dispose] of [...setups]) {
+        if (!key.endsWith(suffix)) continue
+        setups.delete(key)
+        await dispose?.()
+      }
+    },
+
+    async dispose() {
+      if (disposed) return
+      disposed = true
+      for (const dispose of [...setups.values()].reverse()) await dispose?.()
+      setups.clear()
+      pendingSetups.clear()
+      extensions.clear()
+    }
+  }
+
+  ctx.provide('eleckoiRuntimeExtensions', service)
+  return service
+}
