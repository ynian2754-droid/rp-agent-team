+function conversationBusy() {
+  return workError('ELECKOI_CONVERSATION_BUSY', '当前聊天正在生成、执行 Team 或进行作者编辑。')
+}
+
+function requiredWorkText(value, label) {
+  if (typeof value !== 'string' || !value.trim()) throw workError('ELECKOI_CONVERSATION_WORK_INVALID', `${label} is required`)
