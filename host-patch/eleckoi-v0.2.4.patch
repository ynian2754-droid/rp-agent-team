diff --git a/scripts/install-rp-team-bundle.mjs b/scripts/install-rp-team-bundle.mjs
new file mode 100644
index 0000000..ed963de
--- /dev/null
+++ b/scripts/install-rp-team-bundle.mjs
@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict'
+import { gunzipSync } from 'node:zlib'
+import { createRequire } from 'node:module'
+import { existsSync, readFileSync, writeFileSync, mkdirSync, cpSync, realpathSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { dirname, join, resolve, delimiter } from 'node:path'
+import { loadLayeredEnv, loadProfileDirectory } from '@deepseek-ai/dsh-app-boot'
+import { runProfile } from '@deepseek-ai/dsh/profile-boot'
+import { ELECKOI_INSTALL_ANCHOR, registerDesktopBundles } from '@eleckoi/dsh-runtime'
+
+// Run through Electron's Node mode, with the desktop closed. No generation is invoked.
+const [userDataArg, bundleArg] = process.argv.slice(2)
+assert.ok(userDataArg && bundleArg, 'Usage: install-rp-team-bundle.mjs <userData> <bundle.tgz>')
+const root = resolve(userDataArg), bundle = resolve(bundleArg)
+const verifyFixture = process.argv.includes('--verify-fixture-associations')
+const fixtureLog = join(root, 'rp-team-v024-fixture-model.jsonl')
+const priorFixtureLog = verifyFixture ? readFileSync(fixtureLog, 'utf8') : undefined
+const host = resolve(import.meta.dirname, '..'), runtime = join(root, 'dsh-runtime')
+const home = join(runtime, 'home'), profile = join(home, 'profiles', 'desktop')
+assert.ok(existsSync(join(profile, 'package.json')) && existsSync(bundle))
+const backup = join(root, 'rp-team-upgrade-backups', new Date().toISOString().replaceAll(':', '-'))
+mkdirSync(backup, { recursive: true })
+for (const name of ['package.json', 'pnpm-lock.yaml', 'bundles.json']) {
+  const path = join(profile, name); if (existsSync(path)) cpSync(path, join(backup, name))
+}
+const archive = gunzipSync(readFileSync(bundle))
+let bundleManifest
+for (let offset = 0; offset < archive.length; ) {
+  const header = archive.subarray(offset, offset + 512)
+  const name = header.subarray(0, 100).toString().replace(/\0.*$/, '')
+  const size = parseInt(header.subarray(124, 136).toString().replace(/\0.*$/, '').trim(), 8) || 0
+  if (name === 'package/package.json') { bundleManifest = JSON.parse(archive.subarray(offset + 512, offset + 512 + size).toString()); break }
+  offset += 512 + Math.ceil(size / 512) * 512
+}
+assert.ok(bundleManifest, 'Bundle package.json missing')
+assert.equal(bundleManifest.name, '@rp-team/dsh-roleplay-team')
+const bundleVersion = bundleManifest.version
+const bundleSha = createHash('sha256').update(readFileSync(bundle)).digest('hex')
+const bundleStore = join(root, 'installed-plugin-bundles')
+mkdirSync(bundleStore, { recursive: true })
+const immutableBundle = join(bundleStore, `rp-team-${bundleVersion}-${bundleSha.slice(0, 12)}.tgz`)
+if (!existsSync(immutableBundle)) cpSync(bundle, immutableBundle)
+const installed = join(profile, 'node_modules', '@rp-team', 'dsh-roleplay-team')
+if (existsSync(installed)) cpSync(realpathSync(installed), join(backup, 'old-installed-package'), { recursive: true })
+const environment = { ...loadLayeredEnv('dsh'), DSH_HOME: home, DSH_SESSION_ROOT: join(runtime, 'sessions'),
+  DSH_CWD: join(root, 'workspace'), ELECKOI_DATABASE_PATH: join(root, 'eleckoi-common.sqlite3'),
+  ELECKOI_MEDIA_ROOT: join(root, 'media'), ELECKOI_WORKSPACE_ROOT: join(root, 'workspace'),
+  ELECKOI_SESSION_SNAPSHOT_ROOT: join(runtime, 'session-snapshots'), ELECKOI_PRESET_ROOT: join(runtime, 'generated-presets'),
+  ELECKOI_SESSION_BRIDGE_ROOT: join(runtime, 'session-bridges'),
+  ELECKOI_PRESET_TEMPLATE_PATH: join(host, 'resources/dsh/agent-preset-template/agent.cordis.yml'),
+  RP_TEAM_V024_FIXTURE_LOG: join(root, 'rp-team-v024-fixture-model.jsonl'), DSH_TELEMETRY_DISABLED: '1' }
+Object.assign(process.env, environment)
+registerDesktopBundles(profile)
+const require = createRequire(import.meta.url)
+const patches = [join(profile, 'eleckoi-plugin-host.patch.yml'), join(root, 'rp-team-v024-profile.patch.yml'), join(host, 'resources/dsh/desktop-agent.patch.yml')].filter(existsSync)
+const start = () => runProfile({ environment, profile: 'desktop', resolvedProfile: { profile: loadProfileDirectory('dsh', profile, ELECKOI_INSTALL_ANCHOR), installAnchor: ELECKOI_INSTALL_ANCHOR },
+  patchFiles: patches, args: ['--no-open', '--port', '0'], packageManager: { command: process.execPath,
+    args: ['--expose-internals', join(dirname(require.resolve('pnpm')), 'bin/pnpm.mjs')], env: { ...process.env, ELECTRON_RUN_AS_NODE: '1', DSH_DESKTOP_NODE_EXECUTABLE: process.execPath, PATH: `${join(host, 'resources/dsh/node-bin')}${delimiter}${process.env.PATH}` } } })
+let running = await start()
+let shutdownCode = 0
+try {
+  const dependency = JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')).dependencies?.['@rp-team/dsh-roleplay-team'] ?? ''
+  const current = dependency.replace(/^file:/, '').replaceAll('\\', '/').toLowerCase()
+  if (current !== immutableBundle.replaceAll('\\', '/').toLowerCase()) {
+    const result = await running.ctx.pluginManager.installBundle(immutableBundle)
+    assert.ok(['applied', 'restart-required'].includes(result.application), JSON.stringify(result))
+    await running.shutdown.shutdown(0)
+    running = await start()
+  }
+  if (!running.ctx.get('rpAgentTeam')) {
+    const enabled = await running.ctx.pluginManager.setBundleEnabled('@rp-team/dsh-roleplay-team', true)
+    assert.ok(['applied', 'restart-required'].includes(enabled.application), JSON.stringify(enabled))
+    if (enabled.application === 'restart-required') { await running.shutdown.shutdown(0); running = await start() }
+  }
+  assert.ok(running.ctx.get('rpAgentTeam'), 'Updated Team service failed to load')
+  // Product storage opens lazily. Verify the real database upgrade during
+  // installation rather than leaving a migration error for the first UI read.
+  const productData = running.ctx.get('eleckoiProductData')
+  assert.ok(productData, 'Product data service failed to load')
+  productData.readCharacters()
+  let lifecycleChecked = false
+  if (verifyFixture && process.argv.includes('--verify-lifecycle')) {
+    await running.ctx.pluginManager.setBundleEnabled('@rp-team/dsh-roleplay-team', false)
+    await running.shutdown.shutdown(0); running = await start()
+    assert.equal(running.ctx.get('rpAgentTeam'), undefined, 'Disabled Team service retained')
+    await running.ctx.pluginManager.removeBundle('@rp-team/dsh-roleplay-team')
+    await running.shutdown.shutdown(0); running = await start()
+    assert.equal(running.ctx.get('rpAgentTeam'), undefined, 'Removed Team service retained')
+    await running.ctx.pluginManager.installBundle(immutableBundle)
+    await running.shutdown.shutdown(0); running = await start()
+    if (!running.ctx.get('rpAgentTeam')) {
+      await running.ctx.pluginManager.setBundleEnabled('@rp-team/dsh-roleplay-team', true)
+      await running.shutdown.shutdown(0); running = await start()
+    }
+    assert.ok(running.ctx.get('rpAgentTeam'), 'Reinstalled Team failed to load')
+    lifecycleChecked = true
+  }
+  let fixtureAssociationsChecked
+  if (verifyFixture) {
+    const expected = JSON.parse(readFileSync(join(root, 'trajectory-associations.json'), 'utf8'))
+    fixtureAssociationsChecked = 0
+    for (const runId of new Set(expected.map(row => row.runId))) {
+      const seed = expected.find(row => row.runId === runId)
+      let rootSessionId = seed.parentSessionId
+      while (expected.some(row => row.sessionId === rootSessionId)) rootSessionId = expected.find(row => row.sessionId === rootSessionId).parentSessionId
+      const trace = await running.ctx.rpAgentTeam.getTrace({ conversationId: rootSessionId, runId })
+      assert.equal(trace.rootSessionId, rootSessionId)
+      for (const item of expected.filter(row => row.runId === runId)) {
+        assert.ok(trace.executionSessions.some(row => row.sessionId === item.sessionId && row.executionId === item.executionId))
+        const native = await running.ctx.sessionController.inspect(item.sessionId)
+        assert.equal(native.events.filter(event => event.type === 'request/header').length, item.requests)
+        fixtureAssociationsChecked++
+      }
+    }
+    const generationCount = text => text.split('\n').filter(Boolean).map(line => JSON.parse(line)).filter(row => row.provider && row.sessionId && Number.isFinite(row.step)).length
+    assert.equal(generationCount(readFileSync(fixtureLog, 'utf8')), generationCount(priorFixtureLog), 'Installation/inspection unexpectedly generated a model response')
+  }
+  const digest = path => createHash('sha256').update(readFileSync(path)).digest('hex')
+  const manifest = JSON.parse(readFileSync(join(installed, 'package.json'), 'utf8'))
+  assert.equal(manifest.version, bundleVersion)
+  const proof = { fixtureAssociationsChecked, lifecycleChecked, version: manifest.version, backup, bundleSha256: digest(bundle), clientSha256: digest(join(installed, 'dist/client.js')), hostSha256: digest(join(installed, 'dist/host/runtime.mjs')), applied: true }
+  writeFileSync(join(backup, 'installation-proof.json'), JSON.stringify(proof, null, 2))
+  console.log(JSON.stringify(proof, null, 2))
+} catch (error) { shutdownCode = 1; console.error(error); process.exitCode = 1 }
+finally { await running.shutdown.shutdown(shutdownCode) }
+if (shutdownCode) process.exit(1)
