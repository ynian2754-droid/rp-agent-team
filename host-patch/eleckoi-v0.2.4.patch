+    fileUploads: {
+      async uploadStream({ sessionId, data, name }) {
+        if (sessionId !== session.id) throw new Error('wrong upload Session')
+        const chunks = []
+        for await (const chunk of data) chunks.push(Buffer.from(chunk))
+        const bytes = Buffer.concat(chunks)
+        const reference = { attachmentId: `sha256:${hash(bytes)}`, name, bytes: bytes.byteLength }
+        files.set(reference.attachmentId, bytes)
+        const receiptId = `receipt-${receipts.size + 1}`
+        receipts.set(receiptId, reference)
+        return { receiptId, file: reference }
+      }
+    },
+    llm: {
+      registerAdapter(_providers, value) {
+        adapter = value
+        return () => { adapter = undefined }
+      }
+    },
+    settings: { describe: () => [] },
+    eleckoiRuntimeExtensions: {
+      recordLocalDelivery({ sessionId, requestSeq, provider, model }) {
+        if (sessionId !== session.id) throw new Error('wrong marker Session')
+        const header = session.events.find(event => event.seq === requestSeq && event.type === 'request/header')
+        if (header?.data?.header?.config?.provider !== provider || header.data.header.config.model !== model) {
+          throw new Error('marker route mismatch')
+        }
+        session.append('eleckoi/local-delivery', { requestSeq, provider, model }, { ignorable: true })
+        return { recorded: true }
+      }
+    },
+    provide(name, value) { this[name] = value },
+    on(name, listener, options) {
+      if (name === 'session/event') {
+        eventListeners.add(listener)
+        return () => eventListeners.delete(listener)
+      }
+      if (name === 'llm/stream') {
+        listeners.set(name, { listener, options })
+        return () => listeners.delete(name)
+      }
+      throw new Error(`Unexpected event ${name}`)
+    }
+  }
+  return {
+    ctx, product, session, importedRuns, mapPath,
+    get teamConfig() { return structuredClone(teamConfig) },
+    promptCount: () => promptCount,
+    flushCount: () => flushCount,
+    localModelRequests: () => localModelRequests,
+    foreignRoutesBlocked: () => foreignRoutesBlocked
+  }
+}
+
+function historicalTurn({ visibleId, oldSessionId, content, response }) {
+  return {
+    kind: 'user',
+    visibleId,
+    sourceTurnId: visibleId,
+    createdAt: '2021-04-03T12:13:14.000Z',
+    runtimeThreadId: oldSessionId,
+    dshTurn: 7,
+    userMessages: [{ messageId: `source-${visibleId}`, eventSeq: 2, content }],
+    content,
+    responses: response ? [{ ...response, kind: 'assistant', createdAt: '2021-04-03T12:15:14.000Z' }] : []
+  }
+}
+
+function hash(bytes) {
+  return createHash('sha256').update(bytes).digest('hex')
+}
