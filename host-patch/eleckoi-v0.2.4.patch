+function bridgeSettingFiles(library) {
+  if (!library) return {}
+  return Object.fromEntries(library.entries.map(entry => [settingPath(library, entry), String(entry.content ?? '')]))
+}
+
+function variableBridge(context, state) {
+  return context === undefined
+    ? { enabled: false, config: null, state }
+    : {
+        enabled: true,
+        config: {
+          initialState: parseObject(context.initialStateJson, '变量初始状态'),
+          schemaCode: context.schemaCode,
+          objects: context.objects,
+          variables: context.variables
+        },
+        state
+      }
+}
+
+function settingBridge(context, library, snapshot) {
+  let existing = {}
+  try {
+    if (snapshot?.settingStateFile && existsSync(snapshot.settingStateFile)) {
+      existing = JSON.parse(readFileSync(snapshot.settingStateFile, 'utf8'))
+    }
+  } catch { existing = {} }
+  return {
+    enabled: library !== null,
+    library,
+    frozenLibrary: library,
+    history: Array.isArray(existing.history)
+      ? existing.history
+      : [...(context.history ?? []), ...(context.currentPromptText ? [{ role: 'user', content: context.currentPromptText }] : [])]
+  }
+}
+
+async function findCommittedAssistant(sessionController, sessionId, turn, expectedBody) {
+  const inspection = await sessionController.inspect(sessionId)
+  return findPublicationEvent(inspection.events ?? [], turn, expectedBody)
+}
+
+function publicationStepEnded(events, turn) {
+  const lastStep = events.filter(event => event.type === 'step/start' && event.data?.turn === turn).at(-1)
+  return Boolean(lastStep && events.some(event => event.type === 'step/end' && event.data?.turn === turn
+    && event.data?.step === lastStep.data.step && event.seq > lastStep.seq))
+}
+
+function findPublicationEvent(events, turn, expectedBody) {
+  const starts = events.filter(event => event.type === 'turn/start' && event.data?.turn === turn)
+  const ends = events.filter(event => event.type === 'turn/end' && event.data?.turn === turn)
+  if (starts.length !== 1 || (ends.length > 1) || (ends.length === 1 && ends[0].data?.reason?.kind !== 'completed')) {
+    throw new Error('稳定 Session 中没有唯一、有效的目标轮次。')
+  }
+  const start = starts[0]
+  // AgentLoop awaits turn-stopping after step/end and appends turn/end only
+  // after the awaited listener returns. Anchor the receipt to that exact final
+  // step so an older repeated body cannot be mistaken for this publication.
+  const turnBound = ends[0]?.seq ?? events.find(event => event.type === 'turn/start' && event.seq > start.seq)?.seq ?? Infinity
+  const stepStarts = events.filter(event => event.type === 'step/start' && event.data?.turn === turn
+    && event.seq > start.seq && event.seq < turnBound)
+  const lastStep = stepStarts.at(-1)
+  if (!lastStep) throw new Error('稳定 Session 中缺少目标轮次的最终 step。')
+  const stepEnds = events.filter(event => event.type === 'step/end' && event.data?.turn === turn
+    && event.data?.step === lastStep.data?.step && event.seq > lastStep.seq && event.seq < turnBound)
+  if (stepEnds.length !== 1) throw new Error('稳定 Session 中没有唯一完成的最终 step。')
+  const turnAssistants = events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === turn && event.seq > start.seq && event.seq < turnBound)
+  const assistants = events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === turn && event.data?.step === lastStep.data?.step
+    && event.seq > lastStep.seq && event.seq < stepEnds[0].seq)
+  const finalMessage = assistants[0]?.data?.message
+  const hasToolCalls = Array.isArray(finalMessage?.content)
+    && finalMessage.content.some(part => part?.type === 'tool-call')
+  if (turnAssistants.length !== 1 || assistants.length !== 1 || hasToolCalls
+    || messageText(finalMessage) !== expectedBody.trim()) {
+    throw new Error('稳定 Session 最终 step 中没有唯一匹配的 assistant 正文。')
+  }
+  return assistants[0]
+}
+
+function messageText(message) {
+  if (!message || message.role !== 'assistant' || !Array.isArray(message.content)) return ''
+  return message.content.filter(block => block?.type === 'text').map(block => String(block.text ?? '')).join('').trim()
+}
+
+function parseObject(value, label) {
+  const parsed = typeof value === 'string' ? JSON.parse(value || '{}') : value
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error(`${label}必须是 JSON object。`)
+  return structuredClone(parsed)
+}
+
+function safeSegment(value) {
+  return String(value ?? '').trim().replace(/[\\/:*?"<>|]/gu, '_').replace(/[\u0000-\u001f]/gu, '').replace(/^[. ]+|[. ]+$/gu, '')
+}
+
+function hash(value) {
+  return createHash('sha256').update(stableJson(value)).digest('hex')
+}
+
+function stableJson(value) {
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`
+  if (value && typeof value === 'object') return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${stableJson(value[key])}`).join(',')}}`
+  return JSON.stringify(value)
+}
+
+function committedReceipt(staged) {
+  return {
+    outcome: 'committed', sessionId: staged.sessionId, turn: staged.turn,
+    assistantSeq: staged.assistantSeq, assistantMessageId: staged.assistantMessageId,
+    productMessageId: staged.productMessageId
+  }
+}
