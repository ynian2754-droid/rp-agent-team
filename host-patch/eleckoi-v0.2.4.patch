+  return { runs: [run], executions: ['a', 'b'].map((sessionId, index) => ({ runId: 'run', loading: false,
+    association: { executionId: `run:${index ? 'actor' : 'attention'}:1`, sessionId, agentId: index ? 'actor' : 'attention',
