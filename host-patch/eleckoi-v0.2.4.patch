+
+async function disableTeamForReplay(ctx, conversationId) {
+  const runtime = ctx.rpAgentTeam
+  if (typeof runtime?.getConfig !== 'function' || typeof runtime?.saveConfig !== 'function') return async () => {}
+  const original = await runtime.getConfig({ conversationId })
+  let disabledRevision = original.revision
+  if (original.enabled) {
+    const disabled = await runtime.saveConfig({
+      conversationId,
+      expectedRevision: original.revision,
+      enabled: false,
+      config: original.config
+    })
+    disabledRevision = disabled.revision
+  }
+  return async () => {
+    if (!original.enabled) return
+    const current = await runtime.getConfig({ conversationId })
+    if (current.revision !== disabledRevision || current.enabled) return
+    await runtime.saveConfig({
+      conversationId,
+      expectedRevision: current.revision,
+      enabled: true,
+      config: current.config
+    })
+  }
