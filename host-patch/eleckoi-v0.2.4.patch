+async function install(manager, packagePath, packageName = JSON.parse(readFileSync(join(packagePath, 'package.json'), 'utf8')).name) {
+  const current = (await manager.listBundles()).find(bundle => bundle.name === packageName)
+  if (current?.installed) {
+    if (!current.enabled) {
+      const enabled = await manager.setBundleEnabled(packageName, true)
+      assert.equal(enabled.application, 'applied', `Could not enable ${packageName}: ${JSON.stringify(enabled)}`)
+    }
+    return packageName
