+async function prepareClientFixture(ctx, manager, teamInstallPath, fixturePackagePath, fixtureBundle) {
+  await install(manager, fixturePackagePath)
+  await install(manager, teamInstallPath, TEAM_BUNDLE_NAME)
+  const team = ctx.rpAgentTeam
+  assert.ok(team && typeof team.getConfig === 'function', 'Reinstalled RP Team Remote is not mounted')
+  const characterId = `rp-team-v024-ui-${randomUUID()}`
+  ctx.eleckoiCharactersApi.create({ id: characterId, name: 'RP Team Electron UI Fixture', primaryOpening: '' })
+  const details = await ctx.eleckoiConversationsApi.create({
+    title: 'RP Team Electron UI Fixture', metadata: { characterId, characterName: 'RP Team Electron UI Fixture' }
+  })
+  const conversationId = details.conversation.id
+  const sessionId = details.runtimeSessionId
+  await ctx.eleckoiConversationModelsApi.select(conversationId, { provider: FIXTURE_PROVIDER, model: 'observer', reasoningEffort: 'high' })
+  const saved = await team.getConfig({ conversationId })
+  const config = structuredClone(saved.config)
+  for (const agent of config.agents) {
+    if (agent.id === config.output.agentId) agent.modelRef = { provider: FIXTURE_PROVIDER, model: 'actor' }
+    else agent.modelRef = 'inherit'
+  }
+  await team.saveConfig({ conversationId, expectedRevision: saved.revision, enabled: true, config })
+  return { conversationId, sessionId, fixtureBundle }
+}
