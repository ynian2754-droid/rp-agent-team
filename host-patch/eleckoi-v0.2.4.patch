+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue }
+
+export type WorldOperation =
+  | { kind: 'variables'; op: 'add' | 'replace'; path: string; value: JsonValue }
+  | { kind: 'variables'; op: 'remove'; path: string }
+  | { kind: 'settings'; op: 'write_file'; path: string; content: string }
+
+export interface StoryStateSnapshot {
+  variables: Record<string, JsonValue>
+  settings: Record<string, string>
+  baseHash: string
+}
+
+export interface ProductCommitReceipt {
+  outcome: 'committed'
+  sessionId: string
+  turn: number
+  assistantSeq: number
+  assistantMessageId: string
+  productMessageId: string
+}
+
+export interface StoryStateService {
+  snapshot(input: { conversationId: string }): Promise<StoryStateSnapshot>
+  prepare(snapshot: StoryStateSnapshot, operations: WorldOperation[], input: {
+    conversationId: string
+    runId: string
+    baseHash: string
+  }): Promise<{ variableBridge: Record<string, JsonValue>; settingBridge: Record<string, JsonValue> }>
+  stageProductCommit(input: {
+    conversationId: string
+    runId: string
+    sessionId: string
+    turn: number
+    baseHash: string
+    operations: WorldOperation[]
