+        if (JSON.stringify(packet).includes('PRIORITY_MEMORY_READY')) throw new Error('Actor received another member’s unshared message')
+        if (!JSON.stringify(packet.agent_messages).includes('PRIORITY_PERCEPTION_READY')) throw new Error('Actor ran before perception')
+        const revised = packet.drafts?.some(draft => draft.draftId === 'priority-private' && draft.text === 'PRIORITY_PRIVATE_DRAFT')
+        if (step === 0 && !revised) {
+          yield* emitCalls([
+            { name: 'rp_team_save_draft', args: { draftId: 'priority-private', text: 'PRIORITY_PRIVATE_DRAFT', visibleTo: ['agent-4'] } },
+            { name: 'rp_team_request', args: { to: 'agent-4', body: 'Revise using your private draft', reason: 'Own draft round trip' } }
+          ])
+          return
+        }
+        if (step === 0 && revised) {
+          yield* emitCalls([{ name: 'rp_team_publish', args: { body: 'PRIORITY_PUBLICATION', selectedDraftIds: ['priority-private'] } }])
+          return
+        }
+      }
+      const text = 'Priority fixture member completed.'
+      yield { type: 'block-start', index: 0, blockType: 'text' }
+      yield { type: 'text-delta', index: 0, text }
+      yield { type: 'block-end', index: 0, block: { type: 'text', text } }
+      yield { type: 'finish', reason: { kind: 'stop' } }
+      return
+    }
+
+    if (options.model === 'actor' && promptText.includes('V024_RETRY_FIXTURE') && !globalThis.rpTeamV024RetryFailureUsed) {
+      globalThis.rpTeamV024RetryFailureUsed = true
+      appendFileSync(logPath, JSON.stringify({ fixture: 'intentional-failure', sessionId, model: options.model }) + '\\n')
+      throw new Error('V024_INTENTIONAL_ACTOR_FAILURE')
+    }
+
+    if (options.model === 'actor' && promptText.includes('V024_CANCEL_FIXTURE') && !globalThis.rpTeamV024CancelWaitUsed) {
+      globalThis.rpTeamV024CancelWaitUsed = true
+      appendFileSync(logPath, JSON.stringify({ fixture: 'cancel-waiting', sessionId }) + '\\n')
+      await new Promise((resolve, reject) => {
+        const signal = options.signal
+        if (!signal) return reject(new Error('Fixture cancellation request had no AbortSignal'))
+        const abort = () => reject(new Error('V024_FIXTURE_ABORTED'))
+        if (signal.aborted) abort()
+        else signal.addEventListener('abort', abort, { once: true })
+      })
+    }
+
+    if (options.model === 'actor' && promptText.includes('V024_DISABLE_FIXTURE') && !globalThis.rpTeamV024DisableWaitUsed) {
+      globalThis.rpTeamV024DisableWaitUsed = true
+      appendFileSync(logPath, JSON.stringify({ fixture: 'disable-waiting', sessionId }) + '\\n')
+      await new Promise((resolve, reject) => {
+        const signal = options.signal
+        if (!signal) return reject(new Error('Fixture disable request had no AbortSignal'))
+        const abort = () => reject(new Error('V024_FIXTURE_DISABLED'))
+        if (signal.aborted) abort()
+        else signal.addEventListener('abort', abort, { once: true })
