+    productData: ctx.eleckoiProductData,
+    roleplaySessions: ctx.eleckoiRoleplaySessions,
+    sessionController: ctx.sessionController,
+    sessions: ctx.sessions,
+    llm: ctx.llm,
+    attachments: ctx.attachments,
+    fileUploads: ctx.fileUploads
+  })) {
+    if (!value) throw new Error(`旧聊天迁移服务尚未就绪：${name}`)
+  }
+  if (typeof ctx.eleckoiRoleplaySessions.create !== 'function'
+    || typeof ctx.eleckoiRoleplaySessions.preparePrompt !== 'function'
+    || typeof ctx.eleckoiProductData.rebindLegacyConversation !== 'function') {
+    throw new Error('旧聊天迁移接口尚未就绪。')
+  }
