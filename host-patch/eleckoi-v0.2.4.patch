+        yield* emitCalls([
+          { name: 'rp_team_read_state', args: { namespace: 'world', path: '/variables/fixture/teamFixture' } },
+          { name: 'eleckoi_glob_variables', args: { pattern: '**' } },
+          { name: 'eleckoi_glob_setting_files', args: { pattern: '**' } }
+        ])
+        return
+      }
+      if (step === 1) {
+        for (const name of ['rp_team_write_state', 'eleckoi_apply_variable_patch', 'eleckoi_read_setting_files']) {
+          if (!tools.includes(name)) throw new Error('Observer did not receive ' + name)
+        }
+        yield* emitCalls([
+          { name: 'rp_team_write_state', args: { namespace: 'shared', path: '/observer', value: 'observer-shared', expectedVersion: 0 } },
+          { name: 'rp_team_write_state', args: { namespace: 'private:agent-1', path: '/note', value: 'observer-private', expectedVersion: 0 } },
+          { name: 'eleckoi_apply_variable_patch', args: { operations: [
