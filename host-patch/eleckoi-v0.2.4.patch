+    settingsNs: 'llm-pi-ai',
+    settingsPath: ['providers', 'local'],
+    settingsValue: { api: 'openai-completions', baseURL: 'http://127.0.0.1:1234/v1', apiKeyEnv: 'LOCAL_FIXTURE_KEY' },
