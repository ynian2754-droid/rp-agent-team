+async function waitForTurnEnd(ctx, sessionId, previousEndCount, afterSeq, timeoutMs = 90_000) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    const inspection = await ctx.sessionController.inspect(sessionId)
+    const ends = inspection.events.filter(event => event.type === 'turn/end')
+    const event = ends.find(item => item.seq > afterSeq)
+    if (ends.length > previousEndCount && event) return { inspection, event }
+    await new Promise(resolve => setTimeout(resolve, 100))
+  }
+  throw new Error(`Timed out waiting for official Session ${sessionId} turn/end`)
+}
