+    assert.deepEqual(await running.ctx.eleckoiTrialSnapshots.captureModelProviders({ providerIds: [modelProvider] }).then(routes => routes.map(row => row.provider)), [modelProvider])
+    writeFileSync(join(userDataRoot, 'trial-native-evidence.json'), JSON.stringify({
+      trialId: started.trialId, sourceConversationId: conversationId, status: trial.status,
+      variants: trial.variants.map(variant => ({ id: variant.id, turns: variant.turns.map(turn => ({
