+async function promptOfficialTurn(ctx, conversationId, sessionId, text) {
+  const before = await ctx.sessionController.inspect(sessionId)
+  const prepared = await ctx.eleckoiConversationsApi.preparePrompt(conversationId, text)
+  assert.equal(prepared.runtimeSessionId, sessionId, 'Continuation changed the stable Session id')
+  const afterSeq = before.events.at(-1)?.seq ?? -1
+  const previousEndCount = before.events.filter(event => event.type === 'turn/end').length
+  await ctx.sessionController.prompt({
+    sessionId,
+    requestId: `rp-team-migrated-history-${randomUUID()}`,
+    mode: 'queue',
+    content: [{ type: 'text', text }]
+  }, AbortSignal.timeout(90_000))
+  const completed = await waitForTurnEnd(ctx, sessionId, previousEndCount, afterSeq)
+  assert.equal(completed.event.data?.reason?.kind, 'completed',
+    `Official turn failed: ${JSON.stringify(completed.event.data?.reason)}`)
+  return completed
+}
