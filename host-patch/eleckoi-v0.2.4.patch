+import assert from 'node:assert/strict'
+import { existsSync, readFileSync } from 'node:fs'
+
+/** Insert into the local fixture adapter after AUTHOR_ADAPTER_STEPS. */
+export const V040_ADAPTER_STEPS = String.raw`
+    if (options.purpose === 'compaction') {
+      const text = 'Local compression summary: preserve the author input and completed tool result.';
+      yield {type:'block-start',index:0,blockType:'text'};
+      yield {type:'text-delta',index:0,text};
+      yield {type:'block-end',index:0,block:{type:'text',text}};
+      yield {type:'usage',usage:{inputTokens:7,outputTokens:3,totalTokens:10}};
+      yield {type:'finish',reason:{kind:'stop'}}; return;
+    }
+    if (promptText.includes('V040_COMPACTION')) {
+      globalThis.rpTeamV040CompressionProbes ??= new Set();
+      if (!globalThis.rpTeamV040CompressionProbes.has(sessionId)) {
+        globalThis.rpTeamV040CompressionProbes.add(sessionId);
+        yield* emitCalls([{name:'rp_team_read_state',args:{namespace:'shared',path:'/compression-probe'}}]); return;
+      }
+      yield* emitCalls([{name:'rp_team_publish',args:{body:'V040_COMPACTION_PUBLICATION',selectedDraftIds:[]}}]); return;
+    }
+    if (promptText.includes('V040_DEADLINE')) {
+      await new Promise((resolve,reject) => {
+        const signal = options.signal;
+        if (signal.aborted) reject(signal.reason);
+        else signal.addEventListener('abort',() => reject(signal.reason),{once:true});
+      }); return;
+    }
+    if (promptText.includes('V040_ONE_REQUEST')) {
+      yield* emitCalls([{name:'rp_team_publish',args:{body:'V040_ONE_REQUEST_PUBLICATION',selectedDraftIds:[]}}]); return;
+    }
+    if (promptText.includes('V040_BUDGET_CONCURRENCY')) {
+      const text = 'Budget concurrency fixture member completed.';
+      yield {type:'block-start',index:0,blockType:'text'};
+      yield {type:'text-delta',index:0,text};
+      yield {type:'block-end',index:0,block:{type:'text',text}};
+      yield {type:'finish',reason:{kind:'stop'}}; return;
+    }
+    if (promptText.includes('V040_TOKEN_MISSING')) {
+      const text = 'Token-usage-missing fixture response.';
+      yield {type:'block-start',index:0,blockType:'text'};
+      yield {type:'text-delta',index:0,text};
+      yield {type:'block-end',index:0,block:{type:'text',text}};
+      yield {type:'finish',reason:{kind:'stop'}}; return;
+    }
+    if (promptText.includes('V040_TOKEN_EXHAUSTED')) {
+      yield {type:'usage',usage:{inputTokens:2,outputTokens:3,totalTokens:5}};
+      yield {type:'finish',reason:{kind:'stop'}}; return;
+    }
+    if (promptText.includes('V040_TRIGGER_DEDUPE') && options.model === 'v040-trigger-dedupe' && step === 0) {
+      yield* emitCalls([{name:'rp_team_publish',args:{body:'V040_TRIGGER_DEDUPE_PUBLICATION',selectedDraftIds:[]}}]); return;
+    }
+    if (promptText.includes('V040_MEMORY_COMMIT') && options.model === 'v040-memory-commit') {
+      if (step === 0) {
+        yield* emitCalls([{name:'rp_team_memory_add',args:{collectionId:'journal',expectedVersion:0,record:{content:'V040 committed memory entry',source:'native fixture'}}}]); return;
+      }
+      if (step === 1) {
+        yield* emitCalls([{name:'rp_team_publish',args:{body:'V040_MEMORY_COMMIT_PUBLICATION',selectedDraftIds:[]}}]); return;
+      }
+    }
+    if (promptText.includes('V040_MEMORY_ROLLBACK') && options.model === 'v040-memory-rollback') {
+      if (step === 0) {
+        yield* emitCalls([{name:'rp_team_memory_add',args:{collectionId:'journal',expectedVersion:0,record:{content:'V040 rolled-back memory entry',source:'native fixture'}}}]); return;
+      }
+      if (step === 1) throw new Error('V040_MEMORY_INTENTIONAL_FAILURE_AFTER_ADD');
+    }
+`
+
+/** Native-only run scenarios. The caller owns fixture startup and adapter registration. */
+export async function runV040Scenarios({
+  ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog
+}) {
+  const results = []
+
+  const compressionConfig=scenarioConfig(baseConfig,'automatic-compaction',{maxRequests:10})
+  const compressionMember=makeMember(compressionConfig,'compression','compression','V040_COMPACTION',true)
+  compressionMember.compaction={autoCompactTokenLimit:1}
+  compressionMember.statePermissions=[{namespace:'shared',path:'/compression-probe',access:'read'}]
+  compressionConfig.agents=[compressionMember]
+  compressionConfig.output={agentId:'compression'}
+  compressionConfig.state={definitions:[{namespace:'shared',path:'/compression-probe',type:'string',default:'Native compactable tool result'}]}
+  const compression=await createScenarioConversation(ctx,team,'Automatic compaction request budget',compressionConfig)
+  const compressionPrompt=await promptOfficialTurn(ctx,compression.sessionId,'V040_COMPACTION: preserve this fixture input after compression.')
+  await compressionPrompt.work
+  await waitForCompletedTurn(ctx,compression.sessionId,compressionPrompt.priorEnds,compressionPrompt.afterSeq)
+  const compressionRun=(await team.getStatus({conversationId:compression.conversationId})).run
+  assert.equal(compressionRun.phase,'complete',compressionRun.failure)
+  const compressionTrace=await team.getTrace({conversationId:compression.conversationId,runId:compressionRun.runId})
+  const compressionSessions=new Set(compressionTrace.executionSessions.map(item=>item.sessionId))
+  const compressionRequests=fixtureRows(fixtureLog).filter(row=>!row.fixture && row.messages && compressionSessions.has(row.sessionId))
+  const compressionCalls=compressionRequests.filter(row=>row.purpose==='compaction')
+  assert.ok(compressionCalls.length>0,'Native automatic compaction must reach the local model adapter')
+  assert.equal(compressionRun.budget.requestCount,compressionRequests.length)
+  assert.equal(compressionRun.budget.reportedTokens,compressionCalls.length*10)
+  const compressionNative=await ctx.sessionController.inspect(compressionTrace.executionSessions[0].sessionId)
+  const compressionEvents=compressionNative.events.filter(event=>event.type.startsWith('compaction/'))
+  assert.ok(compressionEvents.length>0,'Automatic compaction must persist native events')
+  results.push({name:'automatic-compaction',requestCount:compressionRun.budget.requestCount,compactionRequests:compressionCalls.length,reportedTokens:compressionRun.budget.reportedTokens,nativeCompactionEvents:compressionEvents.map(event=>event.type)})
+
+  results.push(await runFailedBudgetScenario({
+    ctx,team,baseConfig,createScenarioConversation,promptOfficialTurn,waitForCompletedTurn,fixtureLog,
+    name:'deadline-cancels-inflight',marker:'V040_DEADLINE',budget:{maxElapsedMs:1000},
+    agents:[{id:'deadline',model:'deadline',prompt:'V040_DEADLINE',output:true}],
+    expectedKind:'maxElapsedMs',expectedRequestCount:1
+  }))
+
+  const concurrency = await runFailedBudgetScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog,
+    name: 'parallel-dispatch', marker: 'V040_BUDGET_CONCURRENCY', budget: { maxRequests: 1 },
+    agents: [
+      { id: 'v040-concurrent-a', model: 'v040-concurrent-a', prompt: 'V040_BUDGET_CONCURRENCY' },
+      { id: 'v040-concurrent-b', model: 'v040-concurrent-b', prompt: 'V040_BUDGET_CONCURRENCY' }
+    ], expectedKind: 'maxRequests', expectedRequestCount: 1
+  })
+  const dispatched = fixtureRows(fixtureLog).filter(row => row.model?.startsWith('v040-concurrent-')
+    && (row.messages ?? []).some(message => message.text?.includes('V040_BUDGET_CONCURRENCY')))
+  assert.ok(dispatched.length <= 1, 'Parallel provider dispatches must stay within the one reserved slot')
+  results.push({ ...concurrency, downstreamDispatches: dispatched.length, maxRequests: 1 })
+
+  const singleConfig = scenarioConfig(baseConfig, 'one-real-request', { maxRequests: 1 })
+  singleConfig.agents = [makeMember(singleConfig, 'one-request', 'one-request', 'V040_ONE_REQUEST', true)]
+  singleConfig.output = { agentId: 'one-request' }
+  const single = await createScenarioConversation(ctx, team, 'One request budget succeeds', singleConfig)
+  const singlePrompt = await promptOfficialTurn(ctx, single.sessionId, 'V040_ONE_REQUEST')
+  await singlePrompt.work
+  await waitForCompletedTurn(ctx, single.sessionId, singlePrompt.priorEnds, singlePrompt.afterSeq)
+  const singleRun = (await team.getStatus({ conversationId: single.conversationId })).run
+  assert.equal(singleRun.phase, 'complete')
+  assert.equal(singleRun.budget.requestCount, 1)
+  assert.equal(fixtureRows(fixtureLog).filter(row => row.model === 'one-request' && row.messages).length, 1)
+  results.push({ name: 'one-request-succeeds', requestCount: 1, phase: singleRun.phase })
+
+  results.push(await runFailedBudgetScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog,
+    name: 'token-usage-missing', marker: 'V040_TOKEN_MISSING', budget: { maxReportedTokens: 100 },
+    agents: [{ id: 'v040-token-missing', model: 'v040-token-missing', prompt: 'V040_TOKEN_MISSING', output: true }],
+    expectedKind: 'usage_unavailable', expectedRequestCount: 1
+  }))
+
+  results.push(await runFailedBudgetScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog,
+    name: 'token-threshold-exact', marker: 'V040_TOKEN_EXHAUSTED', budget: { maxReportedTokens: 5 },
+    agents: [{ id: 'v040-token-exhausted', model: 'v040-token-exhausted', prompt: 'V040_TOKEN_EXHAUSTED', output: true }],
+    expectedKind: 'maxReportedTokens', expectedRequestCount: 1
+  }))
+
+  results.push(await runTriggerDedupeScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog
+  }))
+
+  results.push(await runMemoryScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn,
+    name: 'memory-commit', marker: 'V040_MEMORY_COMMIT', model: 'v040-memory-commit', shouldCommit: true
+  }))
+  results.push(await runMemoryScenario({
+    ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn,
+    name: 'memory-rollback', marker: 'V040_MEMORY_ROLLBACK', model: 'v040-memory-rollback', shouldCommit: false
+  }))
+
+  return results
+}
+
+async function runFailedBudgetScenario(args) {
+  const { ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn,
+    name, marker, budget, agents, expectedKind, expectedRequestCount } = args
+  const config = scenarioConfig(baseConfig, `${name}-${Date.now()}`, budget)
+  config.agents = agents.map(item => makeMember(config, item.id, item.model, item.prompt, item.output === true))
+  config.output = { agentId: agents.find(item => item.output)?.id ?? agents[0].id }
+  for (const item of config.agents) item.outputAuthority.user = item.id === config.output.agentId
+  const scenario = await createScenarioConversation(ctx, team, `RP Team 0.4.0 ${name}`, config)
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId, `${marker}: local native budget check.`)
+  await prompt.work.catch(() => undefined)
+  const completed = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  const run = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(run.phase, 'failed', `${name} did not fail closed: ${JSON.stringify(run)}`)
+  assert.equal(run.publication, null, `${name} left a user publication staged`)
+  assert.equal(run.productCommitStaged, false, `${name} staged a product commit`)
+  assert.equal(run.budget?.failure?.kind, expectedKind, `${name} reported the wrong budget stop`)
+  assert.equal(run.budget?.requestCount, expectedRequestCount)
+  assert.equal(completed.inspection.events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === run.turn).length, 0, `${name} appended a user-facing assistant message`)
+  const receipt = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: run.runId })
+  assert.equal(receipt.outcome, 'unknown', `${name} created a product commit receipt`)
+  return { name, conversationId: scenario.conversationId, runId: run.runId,
+    budget: run.budget, outcome: 'failed_without_publication' }
+}
+
+async function runTriggerDedupeScenario(args) {
+  const { ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn, fixtureLog } = args
+  const config = scenarioConfig(baseConfig, `trigger-dedupe-${Date.now()}`)
+  const output = makeMember(config, 'v040-trigger-output', 'v040-trigger-dedupe', 'V040_TRIGGER_DEDUPE', true)
+  output.triggers = [
+    { type: 'periodic', id: 'periodic-one', every: 1, offset: 0 },
+    { type: 'keyword', id: 'keyword-one', keywords: ['V040_TRIGGER_DEDUPE'] }
+  ]
+  config.agents = [output]
+  config.output = { agentId: output.id }
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team 0.4.0 trigger de-duplication', config)
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId, 'V040_TRIGGER_DEDUPE: one real user input.')
+  await prompt.work
+  const completed = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  const run = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(run.phase, 'complete')
+  assert.equal(run.members[output.id].activations, 1)
+  const trace = await team.getTrace({ conversationId: scenario.conversationId, runId: run.runId })
+  const starts = trace.events.filter(event => event.type === 'activation.started' && event.agentId === output.id)
+  assert.equal(starts.length, 1, 'Matching periodic and keyword triggers queued duplicate activations')
+  assert.deepEqual(starts[0].data.reason.triggers.sort(), ['keyword', 'periodic'])
+  const modelCalls = fixtureRows(fixtureLog).filter(row => row.model === 'v040-trigger-dedupe'
+    && (row.messages ?? []).some(message => message.text?.includes('V040_TRIGGER_DEDUPE')))
+  assert.equal(modelCalls.length, 1, 'One activation made more than one fixture model request')
+  const replies = completed.inspection.events.filter(event => event.type === 'assistant/message' && event.seq > prompt.afterSeq)
+  assert.equal(replies.length, 1)
+  return { name: 'trigger-dedupe', conversationId: scenario.conversationId, runId: run.runId,
+    activations: run.members[output.id].activations, triggers: starts[0].data.reason.triggers }
+}
+
+async function runMemoryScenario(args) {
+  const { ctx, team, baseConfig, createScenarioConversation, promptOfficialTurn, waitForCompletedTurn,
+    name, marker, model, shouldCommit } = args
+  const config = scenarioConfig(baseConfig, `${name}-${Date.now()}`)
+  const output = makeMember(config, 'v040-memory-agent', model, marker, true)
+  output.outputAuthority.state = true
+  output.statePermissions = [{ namespace: 'shared', path: '/memories', access: 'readwrite' }]
+  config.agents = [output]
+  config.output = { agentId: output.id }
+  config.state = { definitions: [{ namespace: 'shared', path: '/memories', type: 'array', default: [] }] }
+  config.memory = { collections: [{ id: 'journal', name: 'Fixture journal', namespace: 'shared', path: '/memories' }] }
+  const scenario = await createScenarioConversation(ctx, team, `RP Team 0.4.0 ${name}`, config)
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId, `${marker}: stage a memory entry.`)
+  await prompt.work.catch(() => undefined)
+  const completed = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  const run = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  const memories = (await team.getState({ conversationId: scenario.conversationId })).values
+    .find(item => item.namespace === 'shared' && item.path === '/memories')?.value
+  const replies = completed.inspection.events.filter(event => event.type === 'assistant/message' && event.seq > prompt.afterSeq)
+  if (shouldCommit) {
+    assert.ok(Array.isArray(memories), `${name} did not commit the configured memory collection`)
+    assert.equal(run.phase, 'complete')
+    assert.equal(memories.length, 1)
+    assert.equal(memories[0].content, 'V040 committed memory entry')
+    assert.equal((await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: run.runId })).outcome, 'committed')
+    assert.equal(replies.length, 1)
+  } else {
+    assert.equal(run.phase, 'failed')
+    assert.equal(run.productCommitStaged, false)
+    assert.equal(memories, undefined, 'A first failed turn must not commit either its default or its staged record')
+    const trace = await team.getTrace({ conversationId: scenario.conversationId, runId: run.runId })
+    assert.ok(trace.events.some(event => event.type === 'state.operation' && event.data.path?.startsWith('/memories')
+      && JSON.stringify(event.data.after).includes('V040 rolled-back memory entry')), 'The fixture must actually stage the memory before rollback')
+    assert.equal((await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: run.runId })).outcome, 'unknown')
+    assert.equal(replies.length, 0)
+  }
+  return { name, conversationId: scenario.conversationId, runId: run.runId,
+    memoryCount: memories?.length ?? 0, state: shouldCommit ? 'committed' : 'rolled_back' }
+}
+
+function scenarioConfig(baseConfig, id, budget) {
+  const config = structuredClone(baseConfig)
+  config.id = `rp-team-v040-${id}`
+  config.version = '0.4.0'
+  delete config.authorParameters
+  delete config.memory
+  config.execution = { ...config.execution, concurrency: 2, maxActivations: 16, maxPerAgent: 4, maxDepth: 4 }
+  if (budget) config.execution.budget = budget
+  else delete config.execution.budget
+  return config
+}
+
+function makeMember(config, id, model, prompt, output = false) {
+  const seed = config.agents[0]
+  return {
+    ...structuredClone(seed), id, name: id, description: `Native 0.4.0 fixture member ${id}`,
+    systemPrompt: prompt, modelRef: { provider: 'rp-team-v024-fixture', model }, presetId: '',
+    parameters: {}, capabilities: [], compaction: {}, statePermissions: [],
+    context: { sources: [{ type: 'current_input' }] },
+    communication: { sendTo: [], receiveFrom: ['*'], requestTo: [], requestFrom: [] },
+    triggers: [{ type: 'always' }],
+    execution: { ...seed.execution, after: [], onFailure: 'continue', trustedTools: [] },
+    outputAuthority: { internal: true, draft: false, state: false, user: output }
+  }
+}
+
+function fixtureRows(path) {
+  if (!existsSync(path)) return []
+  const text = readFileSync(path, 'utf8').trim()
+  return text ? text.split(/\r?\n/u).map(line => JSON.parse(line)) : []
+}
