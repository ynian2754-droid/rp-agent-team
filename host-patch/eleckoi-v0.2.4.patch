+async function runStateScenario(ctx, team, baseConfig, userDataRoot) {
+  const stateConfig = stateFixtureConfig(baseConfig)
+  stateConfig.execution.budget = {maxRequests:50}
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team state/CAS fixture', stateConfig)
+  const saved = await team.getConfig({ conversationId: scenario.conversationId })
+  const invalid = structuredClone(saved.config)
+  invalid.state.definitions[0].type = 'unsupported-state-type'
+  await assert.rejects(team.saveConfig({
+    conversationId: scenario.conversationId, expectedRevision: saved.revision, enabled: true, config: invalid
+  }), error => error?.code === 'RP_TEAM_INVALID_CONFIG')
+  assert.equal((await team.getConfig({ conversationId: scenario.conversationId })).revision, saved.revision,
+    'Rejected state schema must leave the conversation config revision unchanged')
+
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId,
+    'V024_STATE_FIXTURE: exercise shared, private, world state and stale CAS.', [
+      { type: 'image', mediaType: 'image/png', data: 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==', name: 'visible-fixture.png' },
+      { type: 'image', mediaType: 'image/png', data: 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==', name: 'hidden-fixture.png' }
+    ])
+  await prompt.work
+  const completed = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  assert.equal(completed.event.data?.reason?.kind, 'completed',
+    `Native state/CAS turn did not complete: ${JSON.stringify(completed.event.data?.reason)}`)
+  const status = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(status?.phase, 'complete')
+  assert.equal(status.publication?.body, FIXTURE_BODY)
+  const receipt = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: status.runId })
+  assert.equal(receipt.outcome, 'committed')
+
+  const world = await ctx.eleckoiStoryState.snapshot({ conversationId: scenario.conversationId })
+  assert.equal(world.variables.fixture.teamFixture, 'observer-world', 'World variable write did not commit through the Host transaction')
+  assert.equal(world.variables.fixture.actorCount, 1)
+  const statePath = join(userDataRoot, 'dsh-runtime', 'home', 'plugins', 'rp-agent-team', 'state.json')
+  const stateDocument = JSON.parse(readFileSync(statePath, 'utf8'))
+  const conversationState = stateDocument.conversations[scenario.conversationId]
+  assert.equal(conversationState.namespaces.shared.observer, 'observer-shared')
+  assert.equal(conversationState.namespaces.shared.actor, 'actor-shared')
+  assert.equal(conversationState.namespaces['private:agent-1'].note, 'observer-private')
+  assert.equal(conversationState.namespaces.shared.observer, 'observer-shared',
+    'The stale actor write must not overwrite the observer’s committed value')
+
+  const rows = readFileSync(fixtureLog, 'utf8').trim().split(/\r?\n/u).filter(Boolean).map(line => JSON.parse(line))
+  const attemptedCalls = rows.filter(row => row.fixture === 'tool-call')
+  assert.ok(attemptedCalls.some(row => row.call?.args?.value === 'stale-overwrite'), 'The fixture never attempted the stale CAS write')
+  assert.ok(attemptedCalls.some(row => row.call?.args?.namespace === 'private:agent-1'), 'The fixture never probed private-state ACL')
+  const actorRequests = rows.filter(row => row.model === 'actor' && row.messages)
+  assert.ok(actorRequests.every(row => !JSON.stringify(row.messages).includes('observer-private')),
+    'Private Agent 1 state leaked to the publisher model request')
+  const nestedRequest = rows.find(row => row.fixture === 'nested-native-request'
+    && JSON.stringify(row.messages).includes('observer-world'))
+  assert.ok(nestedRequest, 'No actual nested native Agent request was captured')
+  assert.equal(nestedRequest.rpTeamRunId, status.runId)
+  assert.equal(nestedRequest.rpTeamRootSessionId, scenario.sessionId)
+  assert.equal(nestedRequest.rpTeamAgentId, 'agent-2')
+  assert.ok(!nestedRequest.tools.some(name => name.startsWith('rp_team_')),
+    'Nested native child received RP Team-owned tools')
+  assert.ok(!nestedRequest.tools.includes('eleckoi_apply_variable_patch'),
+    'Nested native child inherited a write tool despite the parent’s read-only world permission')
+  assert.ok(JSON.stringify(nestedRequest.messages).includes('observer-world'),
+    'Nested read-only child did not receive the parent-projected variable value')
+  assert.ok(actorRequests.some(row => row.attachments?.some(file => file.name === 'visible-fixture.png')),
+    'Publisher did not receive the explicitly selected first attachment')
+  assert.ok(actorRequests.every(row => !row.attachments?.some(file => file.name === 'hidden-fixture.png')),
+    'Publisher received an attachment excluded by the context selector')
+  assert.ok(!nestedRequest.attachments?.some(file => file.name === 'hidden-fixture.png'),
+    'Nested child inherited the parent’s excluded attachment')
+  const trace = await team.getTrace({conversationId:scenario.conversationId,runId:status.runId})
+  const ownedSessions = new Set(trace.executionSessions.map(item=>item.sessionId))
+  const requests = rows.filter(row=>row.messages && !row.fixture && ownedSessions.has(row.sessionId))
+  assert.equal(status.budget.requestCount,requests.length,'Budget must count each native nested/member request once')
+  assert.ok(ownedSessions.has(nestedRequest.sessionId),'Nested Session must have a durable execution association')
+  return { ...scenario, runId: status.runId, statePath, nativeRequestCount:requests.length, budgetCount:status.budget.requestCount }
+}
