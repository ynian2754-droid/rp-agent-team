+
+async function matchReplayedTurn(ctx, turn, historical, terminalEvent = turn.end) {
+  if (!Number.isSafeInteger(turn.turn) || turn.turn < 1 || !turn.input || !terminalEvent
+    || typeof turn.input.message.id !== 'string' || !Number.isSafeInteger(turn.input.event.seq)) {
+    throw new Error('迁移 Session 缺少完整的用户轮次。')
+  }
+  if (!await promptContentMatches(ctx, turn.input.message.content, historical)) {
+    throw new Error(`迁移 Session 第 ${turn.turn} 轮用户内容与旧聊天不一致。`)
+  }
+  const reason = terminalEvent.data?.reason?.kind
+  const assistants = turn.assistants ?? []
+  let assistant
+  if (historical.response.cancelled) {
+    if (!['aborted', 'cancelled'].includes(reason) || assistants.length) {
+      throw new Error(`旧聊天取消轮次 ${turn.turn} 在新 Session 中没有保持取消状态。`)
+    }
+  } else {
+    if (reason !== 'completed' || assistants.length !== 1) {
+      throw new Error(`旧聊天完成轮次 ${turn.turn} 没有唯一的正式助手正文。`)
+    }
+    assistant = assistants[0]
+    if (typeof assistant.message.id !== 'string' || !Number.isSafeInteger(assistant.event.seq)) {
+      throw new Error(`迁移 Session 第 ${turn.turn} 轮助手消息缺少稳定标识。`)
+    }
+    const text = Array.isArray(assistant.message.content)
+      ? assistant.message.content.filter(block => block?.type === 'text').map(block => block.text).join('')
+      : ''
+    if (text !== historical.response.text
+      || assistant.message.content.some(block => block?.type !== 'text')) {
+      throw new Error(`迁移 Session 第 ${turn.turn} 轮助手正文与旧聊天不一致。`)
+    }
+  }
+  return {
+    turn: turn.turn,
+    inputMessageId: turn.input.message.id,
+    inputEventSeq: turn.input.event.seq,
+    inputSourceMessageId: historical.row.userMessages[0]?.messageId,
+    assistantMessageId: assistant?.message.id,
+    assistantSeq: assistant?.event.seq,
+    response: historical.row.responses?.[0],
+    sourceTurnId: historical.row.visibleId,
+    sourceCreatedAt: historical.row.createdAt
+  }
+}
+
+async function promptContentMatches(ctx, actual, historical) {
+  const actualBlocks = Array.isArray(actual) ? actual : typeof actual === 'string' ? [{ type: 'text', text: actual }] : []
+  const expectedBlocks = historical.content
+  if (actualBlocks.length !== expectedBlocks.length) return false
+  for (let index = 0; index < actualBlocks.length; index += 1) {
+    const actualBlock = actualBlocks[index]
+    const expectedBlock = expectedBlocks[index]
+    if (actualBlock?.type !== expectedBlock?.type) return false
+    if (expectedBlock.type === 'text') {
+      if (String(actualBlock.text ?? '') !== String(expectedBlock.text ?? '')) return false
+      continue
+    }
+    const expected = await historicalAttachmentFingerprint(ctx, expectedBlock, historical.sourceSessionId)
+    const received = await storedAttachmentFingerprint(ctx, actualBlock)
+    if (JSON.stringify(expected) !== JSON.stringify(received)) return false
+  }
+  return true
+}
+
+async function historicalAttachmentFingerprint(ctx, block, sourceSessionId) {
+  const reference = block?.attachment
+  if (!reference?.attachmentId) throw new Error('旧聊天附件缺少稳定引用。')
+  if (block.type === 'image') {
+    const stored = await ctx.sessionController.attachment({ sessionId: sourceSessionId, attachmentId: reference.attachmentId })
+    const bytes = Buffer.from(stored.data, 'base64')
+    return {
+      type: 'image',
+      mediaType: stored.attachment.mediaType,
+      name: stored.attachment.name ?? '',
+      bytes: bytes.byteLength,
+      sha256: createHash('sha256').update(bytes).digest('hex')
+    }
+  }
+  if (block.type === 'file') {
+    const digest = await digestStream(ctx.attachments.readFileStream(reference))
+    return { type: 'file', name: reference.name, bytes: digest.bytes, sha256: digest.sha256 }
+  }
+  throw new Error(`不支持校验此类历史附件：${String(block.type)}`)
+}
+
