+async function verifyTrajectoryEvidence(ctx, team, conversationIds) {
+  const evidence = []
+  for (const conversationId of conversationIds) {
+    for (const summary of await team.listTraces({ conversationId })) {
+      const run = await team.getTrace({ conversationId, runId: summary.runId })
+      assert.equal(run.rootSessionId, conversationId)
+      assert.ok(Number.isSafeInteger(run.turn), 'Native run lost its product turn')
+      assert.ok(Number.isSafeInteger(run.inputEventSeq), 'Native run lost its input anchor')
+      const ids = new Set()
+      for (const execution of run.executionSessions) {
+        assert.ok(!ids.has(execution.sessionId), 'A native Session was registered twice')
+        ids.add(execution.sessionId)
+        assert.ok(execution.executionId && execution.agentId && execution.parentSessionId)
+        const native = await ctx.sessionController.inspect(execution.sessionId)
+        const requests = native.events.filter(event => event.type === 'request/header')
+        evidence.push({ runId: run.runId, turn: run.turn, executionId: execution.executionId,
+          sessionId: execution.sessionId, parentSessionId: execution.parentSessionId,
+          scheduled: execution.scheduled, status: execution.status, requests: requests.length,
+          tools: native.events.filter(event => event.type.startsWith('tool/')).length })
+      }
+      for (const event of run.events.filter(event => event.type === 'state.operation')) {
+        assert.equal(event.data.valuesRecorded, true, 'New state evidence omitted touched values')
+      }
+    }
+  }
+  assert.ok(evidence.some(row => row.scheduled === false), 'Nested Session was missing from durable execution associations')
+  writeFileSync(join(userDataRoot, 'trajectory-associations.json'), JSON.stringify(evidence, null, 2))
+  return { executions: evidence.length, nativeRequests: evidence.reduce((sum, row) => sum + row.requests, 0),
+    nativeToolEvents: evidence.reduce((sum, row) => sum + row.tools, 0), nestedExecutions: evidence.filter(row => !row.scheduled).length }
+}
