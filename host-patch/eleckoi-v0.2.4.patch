+      await adapterStarted
+      await ctx.sessionController.cancel({ sessionId })
+    }
+    const end = await turnEnded.promise
+    const inspection = await ctx.sessionController.inspect(sessionId)
+    const turn = indexTurns(inspection.events).find(row => row.turn === expectedTurnNumber)
+    if (!turn || turn.end === undefined || !turn.input) throw new Error(`官方 Session 第 ${expectedTurnNumber} 轮记录不完整。`)
+    return matchReplayedTurn(ctx, turn, historical, end)
+  } finally {
+    disposeEvents()
+  }
+}
+
+function deferred() {
+  let resolve
+  const promise = new Promise(done => { resolve = done })
+  return { promise, resolve }
+}
+
+function validateHistoricalTurn(row) {
