@@ -0,0 +1,58 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it, vi } from 'vitest'
+import { installRoleplaySessionRuntime } from '../packages/dsh-client-roleplay/src/host/session-runtime.mjs'
+import { readSessionSnapshot } from '../packages/dsh-client-roleplay/src/host/session-snapshot.mjs'
+
+it('creates an unbound migration Session with a local route without changing the product binding or resolving a global model', async () => {
+  const root = mkdtempSync(join(tmpdir(), 'eleckoi-detached-import-'))
+  const template = join(root, 'template.yml')
+  writeFileSync(template, '[]\n')
+  const environment = {
+    ELECKOI_SESSION_SNAPSHOT_ROOT: join(root, 'snapshots'),
+    ELECKOI_PRESET_ROOT: join(root, 'presets'),
+    ELECKOI_PRESET_TEMPLATE_PATH: template,
+    ELECKOI_SESSION_BRIDGE_ROOT: join(root, 'bridges'),
+    ELECKOI_WORKSPACE_ROOT: root
+  }
+  const previous = Object.fromEntries(Object.keys(environment).map(key => [key, process.env[key]]))
+  Object.assign(process.env, environment)
+  try {
+    const runtime = {
+      runtimeSessionId: 'legacy-session',
+      agentPreset: { id: 'test-preset', name: 'Test', versionId: 'v1', roleplayPlan: { steps: [] } },
+      disabledToolGroupIds: [], conversationContext: { history: [] }
+    }
+    const create = vi.fn(async options => ({ sessionId: options.sessionId }))
+    const registerForSession = vi.fn()
+    const currentSelection = vi.fn(() => { throw new Error('Global model must not be resolved during local import') })
+    const ctx = {
+      eleckoiProductData: {
+        prepareConversationRuntime: () => runtime,
+        snapshotConversationRuntime: () => ({ variableStateJson: '{}', settingLibraryStateJson: '[]' })
+      },
+      sessionController: { create }, sessionProjections: { register: () => () => {} },
+      agentDefaultModel: { currentSelection }, llm: {},
+      provide(name, service) { this[name] = service }, on: () => () => {}
+    }
+    const dispose = installRoleplaySessionRuntime(ctx, { registerForSession })
+    const model = { provider: 'local-history', model: 'replay', systemPrompt: '' }
+    expect(await ctx.eleckoiRoleplaySessions.create('chat', { sessionId: 'new-stable-session', model })).toBe('new-stable-session')
+    expect(runtime.runtimeSessionId).toBe('legacy-session')
+    expect(currentSelection).not.toHaveBeenCalled()
+    expect(create).toHaveBeenCalledWith({ sessionId: 'new-stable-session', cwd: root,
+      agentPreset: 'eleckoi-active', agentOptions: { provider: 'local-history', model: 'replay' } })
+    expect(registerForSession).toHaveBeenCalledWith('new-stable-session')
+    expect(readSessionSnapshot(environment.ELECKOI_SESSION_SNAPSHOT_ROOT, 'new-stable-session')).toMatchObject({
+      conversationId: 'chat', runtimeThreadId: 'new-stable-session', model, modelSource: 'explicit'
+    })
+    dispose()
+  } finally {
+    for (const [key, value] of Object.entries(previous)) {
+      if (value === undefined) delete process.env[key]
+      else process.env[key] = value
+    }
+    rmSync(root, { recursive: true, force: true })
+  }
+})
diff --git a/tests/dsh-empty-settlement-turn.test.js b/tests/dsh-empty-settlement-turn.test.js
new file mode 100644
index 0000000..9123c6e
--- /dev/null
+++ b/tests/dsh-empty-settlement-turn.test.js
@@ -0,0 +1,82 @@
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, expect, it, vi } from 'vitest'
+import { installRoleplaySessionRuntime } from '../packages/dsh-client-roleplay/src/host/session-runtime.mjs'
+import { writeSessionSnapshot } from '../packages/dsh-client-roleplay/src/host/session-snapshot.mjs'
+
+const cleanups = []
+afterEach(() => { for (const cleanup of cleanups.splice(0).reverse()) cleanup() })
+
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), 'eleckoi-settlement-'))
+  mkdirSync(join(root, 'chat'))
+  cleanups.push(() => rmSync(root, { recursive: true, force: true }))
+  for (const key of ['ELECKOI_SESSION_SNAPSHOT_ROOT', 'ELECKOI_PRESET_ROOT', 'ELECKOI_PRESET_TEMPLATE_PATH',
+    'ELECKOI_SESSION_BRIDGE_ROOT', 'ELECKOI_WORKSPACE_ROOT']) {
+    const previous = process.env[key]
+    process.env[key] = root
+    cleanups.push(() => { if (previous === undefined) delete process.env[key]; else process.env[key] = previous })
+  }
+  const bridge = join(root, 'variables.json')
+  writeFileSync(bridge, JSON.stringify({ state: { score: 0 } }))
+  writeSessionSnapshot(root, 'root', { conversationId: 'chat', variablesEnabled: true,
+    variableStateFile: bridge, settingLibraryEnabled: false })
+  const replyEvents = [
+    { seq: 1, type: 'turn/start', data: { turn: 1 } },
+    { seq: 2, type: 'step/start', data: { turn: 1, step: 1 } },
+    { seq: 3, type: 'assistant/message', data: { turn: 1, step: 1, message: {
+      id: 'reply', role: 'assistant', content: [{ type: 'text', text: 'scene' }]
+    } } },
+    { seq: 4, type: 'step/end', data: { turn: 1, step: 1 } }
+  ]
+  const handlers = []
+  const ctx = {
+    eleckoiProductData: {
+      commitConversationRuntime: vi.fn(),
+      snapshotConversationRuntime: () => ({ variableStateJson: '{"score":2}', settingLibraryStateJson: '[]' }),
+      prepareConversationRuntime: () => ({ variableContext: { stateJson: '{"score":2}' }, conversationContext: {} }),
+      readStagedProductCommit: () => ({ outcome: 'pending', sessionId: 'root', turn: 1,
+        baseHash: ctx.baseHash, body: 'scene', operations: [] }),
+      commitConversationRuntimeWithReceipt: input => ({ ...input, outcome: 'committed' })
+    },
+    sessionController: { inspect: async () => ({ events: replyEvents }) },
+    sessionProjections: { register: () => () => {} }, agentDefaultModel: {}, llm: {},
+    logger: { error: vi.fn() }, provide(name, service) { this[name] = service },
+    on(name, handler) { if (name === 'session/event') handlers.push(handler); return () => {} }
+  }
+  installRoleplaySessionRuntime(ctx, {})
+  const session = { id: 'root', snapshotEvents: () => replyEvents }
+  const end = turn => { for (const handler of handlers) handler(session, {
+    type: 'turn/end', data: { turn, reason: { kind: 'completed' } }
+  }) }
+  return { ctx, end, checkpoint: () => JSON.parse(readFileSync(join(root, 'chat', 'eleckoi-runtime-checkpoints.json'), 'utf8')) }
+}
+
+it('an empty settlement turn cannot overwrite world state with the stale root bridge', () => {
+  const f = fixture()
+  f.end(2)
+  expect(f.ctx.eleckoiProductData.commitConversationRuntime).not.toHaveBeenCalled()
+  expect(f.checkpoint().checkpoints[0]).toEqual({ beforeTurn: 3, state: {
+    variableStateJson: '{"score":2}', settingLibraryStateJson: '[]'
+  } })
+  expect(f.ctx.logger.error).not.toHaveBeenCalled()
+})
+
+it('a Team receipt still creates the next-turn checkpoint, without ordinary bridge commit', async () => {
+  const f = fixture()
+  f.ctx.baseHash = (await f.ctx.eleckoiStoryState.snapshot({ conversationId: 'chat' })).baseHash
+  await f.ctx.eleckoiStoryState.commitProductTurn({ conversationId: 'chat', runId: 'team-run', sessionId: 'root', turn: 1 })
+  f.end(1)
+  expect(f.ctx.eleckoiProductData.commitConversationRuntime).not.toHaveBeenCalled()
+  expect(f.checkpoint().checkpoints[0].beforeTurn).toBe(2)
+  expect(f.ctx.logger.error).not.toHaveBeenCalled()
+})
+
+it('ordinary RP with a real reply still commits its native state bridge', () => {
+  const f = fixture()
+  f.end(1)
+  expect(f.ctx.eleckoiProductData.commitConversationRuntime).toHaveBeenCalledOnce()
+  expect(JSON.parse(f.ctx.eleckoiProductData.commitConversationRuntime.mock.calls[0][1])).toEqual({ score: 0 })
+  expect(f.ctx.logger.error).not.toHaveBeenCalled()
+})
