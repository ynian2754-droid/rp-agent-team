diff --git a/packages/dsh-client-roleplay/src/host/trial-snapshots.mjs b/packages/dsh-client-roleplay/src/host/trial-snapshots.mjs
new file mode 100644
index 0000000..2f4a97c
--- /dev/null
+++ b/packages/dsh-client-roleplay/src/host/trial-snapshots.mjs
@@ -0,0 +1,347 @@
+import { createHash } from 'node:crypto'
+import { dirname, resolve } from 'node:path'
+import { parse as parseYaml } from 'yaml'
+
+const FORMAT = 'eleckoi.rp-team-trial-snapshot'
+const VERSION = 1
+
+/**
+ * Freeze and seed only the selected product conversation for an isolated RP Team trial.
+ * The returned privateSnapshot is an in-process/worker transport value and must never be
+ * included in a Remote result, a scenario export, or a public trial DTO.
+ */
+export function createTrialSnapshots(ctx) {
+  return Object.freeze({
+    freeze, seed, getHostRoot,
+    captureModelProviders: input => captureModelProviders(ctx, input),
+    captureAgentPresets: input => captureAgentPresets(ctx, input),
+  })
+
+  async function freeze({ conversationId }) {
+    requiredText(conversationId, 'conversationId')
+    const archiveText = await ctx.eleckoiConversationsApi.exportArchive(conversationId)
+    const archive = JSON.parse(archiveText)
+    if (archive?.format !== 'eleckoi.desktop-chat-history' || archive.version !== 1
+      || archive.snapshot?.conversationId !== conversationId) {
+      throw new Error('The selected conversation did not produce a supported native archive.')
+    }
+    const characterId = archive.snapshot.characterId
+    const character = ctx.eleckoiProductData.exportCharacter(characterId, 'json')
+    if (character?.mimeType !== 'application/json' || typeof character.base64 !== 'string') {
+      throw new Error('The selected character could not be exported as a native JSON card.')
+    }
+    const settingLibrary = ctx.eleckoiProductData.readSettingLibrary(characterId)
+    const attachments = await copyArchiveAttachments(ctx, archive)
+    const modelSelection = await ctx.eleckoiConversationModelsApi.current(conversationId)
+    const runtime = ctx.eleckoiProductData.snapshotConversationRuntime(conversationId)
+    const modelProviders = modelSelection?.provider
+      ? [await selectedProviderSettings(ctx, modelSelection.provider)]
+      : []
+    const nativePreset = selectedProductPreset(ctx)
+    const createdAt = new Date().toISOString()
+    const privateSnapshot = {
+      format: FORMAT,
+      version: VERSION,
+      conversationId,
+      createdAt,
+      archive,
+      character: { fileName: character.fileName, mimeType: character.mimeType, base64: character.base64 },
+      settingLibrary: structuredClone(settingLibrary),
+      modelSelection: structuredClone(modelSelection),
+      modelProviders,
+      ...(nativePreset ? { nativePreset } : {}),
+      runtime: structuredClone(runtime),
+      attachments,
+    }
+    const digest = createHash('sha256').update(JSON.stringify(privateSnapshot)).digest('hex')
+    return {
+      snapshotId: `trial-snapshot-${digest.slice(0, 32)}`,
+      conversationId,
+      createdAt,
+      summary: {
+        characterName: archive.snapshot.tables?.chat_sessions?.[0]?.characterName ?? '',
+        turnCount: archive.snapshot.tables?.agent_turns?.length ?? 0,
+        attachmentCount: attachments.length,
+      },
+      privateSnapshot,
+    }
+  }
+
+  async function seed({ snapshot, trialId, variantId }) {
+    if (!snapshot || snapshot.format !== FORMAT || snapshot.version !== VERSION) {
+      throw new TypeError('A private RP Team trial snapshot is required.')
+    }
+    requiredText(trialId, 'trialId')
+    requiredText(variantId, 'variantId')
+
+    const preview = ctx.eleckoiProductData.prepareCharacterImports([{
+      displayName: snapshot.character.fileName || 'trial-seed.json',
+      mimeType: 'application/json',
+      base64: snapshot.character.base64,
+    }], 'eleckoi')
+    const card = preview.items.find(item => item.id === 'card-1')
+    if (!card?.importable) {
+      ctx.eleckoiProductData.discardCharacterImports?.(preview.token)
+      throw new Error(card?.errorMessage || 'The trial character card is not importable.')
+    }
+    const imported = ctx.eleckoiProductData.commitCharacterImports(preview.token)
+    const characterId = imported.importedCharacterIds[0]
+    if (!characterId) throw new Error(imported.failedMessages?.[0] || 'The trial character card was not imported.')
+    const archive = structuredClone(snapshot.archive)
+
+    if (snapshot.settingLibrary) {
+      const characterName = archive.snapshot.tables?.chat_sessions?.[0]?.characterName
+        || JSON.parse(Buffer.from(snapshot.character.base64, 'base64').toString('utf8')).name
+      const name = snapshot.settingLibrary.name || characterName
+      if (typeof name !== 'string' || !name.trim()) throw new Error('The frozen setting library has no character name.')
+      ctx.eleckoiProductData.saveSettingLibrary(characterId, {
+        ...structuredClone(snapshot.settingLibrary),
+        characterId,
+        name,
+      })
+    }
+
+    const presetIds = {}
+    if (snapshot.nativePreset?.document) {
+      const importedPreset = ctx.eleckoiProductData.importAgentPreset('eleckoi', structuredClone(snapshot.nativePreset.document))
+      presetIds[snapshot.nativePreset.id] = importedPreset.preset.id
+      ctx.eleckoiProductData.setActiveAgentPreset(importedPreset.preset.id)
+    }
+    for (const definition of snapshot.referencedPresets ?? []) {
+      const prior = await ctx.agentPresets.resolve(definition.id).catch(() => undefined)
+      if (prior) {
+        const document = await ctx.agentPresets.readDocument(definition.id)
+        if (stableJson(parsePresetPlugins(document.content)) !== stableJson(definition.plugins)) {
+          throw new Error(`Native preset ${definition.id} differs from the frozen definition.`)
+        }
+        if (prior.broken) throw new Error(`Native preset ${definition.id} is unavailable in the isolated profile: ${prior.broken}`)
+      } else {
+        const dispose = await ctx.agentPresets.register(structuredClone(definition))
+        ctx.effect(() => dispose)
+      }
+      presetIds[definition.id] = definition.id
+    }
+    const copiedAttachments = await seedAttachments(ctx, snapshot.attachments ?? [])
+    rewriteAttachmentReferences(archive, copiedAttachments)
+    archive.snapshot.characterId = characterId
+    archive.snapshot.tables.chat_sessions[0].characterId = characterId
+    const conversationId = await ctx.eleckoiConversationsApi.importArchive(characterId, JSON.stringify(archive))
+    if (snapshot.runtime) ctx.eleckoiProductData.restoreConversationRuntime(conversationId, structuredClone(snapshot.runtime))
+    for (const value of snapshot.modelProviders ?? (snapshot.modelProvider ? [snapshot.modelProvider] : [])) {
+      await seedSelectedProviderSettings(ctx, value)
+    }
+    await ctx.eleckoiConversationModelsApi.select(conversationId, structuredClone(snapshot.modelSelection))
+    await ctx.eleckoiRoleplaySessions.prepareImportedSession(conversationId)
+    const sessionId = ctx.eleckoiProductData.runtimeSessionId(conversationId)
+    return { characterId, conversationId, sessionId, trialId, variantId, presetIds }
+  }
+
+  function getHostRoot() {
+    const templatePath = process.env.ELECKOI_PRESET_TEMPLATE_PATH
+    if (typeof templatePath !== 'string' || !templatePath.trim()) {
+      throw new Error('The ElecKoi Host runtime template path is unavailable to the isolated trial worker.')
+    }
+    return resolve(dirname(dirname(dirname(dirname(templatePath)))))
+  }
+}
+
+async function selectedProviderSettings(ctx, provider) {
+  if (typeof provider !== 'string' || !ctx.settings?.describe) return { provider }
+  const descriptors = ctx.settings.describe()
+  const descriptor = descriptors.find(item => item.ns === 'eleckoi-client-models')
+  const entry = descriptor?.value?.entries?.[provider]
+  const route = ctx.llm?.listConfigurableProviders?.().find(item => item.provider === provider)
+  let settingsValue
+  if (route) {
+    const namespace = descriptors.find(item => item.ns === route.settingsNs)
+    settingsValue = readPath(namespace?.value, route.settingsPath)
+  }
+  const credentialRecord = route?.settingsNs === 'llm-pi-ai' && typeof ctx.credentials?.readRecord === 'function'
+    ? await ctx.credentials.readRecord(`llm-pi-ai/${provider}`)
+    : undefined
+  return {
+    provider,
+    ...(entry ? { entry: structuredClone(entry) } : {}),
+    ...(route && settingsValue !== undefined ? {
+      settingsNs: route.settingsNs,
+      settingsPath: [...route.settingsPath],
+      settingsValue: structuredClone(settingsValue),
+    } : {}),
+    ...(credentialRecord ? { credentialRecord: structuredClone(credentialRecord) } : {}),
+  }
+}
+
+async function seedSelectedProviderSettings(ctx, value) {
+  if (!value) return
+  const descriptors = ctx.settings?.describe?.() ?? []
+  if (typeof ctx.settings?.mutate !== 'function') {
+    if (value.entry || value.settingsNs || value.credentialRecord) {
+      throw new Error(`The selected model provider ${value.provider} settings are unavailable in the isolated trial profile.`)
+    }
+    return
+  }
+  const modelDescriptor = descriptors.find(item => item.ns === 'eleckoi-client-models')
+  if (value.entry && !modelDescriptor) throw new Error('The isolated profile has no ElecKoi model metadata settings.')
+  if (value.settingsNs && Array.isArray(value.settingsPath) && value.settingsValue !== undefined) {
+    const routeDescriptor = descriptors.find(item => item.ns === value.settingsNs)
+    if (!routeDescriptor) throw new Error(`The isolated profile has no settings for selected route ${value.provider}.`)
+    await ctx.settings.mutate(value.settingsNs, [
+      { op: 'set', path: value.settingsPath, value: structuredClone(value.settingsValue) },
+    ], routeDescriptor.revision)
+  }
+  if (value.entry) {
+    await ctx.settings.mutate('eleckoi-client-models', [
+      { op: 'set', path: ['entries', value.provider], value: structuredClone(value.entry) },
+    ], modelDescriptor.revision)
+  }
+  if (value.credentialRecord && value.settingsNs === 'llm-pi-ai' && typeof ctx.credentials?.modifyRecord === 'function') {
+    await ctx.credentials.modifyRecord(`llm-pi-ai/${value.provider}`, async () => structuredClone(value.credentialRecord))
+  }
+}
+
+function selectedProductPreset(ctx) {
+  const presetId = ctx.eleckoiProductData.readAgentPresetCatalog().activePresetId
+  if (!presetId) return undefined
+  const document = ctx.eleckoiProductData.exportAgentPreset(presetId, 'json')
+  if (document?.mimeType !== 'application/json' || typeof document.base64 !== 'string') {
+    throw new Error(`Selected author preset ${presetId} could not be exported through the official product API.`)
+  }
+  return {
+    id: presetId,
+    document: { displayName: document.fileName, mimeType: document.mimeType, base64: document.base64 },
+  }
+}
+
+async function captureModelProviders(ctx, { providerIds }) {
+  return Promise.all([...new Set((providerIds ?? []).filter(value => typeof value === 'string' && value))]
+    .map(provider => selectedProviderSettings(ctx, provider)))
+}
+
+async function captureAgentPresets(ctx, { presetIds }) {
+  const definitions = []
+  for (const id of [...new Set((presetIds ?? []).filter(value => typeof value === 'string' && value))]) {
+    const resolved = await ctx.agentPresets.resolve(id)
+    if (resolved?.broken) throw new Error(`Selected Team native preset ${id} is unavailable: ${resolved.broken}`)
+    const document = await ctx.agentPresets.readDocument(id)
+    definitions.push({
+      id,
+      ...(document.name ? { name: document.name } : {}),
+      ...(document.description ? { description: document.description } : {}),
+      plugins: parsePresetPlugins(document.content),
+    })
+  }
+  return definitions
+}
+
+function parsePresetPlugins(content) {
+  const document = parseYaml(content, { customTags: [{
+    tag: 'tag:yaml.org,2002:js',
+    resolve(value) { return { __jsExpr: value } },
+    stringify(item) { return { value: item.__jsExpr } },
+  }] })
+  if (!Array.isArray(document?.plugins)) throw new Error('The selected native Team preset document is invalid.')
+  return document.plugins
+}
+
+function readPath(value, path) {
+  if (!Array.isArray(path)) return undefined
+  let current = value
+  for (const key of path) current = current?.[key]
+  return current === undefined ? undefined : current
+}
+
+function stableJson(value) {
+  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`
+  if (value && typeof value === 'object') return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${stableJson(value[key])}`).join(',')}}`
+  return JSON.stringify(value)
+}
+
+async function copyArchiveAttachments(ctx, archive) {
+  const refs = collectAttachmentReferences(archive)
+  const copies = []
+  for (const { kind, ref } of refs.values()) {
+    if (kind === 'image') {
+      const stored = await ctx.attachments.readImage(ref)
+      copies.push({ kind, ref, data: Buffer.from(stored.data).toString('base64') })
+    } else {
+      const chunks = []
+      let size = 0
+      for await (const chunk of ctx.attachments.readFileStream(ref)) {
+        const bytes = Buffer.from(chunk)
+        size += bytes.byteLength
+        chunks.push(bytes)
+      }
+      if (size !== ref.bytes) throw new Error(`Attachment ${ref.attachmentId} changed length while freezing the trial.`)
+      copies.push({ kind, ref, data: Buffer.concat(chunks, size).toString('base64') })
+    }
+  }
+  return copies
+}
+
+async function seedAttachments(ctx, copies) {
+  const result = new Map()
+  for (const item of copies) {
+    const data = Buffer.from(item.data, 'base64')
+    const ref = item.kind === 'image'
+      ? await ctx.attachments.saveImage({ data, mediaType: item.ref.mediaType, name: item.ref.name })
+      : await ctx.attachments.saveFile({ data, name: item.ref.name })
+    result.set(attachmentKey(item.kind, item.ref), ref)
+  }
+  return result
+}
+
+function collectAttachmentReferences(value) {
+  const refs = new Map()
+  const visit = item => {
+    if (!item || typeof item !== 'object') return
+    if (Array.isArray(item)) {
+      for (const child of item) visit(child)
+      return
+    }
+    const kind = attachmentKind(item)
+    if (kind) refs.set(attachmentKey(kind, item), { kind, ref: structuredClone(item) })
+    for (const child of Object.values(item)) visit(child)
+  }
+  visit(value)
+  return refs
+}
+
+function rewriteAttachmentReferences(value, copied) {
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index++) value[index] = rewriteValue(value[index], copied)
+    return
+  }
+  for (const [key, child] of Object.entries(value)) value[key] = rewriteValue(child, copied)
+}
+
+function rewriteValue(value, copied) {
+  if (!value || typeof value !== 'object') return value
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index++) value[index] = rewriteValue(value[index], copied)
+    return value
+  }
+  const kind = attachmentKind(value)
+  if (kind) {
+    const mapped = copied.get(attachmentKey(kind, value))
+    if (!mapped) throw new Error(`The frozen ${kind} attachment ${value.attachmentId} was not copied.`)
+    return structuredClone(mapped)
+  }
+  for (const [key, child] of Object.entries(value)) value[key] = rewriteValue(child, copied)
+  return value
+}
+
+function attachmentKind(value) {
+  if (typeof value.attachmentId !== 'string' || !value.attachmentId) return undefined
+  if (typeof value.mediaType === 'string' && value.mediaType.startsWith('image/')) return 'image'
+  if (typeof value.name === 'string' && Number.isSafeInteger(value.bytes) && value.bytes >= 0) return 'file'
+  return undefined
+}
+
+function attachmentKey(kind, ref) {
+  return `${kind}:${ref.attachmentId}`
+}
+
+function requiredText(value, name) {
+  if (typeof value !== 'string' || !value.trim()) throw new TypeError(`${name} is required.`)
+  return value.trim()
+}
