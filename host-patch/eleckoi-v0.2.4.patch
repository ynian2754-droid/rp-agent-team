+function verifyOldMappings(ctx, conversationId, sessionId, inspection) {
+  const mappings = ctx.eleckoiProductData.legacyMessageMappings(conversationId)
+    .filter(row => row.runtimeSessionId === sessionId)
+  assert.ok(mappings.some(row => row.role === 'user'), 'Migrated product history has no mapped user messages')
+  assert.ok(mappings.some(row => row.role === 'assistant'), 'Migrated product history has no mapped assistant messages')
+  const details = ctx.eleckoiProductData.readConversationDetails(conversationId, undefined, 200)
+  const productMessages = new Map(details.messages.map(row => [row.id, row]))
+  for (const mapping of mappings) {
+    assert.ok(Number.isFinite(Date.parse(mapping.createdAt)), `Legacy message ${mapping.legacyMessageId} lost its original timestamp`)
+    const productMessage = productMessages.get(mapping.legacyMessageId)
+    assert.ok(productMessage, `Legacy product message ${mapping.legacyMessageId} is not visible in migrated history`)
+    assert.equal(productMessage.createdAt, mapping.createdAt, `Legacy message ${mapping.legacyMessageId} lost its original product timestamp`)
+    assert.equal(productMessage.runtimeSessionId, sessionId, `Legacy message ${mapping.legacyMessageId} was rebound to the wrong Session`)
+    assert.equal(productMessage.dshMessageId, mapping.dshMessageId, `Legacy message ${mapping.legacyMessageId} maps to a different official message`)
+    assert.equal(productMessage.sessionEventSeq, mapping.eventSeq)
+    assert.equal(productMessage.dshTurn, mapping.dshTurn)
+    const event = inspection.events.find(item => item.seq === mapping.eventSeq)
+    const nativeMessage = event?.data?.message ?? event?.data
+    assert.equal(event?.type, mapping.role === 'user' ? 'user/message' : 'assistant/message')
+    assert.equal(nativeMessage?.id, mapping.dshMessageId)
+    assert.equal(nativeMessage?.role, mapping.role)
+  }
+  return mappings
