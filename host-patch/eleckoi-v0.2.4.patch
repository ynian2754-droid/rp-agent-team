+    if (typeof chunk === 'string') chunk = chunk.replace(/([?&]token=)[^&\s]+/giu, '$1[redacted]')
+    else if (Buffer.isBuffer(chunk)) chunk = Buffer.from(chunk.toString().replace(/([?&]token=)[^&\s]+/giu, '$1[redacted]'))
