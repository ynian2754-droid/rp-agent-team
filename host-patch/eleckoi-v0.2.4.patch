+        }
+        if (tools.includes('eleckoi_apply_variable_patch')) throw new Error('Read-only publisher received native variable write permission')
+        yield* emitCalls([
+          { name: 'rp_team_read_state', args: { namespace: 'world', path: '/variables/fixture/teamFixture' } },
+          { name: 'eleckoi_read_variables', args: { paths: ['/fixture/teamFixture'] } },
+          { name: 'eleckoi_read_setting_files', args: { paths: ['隐藏工具时间线'] } },
+          { name: 'rp_team_write_state', args: { namespace: 'shared', path: '/actor', value: 'actor-shared', expectedVersion: 0 } }
+        ])
+        return
+      }
+      if (step === 2) {
+        if (!tools.includes('rp_team_publish')) throw new Error('Configured publisher has no rp_team_publish tool')
+        yield* emitCalls([{ name: 'rp_team_publish', args: { body: ${JSON.stringify(FIXTURE_BODY)}, selectedDraftIds: [] } }])
