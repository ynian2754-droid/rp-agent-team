+async function waitForCompletedTurn(ctx, sessionId, priorTurnEnds, afterSeq, timeoutMs = 90_000) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    const inspection = await ctx.sessionController.inspect(sessionId)
+    const completed = inspection.events.filter(event => event.type === 'turn/end')
+    const event = completed.find(item => item.seq > afterSeq)
+    if (completed.length > priorTurnEnds && event) return { inspection, event }
+    await new Promise(resolve => setTimeout(resolve, 100))
+  }
+  const status = ctx.agents.get(sessionId)?.status
+  throw new Error(`Timed out waiting for official Session turn/end; Agent status=${String(status)}`)
+}
+
+async function waitForFixtureRow(predicate, timeoutMs = 30_000) {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (existsSync(fixtureLog)) {
+      const rows = readFileSync(fixtureLog, 'utf8').trim().split(/\r?\n/u).filter(Boolean).map(line => JSON.parse(line))
+      const match = rows.find(predicate)
+      if (match) return match
+    }
+    await new Promise(resolve => setTimeout(resolve, 50))
+  }
+  throw new Error('Timed out waiting for the local fixture adapter signal')
+}
