+async function runDisableScenario(ctx, manager, teamBundle, team, baseConfig) {
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team disable/unload fixture', stateFixtureConfig(baseConfig, 'DISABLE'))
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId,
+    'V024_DISABLE_FIXTURE: hold one real child request while its bundle is disabled.')
+  const work = prompt.work.catch(() => undefined)
+  await waitForFixtureRow(row => row.fixture === 'disable-waiting' && row.sessionId)
+  const running = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.ok(running?.runId && !['failed', 'cancelled', 'complete'].includes(running.phase),
+    'Bundle-disable fixture never reached a live Team child')
+
+  const disabled = await manager.setBundleEnabled(teamBundle, false)
+  assert.equal(disabled.application, 'applied', `Could not disable the live fixture bundle: ${JSON.stringify(disabled)}`)
+  const ended = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  await work
+  assert.notEqual(ended.event.data?.reason?.kind, 'completed', 'Disabling the bundle completed a publication that should be cancelled')
+  assert.equal(ended.inspection.events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === ended.event.data?.turn).length, 0, 'Disabled in-flight Team run published an assistant message')
+  const runDocument = JSON.parse(readFileSync(join(process.env.DSH_HOME, 'plugins', 'rp-agent-team', 'state.json'), 'utf8'))
+  const persistedRun = Object.values(runDocument.conversations[scenario.conversationId]?.runs ?? {})
+    .sort((left, right) => String(right.updatedAt).localeCompare(String(left.updatedAt)))[0]
+  assert.equal(persistedRun?.status, 'rolled_back', 'Bundle teardown did not roll back unpublished state writes')
+  const persistedRunTrace = await team.getTrace({ conversationId: scenario.conversationId, runId: running.runId })
+  assert.equal(persistedRunTrace.phase, 'cancelled', 'Bundle teardown did not persist the cancelled Runtime phase')
+  const receipt = await ctx.eleckoiStoryState.getProductCommitStatus({
+    conversationId: scenario.conversationId, runId: running.runId
+  })
+  assert.equal(receipt.outcome, 'unknown', 'Unpublished bundle teardown must not fabricate a Host product receipt')
+  assert.equal(ctx.get('rpAgentTeam'), undefined, 'Disabling the bundle left its Team service registered')
+
+  const normal = await promptOfficialTurn(ctx, scenario.sessionId, 'V024_NORMAL_AFTER_DISABLE: reply as the ordinary root agent.')
+  await normal.work
+  const ordinary = await waitForCompletedTurn(ctx, scenario.sessionId, normal.priorEnds, normal.afterSeq)
+  assert.equal(ordinary.event.data?.reason?.kind, 'completed')
+  const ordinaryMessage = ordinary.inspection.events.find(event => event.type === 'assistant/message'
+    && event.data?.turn === ordinary.event.data?.turn)
+  assert.equal(textOfMessage(ordinaryMessage), 'Local observer completed.',
+    'The disabled Team bundle did not restore ordinary local root responses')
+  const requests = readFileSync(fixtureLog, 'utf8').trim().split(/\r?\n/u).filter(Boolean).map(line => JSON.parse(line))
+    .filter(row => row.sessionId === scenario.sessionId && row.provider === FIXTURE_PROVIDER && row.model)
+  const ordinaryRequest = requests.find(row => row.step === 0)
+  assert.equal(ordinaryRequest?.model, 'observer', 'Ordinary post-disable generation did not use the selected native root route')
+  assert.ok((ordinaryRequest?.tools ?? []).every(name => !name.startsWith('rp_team_')),
+    'A disabled Team bundle still injected RP Team tools into the ordinary root request')
+
+  const removed = await manager.removeBundle(teamBundle)
+  assert.equal(removed.application, 'applied', `Could not uninstall the local fixture bundle: ${JSON.stringify(removed)}`)
+  const remaining = (await manager.listBundles()).find(bundle => bundle.name === teamBundle)
+  assert.ok(!remaining?.installed && !remaining?.enabled, 'Uninstall left the fixture Team bundle selected or installed')
+  return { ...scenario, runId: running.runId }
+}
