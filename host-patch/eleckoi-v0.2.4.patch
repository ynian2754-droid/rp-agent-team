+
+function installFixtureAdapter(ctx) {
+  const requests = []
+  const steps = new Map()
+  const adapter = {
+    providerInfo(provider) { return { id: provider, name: 'RP Team migrated-history local fixture' } },
+    providerRetryPolicy() { return undefined },
+    imageRequestPricing() { return undefined },
+    async listModels(provider) {
+      return ['ordinary', 'worker', 'publisher'].map(id => ({ provider, id, name: `Local fixture ${id}` }))
+    },
+    async resolveModel(provider, model) {
+      return {
+        provider,
+        id: model,
+        name: `Local fixture ${model}`,
+        context: { contextWindow: 100_000 },
+        inputModalities: ['text'],
+        reasoning: { efforts: [{ id: 'low', name: 'Low' }], defaultEffort: 'low' }
+      }
+    },
+    async prepareCall(provider, model, signal) {
+      return { model: await this.resolveModel(provider, model, signal), stream: options => this.stream(options) }
+    },
+    async *stream(options) {
+      if (options.provider !== fixtureProvider) throw new Error(`Blocked non-fixture route ${String(options.provider)}`)
+      options.signal?.throwIfAborted()
+      const sessionId = String(options.sessionId ?? '')
+      const model = String(options.model ?? '')
+      const step = steps.get(sessionId) ?? 0
+      steps.set(sessionId, step + 1)
+      const messages = (options.messages ?? []).map(message => ({
+        role: message?.role,
+        text: typeof message?.content === 'string' ? message.content
+          : Array.isArray(message?.content)
+            ? message.content.map(block => typeof block?.text === 'string' ? block.text : '').join('\n')
+            : ''
+      }))
+      const request = { provider: options.provider, model, sessionId, step, messages, tools: (options.tools ?? []).map(tool => tool.name) }
+      requests.push(request)
+
+      if (model === 'worker') {
+        const phase = readFileSync(fixturePhasePath, 'utf8').trim()
+        if (step === 0) {
+          const worldPatch = worldPatchCall(phase)
+          for (const name of ['rp_team_write_state', 'rp_team_send', worldPatch.name]) {
+            if (!request.tools.includes(name)) throw new Error(`Worker request omitted required fixture tool ${name}`)
+          }
+          yield* emitToolCalls(request, [
+            {
+              name: 'rp_team_write_state',
+              args: { namespace: 'shared', path: '/migrationMarker', value: `team-${phase}`, expectedVersion: expectedSharedVersion(phase) }
+            },
+            worldPatch,
+            { name: 'rp_team_send', args: { to: 'agent-2', body: `Worker finished ${phase}.` } }
+          ])
+          return
+        }
+        if (step === 1) {
+          if (!request.tools.includes('rp_team_submit_internal')) throw new Error('Worker request omitted rp_team_submit_internal')
+          yield* emitToolCalls(request, [{ name: 'rp_team_submit_internal', args: { summary: `Worker ${phase} complete.`, data: { phase } } }])
+          return
+        }
+        yield* emitText(`Worker ${phase} completed.`)
+        return
+      }
+
+      if (model === 'publisher') {
+        const phase = readFileSync(fixturePhasePath, 'utf8').trim()
+        if (step === 0) {
+          if (!request.tools.includes('rp_team_read_messages')) throw new Error('Publisher request omitted rp_team_read_messages')
+          yield* emitToolCalls(request, [{ name: 'rp_team_read_messages', args: { from: ['agent-1'] } }])
+          return
+        }
+        if (step === 1) {
+          if (!request.tools.includes('rp_team_publish')) throw new Error('Publisher request omitted rp_team_publish')
+          yield* emitToolCalls(request, [{
+            name: 'rp_team_publish',
+            args: { body: `MIGRATED_HISTORY_FIXTURE_${phase}_BODY`, selectedDraftIds: [] }
+          }])
+          return
+        }
+        yield* emitText(`Publisher ${phase} completed.`)
+        return
+      }
+
+      yield* emitText('Ordinary RP reply from the local fixture adapter.')
+    }
+  }
+  const disposeAdapter = ctx.llm.registerAdapter([fixtureProvider], adapter)
+  const disposeGuard = ctx.on('llm/stream', (options, next) => {
+    if (options.provider === fixtureProvider
+      || (options.provider === TEAM_DELIVERY_PROVIDER && options.model === TEAM_DELIVERY_MODEL)) return next()
+    throw new Error(`Fixture blocked external model route ${String(options.provider)}`)
+  }, { global: true, prepend: true })
+  return { requests, dispose() { disposeGuard(); disposeAdapter() } }
+}
+
+async function* emitToolCalls(request, calls) {
+  for (let index = 0; index < calls.length; index += 1) {
+    const call = calls[index]
+    const id = `rp-team-v024-migrated-${request.sessionId}-${request.step}-${index}`
+    const args = JSON.stringify(call.args)
+    yield { type: 'block-start', index, blockType: 'tool-call' }
+    yield { type: 'tool-call-delta', index, id, name: call.name, argumentsDelta: args }
+    yield { type: 'block-end', index, block: { type: 'tool-call', id, name: call.name, arguments: args } }
+  }
+  yield { type: 'finish', reason: { kind: 'tool-calls' } }
+}
+
+async function* emitText(text) {
+  yield { type: 'block-start', index: 0, blockType: 'text' }
+  yield { type: 'text-delta', index: 0, text }
+  yield { type: 'block-end', index: 0, block: { type: 'text', text } }
+  yield { type: 'finish', reason: { kind: 'stop' } }
+}
+
+let activeWorldPath
+let activeWorldKind
+let activeWorldBase
+function worldValueFor(phase) {
+  if (typeof activeWorldBase === 'string') return `rp-team-migration-${phase}`
+  if (typeof activeWorldBase === 'number') return activeWorldBase + ({ A: 101, B: 202, B2: 303, A2: 404 }[phase] ?? 909)
+  if (typeof activeWorldBase === 'boolean') return phase === 'B' ? !activeWorldBase : activeWorldBase
+  throw new Error(`Unsupported fixture world leaf type at ${activeWorldPath}`)
+}
+
+function expectedSharedVersion(phase) {
+  return phase === 'A' || phase === 'A2' ? 0 : 1
+}
+
+function worldPatchCall(phase) {
+  return {
+    name: 'eleckoi_apply_setting_patch',
+    args: { operation: 'write_file', path: activeWorldPath, content: worldValueFor(phase) }
+  }
+}
+
+function currentWorldFixtureValue(world) {
+  return world.settings[activeWorldPath]
+}
+
+function settingsPointer(path) {
+  return `/settings/${String(path).replace(/~/g, '~0').replace(/\//g, '~1')}`
+}
+
+function textOfEvent(event) {
+  const message = event?.data?.message ?? event?.data
+  return (message?.content ?? []).filter(block => block?.type === 'text')
+    .map(block => String(block.text ?? '')).join('').trim()
+}
+
+function parseJson(path) { return JSON.parse(readFileSync(path, 'utf8')) }
+function sha256(path) { return createHash('sha256').update(readFileSync(path)).digest('hex') }
+
+function treeEntries(root) {
+  const entries = []
+  function visit(directory, prefix = '') {
+    for (const name of readdirSync(directory).sort()) {
+      const path = join(directory, name)
+      const relativePath = prefix ? `${prefix}/${name}` : name
+      const stats = lstatSync(path)
+      if (stats.isSymbolicLink()) entries.push([relativePath, `link:${readlinkSync(path)}`])
+      else if (stats.isDirectory()) {
+        entries.push([relativePath, 'directory'])
+        visit(path, relativePath)
+      } else if (stats.isFile()) entries.push([relativePath, `file:${sha256(path)}`])
+      else throw new Error(`Unsupported file in isolated profile copy: ${relativePath}`)
+    }
+  }
+  visit(root)
+  return entries
+}
+
+function committedState(value) {
+  return {
+    revision: value?.revision ?? 0,
+    namespaces: value?.namespaces ?? {},
+    pathVersions: value?.pathVersions ?? {}
+  }
+}
+
+function fingerprint(value) {
+  function canonical(item) {
+    if (Array.isArray(item)) return item.map(canonical)
+    if (item && typeof item === 'object') {
+      return Object.fromEntries(Object.keys(item).sort().map(key => [key, canonical(item[key])]))
+    }
+    return item
+  }
+  return createHash('sha256').update(JSON.stringify(canonical(value))).digest('hex')
+}
