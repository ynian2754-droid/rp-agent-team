+  let group = groups.get(entry.groupId)
+  while (group && !seen.has(group.id)) {
+    seen.add(group.id)
+    parts.unshift(safeSegment(group.name))
+    group = groups.get(group.parentId)
+  }
+  const title = safeSegment(entry.title || '未命名设定')
+  return [...parts.filter(Boolean), title].filter(Boolean).join('/')
+}
