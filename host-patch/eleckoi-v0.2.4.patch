+  if (response && !['completed', 'cancelled'].includes(response.status)) {
+    throw new Error(`旧聊天轮次 ${row.visibleId} 的回答状态不支持重放。`)
+  }
+  if (response?.status === 'completed') {
+    const contentText = Array.isArray(response.content)
+      ? response.content.filter(block => block?.type === 'text').map(block => typeof block.text === 'string' ? block.text : '').join('')
+      : undefined
+    const text = contentText ?? (typeof response.text === 'string' ? response.text : '')
+    if (!text) throw new Error(`旧聊天已完成回答 ${response.visibleId} 缺少可见正文。`)
+    if (typeof response.text === 'string' && contentText !== undefined && response.text !== contentText) {
+      throw new Error(`旧聊天回答 ${response.visibleId} 的可见正文与内容块不一致。`)
+    }
+    if (Array.isArray(response.content) && response.content.some(block => block?.type !== 'text' && block?.type !== 'reasoning')) {
+      throw new Error(`旧聊天回答 ${response.visibleId} 包含当前 AgentLoop 不支持的可见块。`)
+    }
+    return {
+      row,
+      response: { cancelled: false, text },
+      sourceSessionId: row.runtimeThreadId,
+      content: row.content
+    }
+  }
+  return {
+    row,
+    response: { cancelled: true, text: '' },
+    sourceSessionId: row.runtimeThreadId,
+    content: row.content
+  }
+}
+
+function indexTurns(events) {
+  const result = []
+  let current
+  for (const event of events) {
+    if (event.type === 'turn/start') {
+      current = { turn: event.data?.turn, start: event, events: [] }
+      result.push(current)
+    }
+    if (!current) continue
+    current.events.push(event)
+    if (event.type === 'user/message') {
+      const message = event.data?.message ?? event.data
+      if (message?.role === 'user' && message.source?.kind === 'user') {
+        current.input = { event, message }
+      }
+    }
+    if (event.type === 'assistant/message') {
+      const message = event.data?.message ?? event.data
+      if (message?.role === 'assistant' && event.surfaceOp === 'append') {
+        current.assistants ??= []
+        current.assistants.push({ event, message })
+      }
+    }
