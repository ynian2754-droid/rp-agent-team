+  const withinRoot = relative(exportRoot, archivePath)
+  if (!withinRoot || withinRoot === '..' || withinRoot.startsWith(`..${sep}`) || isAbsolute(withinRoot)) {
+    throw new Error('旧聊天归档路径越出导出目录。')
+  }
