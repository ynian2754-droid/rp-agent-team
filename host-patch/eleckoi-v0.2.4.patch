+    || !Array.isArray(row.content)) throw new Error('旧聊天活动分支的用户轮次格式无效。')
+  if (row.responses?.length > 1) throw new Error(`旧聊天轮次 ${row.visibleId} 有多个历史回答，无法安全映射为唯一 DSH 正文。`)
