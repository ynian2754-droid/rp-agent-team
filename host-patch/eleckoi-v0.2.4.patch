+}
+
+function decodePath(path) {
+  if (path === '' || !path.startsWith('/')) throw workError('ELECKOI_AUTHOR_EDIT_INVALID', '作者世界状态路径必须是 JSON Pointer。')
+  return path.slice(1).split('/').map((segment) => {
