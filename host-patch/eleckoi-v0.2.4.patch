+    await running.shutdown.shutdown(0)
+  }
+}
+
+try {
+  await run()
+} catch (error) {
+  process.stderr.write(`${error?.stack ?? String(error)}\n`)
+  process.exitCode = 1
+} finally {
+  if (!keepHome) rmSync(userDataRoot, { recursive: true, force: true })
+}
