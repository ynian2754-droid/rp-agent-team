+        status: turn.status, usage: turn.usage,
+      })) })),
+      nativeModelRequests: modelRequests,
+      mode: hardInterruption ? 'hard-interruption' : cancelRetry ? 'cancel-retry' : checkpointRetry ? 'checkpoint-retry' : fullTrial ? 'full' : 'smoke',
+      sourceConversationUnchanged: true,
+    }, null, 2))
+    process.stdout.write(`${JSON.stringify({ ok: true, userDataRoot, trialId: started.trialId, variants: trial.variants.length,
+      committedTurns: trial.variants.reduce((sum, variant) => sum + variant.turns.length, 0),
+      nativeModelRequests: modelRequests.length, mode: hardInterruption ? 'hard-interruption' : cancelRetry ? 'cancel-retry' : checkpointRetry ? 'checkpoint-retry' : fullTrial ? 'full' : 'smoke', sourceConversationUnchanged: true })}\n`)
+  } finally {
+    await running?.shutdown?.shutdown(0)
+    await new Promise(resolveClose => server.close(resolveClose))
+    if (!keepHome) rmSync(userDataRoot, { recursive: true, force: true })
+    else process.stderr.write(`Fixture files retained at ${userDataRoot}\n`)
+  }
+}
+
+run().catch(error => {
+  process.stderr.write(`${error?.stack ?? String(error)}\n`)
+  process.exitCode = 1
+})
