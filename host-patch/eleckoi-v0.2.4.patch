+    }
+
+    if (nestedNativeChild) {
+      if (!tools.includes('eleckoi_read_variables') || tools.includes('eleckoi_apply_variable_patch')) {
+        throw new Error('Nested child did not receive read-only native variable tools')
+      }
+      if (tools.some(name => name.startsWith('rp_team_'))) {
+        throw new Error('Nested native child unexpectedly received RP Team tools')
+      }
+      appendFileSync(logPath, JSON.stringify({
+        fixture: 'nested-native-request', sessionId, provider: options.provider, model: options.model, tools,
+        rpTeamRunId: snapshot.rpTeamRunId, rpTeamRootSessionId: snapshot.rpTeamRootSessionId,
+        rpTeamAgentId: snapshot.rpTeamAgentId, inheritedFromSessionId: snapshot.inheritedFromSessionId,
