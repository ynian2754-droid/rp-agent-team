+async function runColdProfileToggleScenario(initialProfile, baseConfig) {
+  let profile = initialProfile
+  let ctx = profile.ctx
+  let team = ctx.rpAgentTeam
+  assert.ok(team, 'RP Team was not installed before the cold-profile test')
+  const manager = ctx.pluginManager
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team cold profile toggle fixture', baseConfig)
+  const { conversationId, sessionId } = scenario
+  assert.equal(sessionId, conversationId)
+
+  try {
+  const first = await promptOfficialTurn(ctx, sessionId, 'V024_COLD_PROFILE_ON_INITIAL: make one local Team response.')
+  const firstEnd = await waitForCompletedTurn(ctx, sessionId, first.priorEnds, first.afterSeq)
+  await first.work
+  assert.equal(firstEnd.event.data?.reason?.kind, 'completed')
+  const firstRun = (await team.getStatus({ conversationId })).run
+  assert.equal(firstRun.phase, 'complete')
+  assert.equal((await ctx.eleckoiProductData.getProductCommitStatus({ conversationId, runId: firstRun.runId })).outcome,
+    'committed')
+  await profile.shutdown.shutdown(0)
+
+  profile = await startProfile()
+  ctx = profile.ctx
+  team = ctx.rpAgentTeam
+  assert.ok(team, 'RP Team did not mount after reopening the same profile')
+  const reopenedInspection = await ctx.sessionController.inspect(sessionId)
+  assert.equal(reopenedInspection.meta.id, sessionId, 'Cold profile reopen changed the stable root Session identity')
+  let saved = await team.getConfig({ conversationId })
+  assert.equal(saved.enabled, true, 'Team-enabled config did not survive the cold profile reopen')
+  assert.equal((await team.getStatus({ conversationId })).run?.runId, firstRun.runId,
+    'Cold profile reopen lost the completed Team run identity')
+
+  const savedDisabled = await team.saveConfig({ conversationId, expectedRevision: saved.revision, enabled: false, config: saved.config })
+  assert.equal(savedDisabled.enabled, false, 'Saving Team-off did not persist the disabled configuration')
+  const off = await promptOfficialTurn(ctx, sessionId, 'V024_COLD_PROFILE_OFF: ordinary local reply while Team is disabled.')
+  const offEnd = await waitForCompletedTurn(ctx, sessionId, off.priorEnds, off.afterSeq)
+  await off.work
+  assert.equal(offEnd.event.data?.reason?.kind, 'completed')
+  const offMessage = offEnd.inspection.events.find(event => event.type === 'assistant/message'
+    && event.data?.turn === offEnd.event.data?.turn)
+  assert.equal(textOfMessage(offMessage), 'Local observer completed.',
+    'Disabled Team did not route the restarted stable Session through ordinary local chat')
+  const disabledStatus = await team.getStatus({ conversationId })
+  assert.equal((await team.getConfig({ conversationId })).enabled, false,
+    'The Team-off turn ran against an enabled configuration')
+  assert.equal(disabledStatus.run?.runId, firstRun.runId, 'A disabled turn unexpectedly started a Team run')
+  assert.equal(offEnd.inspection.events.filter(event => event.type === 'team/member'
