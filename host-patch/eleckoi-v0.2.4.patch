+async function runReceiptRecoveryScenario(ctx, conversationId, sessionId, turn) {
+  const inspection = await ctx.sessionController.inspect(sessionId)
+  const assistants = inspection.events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === turn && textOfMessage(event) === FIXTURE_BODY)
+  assert.equal(assistants.length, 1, 'Recovery fixture needs one durable assistant event in the selected turn')
+  const world = await ctx.eleckoiStoryState.snapshot({ conversationId })
+  const runId = `rp-team-v024-recovery-${randomUUID()}`
+  await ctx.eleckoiStoryState.stageProductCommit({
+    conversationId, runId, sessionId, turn, baseHash: world.baseHash, operations: [], body: FIXTURE_BODY
+  })
+  const callCount = () => readFileSync(fixtureLog, 'utf8').trim().split(/\r?\n/u)
+    .filter(Boolean).map(line => JSON.parse(line))
+    .filter(row => typeof row.model === 'string' && typeof row.provider === 'string').length
+  const callsBeforeRecovery = callCount()
+  const recovered = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId, runId })
+  assert.equal(recovered.outcome, 'committed', 'Attached recovery did not commit the durable physical Session prefix')
+  assert.equal(recovered.sessionId, sessionId)
+  assert.equal(recovered.turn, turn)
+  assert.equal(recovered.assistantSeq, assistants[0].seq)
+  assert.equal(recovered.assistantMessageId, assistants[0].data?.message?.id)
+  const idempotent = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId, runId })
+  assert.deepEqual(idempotent, recovered, 'Receipt recovery was not idempotent')
+  assert.equal(callCount(), callsBeforeRecovery, 'Receipt recovery must not start a model request')
+
+  const incompleteRunId = `rp-team-v024-incomplete-${randomUUID()}`
+  const incompleteTurn = Math.max(0, ...inspection.events.filter(event => event.type === 'turn/end')
+    .map(event => Number(event.data?.turn) || 0)) + 1
+  await ctx.eleckoiStoryState.stageProductCommit({
+    conversationId, runId: incompleteRunId, sessionId, turn: incompleteTurn,
+    baseHash: world.baseHash, operations: [], body: 'V024_INCOMPLETE_PREFIX_MUST_STAY_PENDING'
+  })
+  const pending = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId, runId: incompleteRunId })
+  assert.equal(pending.outcome, 'pending', 'An incomplete physical prefix must remain pending')
+  await ctx.eleckoiStoryState.settleProductCommit({ conversationId, runId: incompleteRunId, outcome: 'cancelled' })
+  assert.equal(callCount(), callsBeforeRecovery, 'Pending-prefix recovery must not start a model request')
+  return { runId, incompleteRunId, assistantSeq: recovered.assistantSeq }
+}
