+async function runRetryScenario(ctx, team, baseConfig) {
+  const scenario = await createScenarioConversation(ctx, team, 'RP Team failed-run retry fixture', stateFixtureConfig(baseConfig, 'RETRY'))
+  const prompt = await promptOfficialTurn(ctx, scenario.sessionId, 'V024_RETRY_FIXTURE: cause a local actor error, then retry the same user event.')
+  await prompt.work.catch(() => undefined)
+  const failedTurn = await waitForCompletedTurn(ctx, scenario.sessionId, prompt.priorEnds, prompt.afterSeq)
+  assert.notEqual(failedTurn.event.data?.reason?.kind, 'completed', 'The intentional fixture failure unexpectedly completed')
+  const source = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(source?.phase, 'failed', `Source run did not reach failed: ${JSON.stringify(source)}`)
+  assert.equal(source.publication, null, 'A pre-publication model failure must not leave a staged response body')
+  assert.equal(source.productCommitStaged, false, 'A pre-publication model failure must not stage a product commit')
+  assert.equal(source.assistantSeq, undefined, 'A pre-publication failure must not claim a native assistant event')
+  assert.equal(source.assistantMessageId, undefined, 'A pre-publication failure must not claim an assistant ID')
+  assert.match(source.failure ?? '', /V024_INTENTIONAL_ACTOR_FAILURE/u,
+    'A failure without a product receipt must retain the original model error')
+  assert.ok(Number.isSafeInteger(source.inputEventSeq), 'Failed source run did not capture its durable user event')
+  const sourceReceipt = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: source.runId })
+  assert.equal(sourceReceipt.outcome, 'unknown', 'A failure before publication must not fabricate a product receipt')
+  const sourceTrace = await team.getTrace({ conversationId: scenario.conversationId, runId: source.runId })
+  assert.equal(sourceTrace.events.some(event => event.type === 'publication.staged'), false,
+    'A pre-publication failure must never stage a product commit')
+  assert.equal(sourceTrace.events.some(event => event.type === 'publication.committed'), false,
+    'A pre-publication failure must never record a committed publication')
+  const beforeRetry = await ctx.sessionController.inspect(scenario.sessionId)
+  assert.equal(beforeRetry.events.filter(event => event.type === 'assistant/message'
+    && event.data?.turn === failedTurn.event.data?.turn).length, 0,
+  'Failed publication created an assistant message before retry')
+
+  const requestId = `rp-team-v024-retry-${randomUUID()}`
+  const intent = await team.retry({ conversationId: scenario.conversationId, runId: source.runId, requestId })
+  assert.equal(intent.accepted, true)
+  assert.equal(intent.targetEventSeq, source.inputEventSeq)
+  assert.deepEqual(intent.memberIds, ['agent-2'], 'Retry should target only the failed actor and reuse the completed observer')
+  await ctx.eleckoiConversationsApi.regenerateMessage(scenario.conversationId, intent.targetEventSeq, intent.requestId)
+  const ready = await ctx.sessionController.inspect(scenario.sessionId)
+  const readyEnds = ready.events.filter(event => event.type === 'turn/end').length
+  const readySeq = ready.events.at(-1)?.seq ?? -1
+  const started = await ctx.eleckoiConversationsApi.startRegeneration(scenario.conversationId, intent.requestId, false)
+  assert.equal(started.accepted, true)
+  const retryTurn = await waitForCompletedTurn(ctx, scenario.sessionId, readyEnds, readySeq)
+  assert.equal(retryTurn.event.data?.reason?.kind, 'completed',
+    `Official regenerate did not complete the retry: ${JSON.stringify(retryTurn.event.data?.reason)}`)
+  const retry = (await team.getStatus({ conversationId: scenario.conversationId })).run
+  assert.equal(retry?.phase, 'complete')
+  assert.equal(retry.retrySourceRunId, source.runId)
+  assert.equal(retry.members['agent-1'].activations, 0)
+  assert.equal(retry.members['agent-1'].reusedFromRunId, source.runId)
+  assert.equal(retry.members['agent-1'].tokens, undefined)
+  const trace = await team.getTrace({ conversationId: scenario.conversationId, runId: retry.runId })
+  assert.ok(trace.events.some(event => event.type === 'activation.reused' && event.data?.sourceRunId === source.runId))
+  const retryReceipt = await ctx.eleckoiStoryState.getProductCommitStatus({ conversationId: scenario.conversationId, runId: retry.runId })
+  assert.equal(retryReceipt.outcome, 'committed')
+  const world = await ctx.eleckoiStoryState.snapshot({ conversationId: scenario.conversationId })
+  assert.equal(world.variables.fixture.teamFixture, 'observer-world', 'Retry did not replay the completed member’s native world write')
+  const stateDocument = JSON.parse(readFileSync(join(process.env.DSH_HOME, 'plugins', 'rp-agent-team', 'state.json'), 'utf8'))
+  const conversationState = stateDocument.conversations[scenario.conversationId]
+  assert.equal(conversationState.namespaces.shared.observer, 'observer-shared')
+  assert.equal(conversationState.namespaces['private:agent-1'].note, 'observer-private')
+  return { ...scenario, sourceRunId: source.runId, runId: retry.runId, requestId }
+}
