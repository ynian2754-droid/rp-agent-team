+import assert from 'node:assert/strict'
+import { cpSync, existsSync, lstatSync, mkdirSync, readFileSync, realpathSync, unlinkSync, writeFileSync } from 'node:fs'
+import { randomUUID } from 'node:crypto'
+import { createRequire } from 'node:module'
+import { delimiter, dirname, join, resolve } from 'node:path'
+import { loadLayeredEnv, loadProfileDirectory } from '@deepseek-ai/dsh-app-boot'
+import { runProfile } from '@deepseek-ai/dsh/profile-boot'
+import { ELECKOI_INSTALL_ANCHOR } from '@eleckoi/dsh-runtime'
+
+const hostRoot = resolve(import.meta.dirname, '..')
+const sourceUserDataRoot = resolve(valueAfter('--source-user-data-dir')
+  ?? join(hostRoot, '.verification', 'rp-team-v024-root-acceptance3'))
+const userDataRoot = resolve(valueAfter('--user-data-dir') ?? join(
+  hostRoot, '.verification', `rp-team-v024-restore-${Date.now()}-${randomUUID().slice(0, 8)}`
+))
+const runtimeRoot = join(userDataRoot, 'dsh-runtime')
+const home = join(runtimeRoot, 'home')
+const profilePath = join(home, 'profiles', 'desktop')
+const sessionRoot = join(runtimeRoot, 'sessions')
+const workspaceRoot = join(userDataRoot, 'workspace')
+const statePath = join(home, 'plugins', 'rp-agent-team', 'state.json')
+const fixtureLog = join(userDataRoot, 'rp-team-v024-restore-model.jsonl')
+const phasePath = join(userDataRoot, 'rp-team-v024-restore-phase.txt')
+const packageManagerPath = join(dirname(createRequire(import.meta.url).resolve('pnpm')), 'bin', 'pnpm.mjs')
+const nodeBinPath = join(hostRoot, 'resources', 'dsh', 'node-bin')
+
+function valueAfter(name) {
+  const index = process.argv.indexOf(name)
+  return index < 0 ? undefined : process.argv[index + 1]
+}
+
+function hostEnvironment() {
+  return {
+    DSH_HOME: home,
+    DSH_SESSION_ROOT: sessionRoot,
+    DSH_CWD: workspaceRoot,
+    ELECKOI_SESSION_SNAPSHOT_ROOT: join(runtimeRoot, 'session-snapshots'),
+    ELECKOI_PRESET_ROOT: join(runtimeRoot, 'generated-presets'),
+    ELECKOI_SESSION_BRIDGE_ROOT: join(runtimeRoot, 'session-bridges'),
+    ELECKOI_PRESET_TEMPLATE_PATH: join(hostRoot, 'resources', 'dsh', 'agent-preset-template', 'agent.cordis.yml'),
+    ELECKOI_DATABASE_PATH: join(userDataRoot, 'eleckoi-common.sqlite3'),
+    ELECKOI_MEDIA_ROOT: join(userDataRoot, 'media'),
+    ELECKOI_WORKSPACE_ROOT: workspaceRoot,
+    RP_TEAM_V024_FIXTURE_LOG: fixtureLog,
+    RP_TEAM_V024_RESTORE_PHASE_FILE: phasePath,
+    DSH_TELEMETRY_DISABLED: '1'
+  }
+}
+
+function cloneAdapterForDistinctStateWrites() {
+  const adapterPackagePath = join(profilePath, 'node_modules', '@rp-team', 'v024-fixture-llm')
+  assert.ok(existsSync(adapterPackagePath), `The copied profile has no local fixture adapter at ${adapterPackagePath}`)
+  if (lstatSync(adapterPackagePath).isSymbolicLink()) {
+    // Profile package-manager links point outside the copied profile. Break
+    // this one link before changing its deterministic fixture behavior.
+    const sourcePackagePath = realpathSync(adapterPackagePath)
+    unlinkSync(adapterPackagePath)
+    cpSync(sourcePackagePath, adapterPackagePath, { recursive: true, dereference: true })
+  }
+  const adapterPath = join(adapterPackagePath, 'src', 'index.mjs')
+  assert.ok(existsSync(adapterPath), `The copied profile has no local fixture adapter at ${adapterPath}`)
+  let source = readFileSync(adapterPath, 'utf8')
+  source = replaceOnce(source,
+    "import { LlmAdapter } from '@deepseek-ai/dsh-llm'\n",
+    '')
+  source = replaceOnce(source, 'class FixtureAdapter extends LlmAdapter {', 'class FixtureAdapter {')
+  source = replaceOnce(source, 'class FixtureAdapter {', `class FixtureAdapter {
+  providerRetryPolicy() { return undefined }
+  imageRequestPricing() { return undefined }
+  async prepareCall(provider, model, signal) {
+    return { model: await this.resolveModel(provider, model, signal), stream: options => this.stream(options) }
+  }`)
+  source = replaceOnce(source,
+    "const stateFixture = promptText.includes('V024_STATE_FIXTURE') || promptText.includes('V024_RETRY_FIXTURE')",
+    `const stateFixture = promptText.includes('V024_STATE_FIXTURE') || promptText.includes('V024_RETRY_FIXTURE')
+    const phaseFile = process.env.RP_TEAM_V024_RESTORE_PHASE_FILE
+    const restorePhase = phaseFile && existsSync(phaseFile) ? readFileSync(phaseFile, 'utf8').trim() : ''
+    const restoreSuffix = restorePhase ? '-' + restorePhase.toLowerCase() : ''
+    const expectedStateVersion = restorePhase === 'OLD_B' || restorePhase === 'B2' ? 1 : 0`)
+  source = replaceOnce(source,
+    "value: 'observer-shared', expectedVersion: 0",
+    "value: 'observer-shared' + restoreSuffix, expectedVersion: expectedStateVersion")
+  source = replaceOnce(source,
+    "value: 'observer-private', expectedVersion: 0",
+    "value: 'observer-private' + restoreSuffix, expectedVersion: expectedStateVersion")
+  source = replaceOnce(source,
+    "value: 'observer-world' },",
+    "value: 'observer-world' + restoreSuffix },")
+  source = replaceOnce(source,
+    "value: 1 }\n          ] } },",
+    "value: restorePhase === 'A2' ? 2 : restorePhase === 'B2' ? 3 : restorePhase === 'OLD_B' ? 4 : 1 }\n          ] } },")
+  source = replaceOnce(source,
+    "value: 'actor-shared', expectedVersion: 0",
+    "value: 'actor-shared' + restoreSuffix, expectedVersion: expectedStateVersion")
+  writeFileSync(adapterPath, source)
+}
+
+function replaceOnce(source, before, after) {
+  assert.equal(source.split(before).length - 1, 1, `Expected exactly one fixture adapter pattern: ${before}`)
+  return source.replace(before, after)
+}
+
+async function startProfile() {
+  const runtimeEnvironment = hostEnvironment()
+  Object.assign(process.env, runtimeEnvironment)
+  const profile = loadProfileDirectory('dsh', profilePath, ELECKOI_INSTALL_ANCHOR)
+  assert.deepEqual(profile.skippedBundles, [], `Host profile skipped bundles: ${JSON.stringify(profile.skippedBundles)}`)
+  const environment = { ...loadLayeredEnv('dsh'), ...runtimeEnvironment }
+  return runProfile({
+    environment,
+    profile: 'desktop',
+    resolvedProfile: { profile, installAnchor: ELECKOI_INSTALL_ANCHOR },
+    patchFiles: [join(userDataRoot, 'rp-team-v024-profile.patch.yml'),
+      join(hostRoot, 'resources', 'dsh', 'desktop-agent.patch.yml')],
+    args: ['--no-open', '--port', '0'],
+    packageManager: {
+      command: process.execPath,
+      args: ['--expose-internals', packageManagerPath],
+      env: {
+        ...process.env,
+        ...environment,
+        ELECTRON_RUN_AS_NODE: '1',
+        DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+        PATH: `${nodeBinPath}${delimiter}${process.env.PATH ?? ''}`
+      }
+    }
+  })
+}
+
+function readStateDocument() {
+  return JSON.parse(readFileSync(statePath, 'utf8'))
+}
+
+function committedProjection(conversation) {
+  return {
+    revision: conversation?.revision ?? 0,
+    namespaces: conversation?.namespaces ?? {},
+    pathVersions: conversation?.pathVersions ?? {}
+  }
+}
+
+function worldProjection(world) {
+  return { variables: world?.variables ?? {}, settings: world?.settings ?? {} }
+}
+
+function eventText(event) {
+  return (event?.data?.message?.content ?? []).filter(part => part?.type === 'text')
+    .map(part => String(part.text ?? '')).join('').trim()
+}
+
+async function waitForTurnEnd(ctx, sessionId, previousEndCount, afterSeq) {
+  const deadline = Date.now() + 90_000
+  while (Date.now() < deadline) {
+    const inspection = await ctx.sessionController.inspect(sessionId)
+    const turns = inspection.events.filter(event => event.type === 'turn/end')
+    const event = turns.find(item => item.seq > afterSeq)
+    if (turns.length > previousEndCount && event) return { inspection, event }
+    await new Promise(resolve => setTimeout(resolve, 100))
+  }
+  throw new Error(`Timed out waiting for the official Session ${sessionId} to finish a turn`)
+}
+
+async function promptOfficialTurn(ctx, sessionId, text) {
+  const before = await ctx.sessionController.inspect(sessionId)
+  const prepared = await ctx.eleckoiConversationsApi.preparePrompt(sessionId, text)
+  assert.equal(prepared.runtimeSessionId, sessionId)
+  const requestId = `rp-team-restore-${randomUUID()}`
+  const work = ctx.sessionController.prompt({
+    sessionId, requestId, mode: 'queue', content: [{ type: 'text', text }]
+  }, AbortSignal.timeout(90_000))
+  await work
+  const completed = await waitForTurnEnd(ctx, sessionId,
+    before.events.filter(event => event.type === 'turn/end').length,
+    before.events.at(-1)?.seq ?? -1)
+  assert.equal(completed.event.data?.reason?.kind, 'completed',
+    `Local fixture turn failed: ${JSON.stringify(completed.event.data?.reason)}`)
+  return completed
+}
+
+async function saveActorTemperature(team, conversationId, temperature) {
+  const current = await team.getConfig({ conversationId })
+  const config = structuredClone(current.config)
+  const actor = config.agents.find(item => item.id === 'agent-2')
+  assert.ok(actor, 'The state fixture has no configured actor')
+  actor.parameters.temperature = temperature
+  return team.saveConfig({ conversationId, expectedRevision: current.revision, enabled: true, config })
+}
+
+async function rewindAt(ctx, conversationId, eventSeq, label) {
+  const requestId = `rp-team-restore-${label}-${randomUUID()}`
+  await ctx.eleckoiConversationsApi.regenerateMessage(conversationId, eventSeq, requestId)
+  const result = await ctx.sessionController.inspect(conversationId)
+  return { requestId, inspection: result }
+}
+
+async function regenerateAndWait(ctx, conversationId, requestId) {
+  const before = await ctx.sessionController.inspect(conversationId)
+  const previousEndCount = before.events.filter(event => event.type === 'turn/end').length
+  const afterSeq = before.events.at(-1)?.seq ?? -1
+  const started = await ctx.eleckoiConversationsApi.startRegeneration(conversationId, requestId, false)
+  assert.equal(started.accepted, true, `Official regeneration was rejected: ${JSON.stringify(started)}`)
+  const completed = await waitForTurnEnd(ctx, conversationId, previousEndCount, afterSeq)
+  assert.equal(completed.event.data?.reason?.kind, 'completed',
+    `Official regeneration failed: ${JSON.stringify(completed.event.data?.reason)}`)
+  return completed
+}
+
+function readFixtureRows() {
+  if (!existsSync(fixtureLog)) return []
+  return readFileSync(fixtureLog, 'utf8').split(/\r?\n/u).filter(Boolean).map(line => JSON.parse(line))
+}
+
+function assertFixtureParameter(temperature, description) {
+  assert.ok(readFixtureRows().some(row => row.model === 'actor' && row.parameters?.temperature === temperature),
+    `${description} did not reach the actual native actor request`)
+}
+
+async function main() {
+  assert.ok(existsSync(sourceUserDataRoot), `Source acceptance profile not found: ${sourceUserDataRoot}`)
+  assert.ok(existsSync(join(sourceUserDataRoot, 'eleckoi-common.sqlite3')), 'Source profile has no test SQLite database')
+  assert.notEqual(userDataRoot, sourceUserDataRoot, 'The restore fixture must never boot the source profile in place')
+  if (existsSync(userDataRoot)) throw new Error(`Restore fixture destination already exists: ${userDataRoot}`)
+  mkdirSync(dirname(userDataRoot), { recursive: true })
+  cpSync(sourceUserDataRoot, userDataRoot, { recursive: true })
+  cloneAdapterForDistinctStateWrites()
+  writeFileSync(phasePath, 'BASE')
+
+  const initialJournal = readStateDocument()
+  const stateRuns = Object.entries(initialJournal.conversations ?? {}).flatMap(([conversationId, conversation]) =>
+    Object.entries(conversation.runs ?? {}).map(([runId, run]) => ({ conversationId, runId, run })))
+    .filter(({ run }) => run.status === 'committed'
+      && run.config?.agents?.[1]?.systemPrompt?.includes('V024_STATE_FIXTURE')
+      && run.priorCommittedState && run.state?.world)
+  assert.equal(stateRuns.length, 1, 'Expected exactly one committed state-fixture source run in the acceptance profile')
+  const [{ conversationId, runId: originalARunId, run: originalStoredRun }] = stateRuns
+  const baselineState = structuredClone(originalStoredRun.priorCommittedState)
+  const baselineWorld = structuredClone(originalStoredRun.state.world)
+  const sessionId = conversationId
+
+  const profile = await startProfile()
+  try {
+    const ctx = profile.ctx
+    const team = ctx.rpAgentTeam
+    assert.ok(team, 'RP Team did not load from the copied acceptance profile')
+    const originalStatus = (await team.getTrace({ conversationId, runId: originalARunId }))
+    assert.equal(originalStatus.phase, 'complete')
+    assert.ok(Number.isSafeInteger(originalStatus.inputEventSeq))
+    assert.ok(originalStatus.productMessageId)
+    const originalInspection = await ctx.sessionController.inspect(sessionId)
+    assert.equal(originalInspection.meta.id, sessionId, 'The cloned profile changed the stable root Session id')
+    const initialProductWorld = await ctx.eleckoiStoryState.snapshot({ conversationId })
+    assert.equal(initialProductWorld.variables.fixture.teamFixture, 'observer-world')
+
+    // Add a later committed run so the first restore has to remove A and B from
+    // the active branch, then replay A under a changed configuration.
+    writeFileSync(phasePath, 'OLD_B')
+    const oldBTurn = await promptOfficialTurn(ctx, sessionId, 'V024_STATE_FIXTURE restore branch B original.')
+    const oldBStatus = (await team.getStatus({ conversationId })).run
+    assert.equal(oldBStatus.phase, 'complete')
+    assert.notEqual(oldBStatus.runId, originalARunId)
+    const oldBRunId = oldBStatus.runId
+    const afterOldBState = readStateDocument().conversations[conversationId]
+    assert.equal(afterOldBState.namespaces.shared.observer, 'observer-shared-old_b')
+    assert.equal(afterOldBState.namespaces.shared.actor, 'actor-shared-old_b')
+
+    const firstRewind = await rewindAt(ctx, conversationId, originalStatus.inputEventSeq, 'A')
+    assert.ok(!firstRewind.inspection.events.some(event => event.type === 'assistant/message'
+      && event.data?.message?.id === originalStatus.assistantMessageId),
+    'First rewind retained A’s assistant output in active Session history')
+    assert.deepEqual(committedProjection(readStateDocument().conversations[conversationId]), baselineState,
+      'Rewinding A did not restore shared/private state to the pre-A checkpoint')
+    assert.deepEqual(worldProjection(await ctx.eleckoiStoryState.snapshot({ conversationId})), worldProjection(baselineWorld),
+      'Rewinding A did not restore the pre-A world snapshot')
+    assert.ok((await team.getTrace({ conversationId, runId: originalARunId })).events
+      .some(event => event.type === 'publication.rewound'), 'The original A trace was not marked rewound')
+    assert.ok((await team.getTrace({ conversationId, runId: oldBRunId })).events
+      .some(event => event.type === 'publication.rewound'), 'The later original B trace was not marked rewound')
+
+    const changedA2Config = await saveActorTemperature(team, conversationId, 0.47)
+    assert.ok(changedA2Config.revision > 1, 'Saving the post-restore configuration did not advance its revision')
+    writeFileSync(phasePath, 'A2')
+    const a2Turn = await regenerateAndWait(ctx, conversationId, firstRewind.requestId)
+    const a2Status = (await team.getStatus({ conversationId })).run
+    assert.equal(a2Status.phase, 'complete')
+    assert.notEqual(a2Status.runId, originalARunId)
+    assert.ok(a2Turn.inspection.events.some(event => event.type === 'user/message'
+      && event.seq === a2Status.inputEventSeq && event.data?.id === a2Status.inputMessageId),
+    'The regenerated A2 run was not correlated to its durable user input')
+    let stateAfterA2 = readStateDocument().conversations[conversationId]
+    assert.equal(stateAfterA2.namespaces.shared.observer, 'observer-shared-a2')
+    assert.equal(stateAfterA2.namespaces.shared.actor, 'actor-shared-a2')
+    assert.equal(stateAfterA2.namespaces['private:agent-1'].note, 'observer-private-a2')
+    let worldAfterA2 = await ctx.eleckoiStoryState.snapshot({ conversationId })
+    assert.equal(worldAfterA2.variables.fixture.teamFixture, 'observer-world-a2')
+    assert.equal(worldAfterA2.variables.fixture.actorCount, 2)
+    assertFixtureParameter(0.47, 'The modified A2 configuration')
+    const a2Trace = await team.getTrace({ conversationId, runId: a2Status.runId })
+    assert.ok(a2Trace.events.some(event => event.type === 'publication.committed'))
+    assert.ok(!a2Trace.events.some(event => event.type === 'publication.rewound'))
+
+    await saveActorTemperature(team, conversationId, 0.62)
+    writeFileSync(phasePath, 'B2')
+    const b2Turn = await promptOfficialTurn(ctx, sessionId, 'V024_STATE_FIXTURE restore branch B2 after config update.')
+    const b2Status = (await team.getStatus({ conversationId })).run
+    assert.equal(b2Status.phase, 'complete')
+    assert.notEqual(b2Status.runId, a2Status.runId)
+    assert.ok(b2Status.inputEventSeq > a2Status.inputEventSeq)
+    const stateAfterB2 = readStateDocument().conversations[conversationId]
+    assert.equal(stateAfterB2.namespaces.shared.observer, 'observer-shared-b2')
+    assert.equal(stateAfterB2.namespaces.shared.actor, 'actor-shared-b2')
+    assert.equal(stateAfterB2.namespaces['private:agent-1'].note, 'observer-private-b2')
+    const worldAfterB2 = await ctx.eleckoiStoryState.snapshot({ conversationId })
+    assert.equal(worldAfterB2.variables.fixture.teamFixture, 'observer-world-b2')
+    assert.equal(worldAfterB2.variables.fixture.actorCount, 3)
+    assertFixtureParameter(0.62, 'The second post-restore configuration')
+
+    const secondRewind = await rewindAt(ctx, conversationId, b2Status.inputEventSeq, 'B2')
+    stateAfterA2 = readStateDocument().conversations[conversationId]
+    worldAfterA2 = await ctx.eleckoiStoryState.snapshot({ conversationId })
+    assert.equal(stateAfterA2.namespaces.shared.observer, 'observer-shared-a2',
+      'Repeated rewind selected a stale, already-rewound run instead of the active A2 checkpoint')
+    assert.equal(stateAfterA2.namespaces.shared.actor, 'actor-shared-a2')
+    assert.equal(stateAfterA2.namespaces['private:agent-1'].note, 'observer-private-a2')
+    assert.equal(worldAfterA2.variables.fixture.teamFixture, 'observer-world-a2')
+    assert.equal(worldAfterA2.variables.fixture.actorCount, 2)
+    assert.ok((await team.getTrace({ conversationId, runId: b2Status.runId })).events
+      .some(event => event.type === 'publication.rewound'), 'Second restore did not mark B2 as rewound')
+    assert.ok(!(await team.getTrace({ conversationId, runId: a2Status.runId })).events
+      .some(event => event.type === 'publication.rewound'), 'Second restore incorrectly rewound A2')
+
+    const finalInspection = await ctx.sessionController.inspect(sessionId)
+    assert.ok(finalInspection.events.some(event => event.type === 'assistant/message'
+      && event.data?.message?.id === a2Status.assistantMessageId), 'Repeated restore lost A2 from the official Session history')
+    assert.ok(!finalInspection.events.some(event => event.type === 'assistant/message'
+      && event.data?.message?.id === b2Status.assistantMessageId), 'Repeated restore retained B2 assistant output in active history')
+    assert.ok(finalInspection.events.some(event => event.type === 'user/message'
+      && event.data?.id === a2Status.inputMessageId), 'Repeated restore lost the active A2 user input')
+    assert.ok(!finalInspection.events.some(event => event.type === 'user/message'
+      && event.data?.id === b2Status.inputMessageId), 'Repeated restore retained B2 user input in active history')
+    const historyTexts = finalInspection.events.filter(event => event.type === 'assistant/message')
+      .map(eventText).join('\n')
+    assert.ok(historyTexts.includes('V024_LOCAL_FIXTURE_PUBLICATION'), 'Active history no longer includes A2 publication text')
+
+    const traces = await team.listTraces({ conversationId })
+    for (const id of [originalARunId, oldBRunId, a2Status.runId, b2Status.runId]) {
+      assert.ok(traces.some(trace => trace.runId === id), `Trace ${id} disappeared after repeated restore`)
+    }
+    const fixtureRequests = readFixtureRows().filter(row => row.provider)
+    assert.ok(fixtureRequests.length > 0, 'Restore/regenerate did not call the local fixture adapter')
+    assert.ok(fixtureRequests.every(row => row.provider === 'rp-team-v024-fixture'),
+      'Restore acceptance invoked a non-fixture model provider')
+    assert.equal(fixtureRequests.some(row => row.model === 'root'), false,
+      'Team root delivery unexpectedly called a model instead of the local delivery adapter')
+
+    process.stdout.write(`${JSON.stringify({
+      ok: true,
+      sourceUserDataRoot,
+      isolatedUserDataRoot: userDataRoot,
+      conversationId,
+      stableSessionId: sessionId,
+      originalARunId,
+      originalBRunId: oldBRunId,
+      replayedARunId: a2Status.runId,
+      replayedBRunId: b2Status.runId,
+      firstRestoreEventSeq: originalStatus.inputEventSeq,
+      secondRestoreEventSeq: b2Status.inputEventSeq,
+      retainedA2AssistantMessageId: a2Status.assistantMessageId,
+      removedB2AssistantMessageId: b2Status.assistantMessageId,
+      postSecondRestoreWorld: worldAfterA2.variables,
+      fixtureProviderCalls: fixtureRequests.length
+    }, null, 2)}\n`)
+    void oldBTurn
+    void a2Turn
+    void b2Turn
+  } finally {
+    await profile.shutdown.shutdown(0)
+  }
+}
+
+try {
+  await main()
+} catch (error) {
+  process.stderr.write(`${error?.stack ?? String(error)}\n`)
+  process.exitCode = 1
+}
