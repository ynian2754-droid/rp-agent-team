+
+function applySettingOperation(library, operation) {
+  if (!library || operation.op !== 'write_file' || typeof operation.content !== 'string') {
+    throw new Error('设定库只支持对现有虚拟文件写入文本。')
+  }
+  const matches = library.entries.filter(entry => settingPath(library, entry) === operation.path)
+  if (matches.length !== 1) throw new Error(`找不到唯一的设定虚拟文件：${operation.path}`)
+  matches[0].content = operation.content
