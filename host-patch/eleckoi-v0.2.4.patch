+      if (!/^(0|[1-9]\d*)$/u.test(segment) || Number(segment) >= current.length) return false
+      current = current[Number(segment)]
+    } else if (current && typeof current === 'object' && Object.hasOwn(current, segment)) current = current[segment]
+    else return false
+  }
+  return true
+}
+
+async function nativeSessionBusy(ctx, sessionId) {
+  const resolved = await ctx.sessionController.resolveAgent(sessionId)
+  if ('error' in resolved) {
+    if (isMissingSession(resolved.error)) return false
+    throw resolved.error
+  }
+  return resolved.agent.status !== 'idle'
+}
+
+async function currentSessionAnchor(ctx, productData, conversationId) {
+  const sessionId = productData.runtimeSessionId(conversationId)
+  const inspection = await ctx.sessionController.inspect(sessionId)
+  return sessionAnchor(sessionId, inspection.events ?? [])
+}
+
+function sessionAnchor(sessionId, events) {
+  const latest = [...events].reverse().find((event) => (event.type === 'user/message' || event.type === 'assistant/message')
+    && Number.isSafeInteger(event.seq))
+  if (!latest) return { sessionId }
+  const message = latest.data?.message
+  const anchor = { sessionId, eventSeq: latest.seq }
+  if (Number.isSafeInteger(latest.data?.turn)) anchor.turn = latest.data.turn
+  if (typeof message?.id === 'string' && message.id) anchor.messageId = message.id
+  else if (typeof latest.data?.id === 'string' && latest.data.id) anchor.messageId = latest.data.id
