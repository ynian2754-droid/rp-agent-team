+++ b/tests/dsh-story-state-author-gate.test.mjs
@@ -0,0 +1,100 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { installStoryState } from '../packages/dsh-client-roleplay/src/host/story-state.mjs'
+
+test('roleplay and Team share the root Session work id with independent leases', async () => {
+  const { service, dispose } = createStoryState()
+  try {
+    await service.beginConversationWork({ conversationId: 'conversation-1', kind: 'roleplay', workId: 'session-1' })
+    await service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'session-1' })
+    assert.equal(await service.isConversationBusy({ conversationId: 'conversation-1' }), true)
+    await assert.rejects(
+      service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'other-session' }),
+      { code: 'ELECKOI_CONVERSATION_BUSY' }
+    )
+
+    service.endConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'session-1' })
+    assert.equal(await service.isConversationBusy({ conversationId: 'conversation-1' }), true)
+    service.endConversationWork({ conversationId: 'conversation-1', kind: 'roleplay', workId: 'session-1' })
+    assert.equal(await service.isConversationBusy({ conversationId: 'conversation-1' }), false)
+  } finally {
+    dispose()
+  }
+})
+
+test('conversation work reservation closes concurrent claims while the native idle check is pending', async () => {
+  let releaseIdleCheck
+  const { service, dispose } = createStoryState({
+    resolveAgent: () => new Promise(resolve => { releaseIdleCheck = resolve })
+  })
+  try {
+    const claim = service.beginConversationWork({ conversationId: 'conversation-1', kind: 'roleplay', workId: 'session-1' })
+    await assert.rejects(
+      service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'other-session' }),
+      { code: 'ELECKOI_CONVERSATION_BUSY' }
+    )
+    releaseIdleCheck({ agent: { status: 'idle' } })
+    assert.equal((await claim).claimed, true)
+    service.endConversationWork({ conversationId: 'conversation-1', kind: 'roleplay', workId: 'session-1' })
+  } finally {
+    dispose()
+  }
+})
+
+test('native activity and unresolved author receipts block new Team work', async () => {
+  const { service, dispose, setNativeStatus } = createStoryState()
+  try {
+    setNativeStatus('running')
+    await assert.rejects(
+      service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'session-1' }),
+      { code: 'ELECKOI_CONVERSATION_BUSY' }
+    )
+    setNativeStatus('idle')
+    service.setAuthorEditPending({ conversationId: 'conversation-1', operationId: 'edit-1', pending: true })
+    await assert.rejects(
+      service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'session-1' }),
+      { code: 'ELECKOI_AUTHOR_EDIT_PENDING' }
+    )
+    service.setAuthorEditPending({ conversationId: 'conversation-1', operationId: 'edit-1', pending: false })
+    assert.equal((await service.beginConversationWork({ conversationId: 'conversation-1', kind: 'team', workId: 'session-1' })).claimed, true)
+  } finally {
+    dispose()
+  }
+})
+
+function createStoryState({ resolveAgent } = {}) {
+  let status = 'idle'
+  let resolveCalls = 0
+  const productData = {
+    prepareConversationRuntime() {
+      return {
+        conversationContext: { characterName: 'Aster', settingLibrary: null },
+        variableContext: { stateJson: '{}', initialStateJson: '{}' }
+      }
+    },
+    snapshotConversationRuntime() { return { variableStateJson: '{}' } },
+    runtimeSessionId() { return 'session-1' }
+  }
+  let service
+  const ctx = {
+    eleckoiProductData: productData,
+    sessionController: {
+      resolveAgent(sessionId) {
+        assert.equal(sessionId, 'session-1')
+        resolveCalls += 1
+        return resolveAgent ? resolveAgent(resolveCalls) : Promise.resolve({ agent: { status } })
+      },
+      async inspect() { return { events: [] } }
+    },
+    provide(name, value) {
+      assert.equal(name, 'eleckoiStoryState')
+      service = value
+    }
+  }
+  const installed = installStoryState(ctx)
+  return {
+    service: service ?? installed.service,
+    dispose: () => installed.dispose(),
+    setNativeStatus(value) { status = value }
+  }
+}
