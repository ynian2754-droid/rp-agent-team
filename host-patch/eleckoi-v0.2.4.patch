+    expect(done[1].callId).toBe('call')
+  })
+  it('leaves models without reasoning and ordinary prose alone', () => {
+    expect(assistantReasoningBlocks([{ kind: 'text', text: 'ordinary reply' }])).toEqual([{ kind: 'text', text: 'ordinary reply' }])
