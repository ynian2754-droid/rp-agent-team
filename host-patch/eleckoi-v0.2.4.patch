+import { ELECKOI_DESKTOP_BUNDLES, ELECKOI_INSTALL_ANCHOR, registerDesktopBundles } from '@eleckoi/dsh-runtime'
+import { installLegacyMigration } from '../packages/dsh-client-roleplay/src/host/legacy-migration.mjs'
+
+const hostRoot = resolve(import.meta.dirname, '..')
+const require = createRequire(import.meta.url)
+const valueAfter = name => {
+  const index = process.argv.indexOf(name)
+  return index < 0 ? undefined : process.argv[index + 1]
+}
+const sha256 = path => createHash('sha256').update(readFileSync(path)).digest('hex')
+const readJson = path => JSON.parse(readFileSync(path, 'utf8'))
+const saveJson = (path, value) => writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`)
+let migrationAttemptStarted = false
+
+async function main() {
+  const userDataArg = valueAfter('--user-data-dir')
+  const exportArg = valueAfter('--export-dir')
+  const bundleArg = valueAfter('--team-bundle')
+  if (!userDataArg || !exportArg || !bundleArg) {
+    throw new Error('Usage: migrate-v024-userdata.mjs --user-data-dir <stopped userData copy> --export-dir <private legacy export> --team-bundle <0.2.1.tgz>')
+  }
+  const userData = resolve(userDataArg)
+  const exportRoot = resolve(exportArg)
+  const bundlePath = resolve(bundleArg)
+  const manifestPath = join(exportRoot, 'manifest.json')
+  const manifest = readJson(manifestPath)
+  if (manifest.format !== 'eleckoi.v024-legacy-userdata-export' || manifest.version !== 1 || !manifest.source?.readOnly) {
+    throw new Error('The input must be a verified read-only legacy export.')
+  }
+  const databasePath = join(userData, 'eleckoi-common.sqlite3')
+  const progressPath = join(userData, 'v024-migration-progress.json')
+  const mapPath = join(exportRoot, 'rp-team-v024-legacy-map.json')
+  const mapHash = sha256(mapPath)
+  const progress = existsSync(progressPath) ? readJson(progressPath) : undefined
+  if (progress) {
+    if (progress.userData !== userData || progress.mapSha256 !== mapHash
+      || progress.sourceDatabaseSha256 !== manifest.source.databaseSha256) {
+      throw new Error('This migration journal belongs to a different userData/export pair.')
+    }
+    if (existsSync(`${databasePath}-wal`) || sha256(databasePath) !== (progress.databaseSha256 ?? progress.sourceDatabaseSha256)) {
+      throw new Error('The database changed after the recorded migration checkpoint. Stop the host and restore the verified backup before retrying.')
+    }
+    if (progress.phase === 'complete' && progress.bundleSha256 === sha256(bundlePath)) {
+      process.stdout.write(`${JSON.stringify({ ok: true, alreadyComplete: true, userData, bundleSha256: progress.bundleSha256, previousResult: progress.result }, null, 2)}\n`)
+      return
+    }
+  } else {
+    if (sha256(databasePath) !== manifest.source.databaseSha256) {
+      throw new Error('The userData database does not match the exported backup. Do not open a newer host before exporting.')
+    }
+    saveJson(progressPath, {
+      format: 'eleckoi.v024-migration-progress', version: 1, userData,
+      mapSha256: mapHash, sourceDatabaseSha256: manifest.source.databaseSha256,
+      startedAt: new Date().toISOString(), phase: 'started'
+    })
+  }
+  migrationAttemptStarted = true
+  saveJson(progressPath, { ...readJson(progressPath), phase: 'started' })
+  const bundleHash = sha256(bundlePath)
+  const bundleCache = join(userData, 'migration-bundles')
+  mkdirSync(bundleCache, { recursive: true })
+  const installBundlePath = join(bundleCache, `rp-team-dsh-roleplay-team-0.2.1-${bundleHash.slice(0, 12)}.tgz`)
+  if (!existsSync(installBundlePath)) copyFileSync(bundlePath, installBundlePath)
+  if (sha256(installBundlePath) !== bundleHash) throw new Error('The archived migration bundle hash does not match.')
+
+  const runtimeRoot = join(userData, 'dsh-runtime')
+  const home = join(runtimeRoot, 'home')
+  const profilePath = join(home, 'profiles', 'desktop')
+  const profileManifest = join(profilePath, 'package.json')
+  if (existsSync(profileManifest)) {
+    const old = readJson(profileManifest)
+    const reference = old.dependencies?.['@rp-team/dsh-roleplay-team'] ?? ''
+    if (/0\.2\.0(?:[-.]|\.tgz|$)/u.test(reference)) {
+      const destination = join(userData, 'migration-backup', 'desktop-profile-v021')
+      const offset = relative(userData, destination)
+      if (!offset || offset === '..' || offset.startsWith(`..${sep}`) || existsSync(destination)) {
+        throw new Error('Cannot archive the old profile at the expected userData-local backup path.')
+      }
+      mkdirSync(dirname(destination), { recursive: true })
+      renameSync(profilePath, destination)
+    }
+  }
+  initProfile(profilePath, [...PROFILE_TEMPLATES.web.bundles, ...ELECKOI_DESKTOP_BUNDLES, '@eleckoi/dsh-web-search-tavily'])
+  registerDesktopBundles(profilePath)
+  const workspace = join(userData, 'workspace')
+  mkdirSync(workspace, { recursive: true })
+  const environment = {
+    DSH_HOME: home,
+    DSH_SESSION_ROOT: join(runtimeRoot, 'sessions'),
+    DSH_CWD: workspace,
+    ELECKOI_SESSION_SNAPSHOT_ROOT: join(runtimeRoot, 'session-snapshots'),
+    ELECKOI_PRESET_ROOT: join(runtimeRoot, 'generated-presets'),
+    ELECKOI_SESSION_BRIDGE_ROOT: join(runtimeRoot, 'session-bridges'),
+    ELECKOI_PRESET_TEMPLATE_PATH: join(hostRoot, 'resources', 'dsh', 'agent-preset-template', 'agent.cordis.yml'),
+    ELECKOI_DATABASE_PATH: databasePath,
+    ELECKOI_MEDIA_ROOT: join(userData, 'media'),
+    ELECKOI_WORKSPACE_ROOT: workspace,
+    DSH_TELEMETRY_DISABLED: '1'
+  }
+  Object.assign(process.env, environment)
+  const patchPath = join(userData, 'v024-migration.patch.yml')
+  writeFileSync(patchPath, '- id: desktop-product-telemetry\n  disabled: true\n- id: product-analytics\n  disabled: true\n')
+  const nodeBin = join(hostRoot, 'resources', 'dsh', 'node-bin')
+  const boot = async () => {
+    const profile = loadProfileDirectory('dsh', profilePath, ELECKOI_INSTALL_ANCHOR)
+    if (profile.skippedBundles.length) throw new Error('The migration profile could not resolve its selected host bundles.')
+    return runProfile({
+    environment: { ...loadLayeredEnv('dsh'), ...environment },
+    profile: 'desktop',
+    resolvedProfile: { profile, installAnchor: ELECKOI_INSTALL_ANCHOR },
+    patchFiles: [patchPath, join(hostRoot, 'resources', 'dsh', 'desktop-agent.patch.yml')],
+    args: ['--no-open', '--port', '0'],
+    packageManager: {
+      command: process.execPath,
+      args: ['--expose-internals', join(dirname(require.resolve('pnpm')), 'bin', 'pnpm.mjs')],
+      env: {
+        ...process.env, ELECTRON_RUN_AS_NODE: '1', DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+        PATH: `${nodeBin}${delimiter}${process.env.PATH ?? ''}`
+      }
+    }
+    })
+  }
+  let running = await boot()
+  let ctx = running.ctx
+  const guardModels = context => context.on('llm/stream', (options, next) => {
+    if (!options.provider?.startsWith('eleckoi-history-import-')) {
+      throw new Error('The migration command does not permit external model requests.')
+    }
+    return next()
+  }, { global: true, prepend: true })
+  let blockExternal = guardModels(ctx)
+  let result
+  try {
+    const bundleName = '@rp-team/dsh-roleplay-team'
+    const current = (await ctx.pluginManager.listBundles()).find(row => row.name === bundleName && row.installed)
+    const reference = readJson(profileManifest).dependencies?.[bundleName]
+    const installedArchive = reference?.startsWith('file:') ? resolve(profilePath, reference.slice(5)) : undefined
+    const sameBundle = current?.version === '0.2.1' && installedArchive === installBundlePath
+      && existsSync(installedArchive) && sha256(installedArchive) === bundleHash
+    if (sameBundle) {
+      if (!current.enabled) {
+        const enabled = await ctx.pluginManager.setBundleEnabled(bundleName, true)
+        if (enabled.application !== 'applied') throw new Error(`Could not enable the migration bundle: ${JSON.stringify(enabled)}`)
+      }
+    } else {
+      const installed = await ctx.pluginManager.installBundle(installBundlePath)
+      if (!['applied', 'restart-required'].includes(installed.application) || installed.bundle !== bundleName) {
+        throw new Error(`The RP Team migration bundle could not be installed: ${JSON.stringify(installed)}`)
+      }
+      if (installed.application === 'restart-required') {
+        blockExternal()
+        await running.shutdown.shutdown(0)
+        running = await boot()
+        ctx = running.ctx
+        blockExternal = guardModels(ctx)
+        const upgraded = (await ctx.pluginManager.listBundles()).find(row => row.name === bundleName)
+        if (!upgraded?.installed || !upgraded.enabled || upgraded.version !== '0.2.1' || !ctx.get('rpAgentTeam')) {
+          throw new Error('The upgraded RP Team bundle did not mount after the required host restart.')
+        }
+      }
+    }
+    await ctx.plugin({
+      name: 'eleckoi-v024-legacy-migration-command',
+      inject: [
+        'eleckoiProductData', 'eleckoiRoleplaySessions', 'eleckoiRuntimeExtensions', 'rpAgentTeam',
+        'sessionController', 'sessions', 'llm', 'attachments', 'fileUploads',
+        'settings', 'credentials', 'agentDefaultModel'
+      ],
+      apply(migrationCtx) { installLegacyMigration(migrationCtx) }
+    })
+    const migration = ctx.get('eleckoiLegacyMigration')
+    if (!migration) throw new Error('The legacy migration service did not mount.')
+    result = await migration.importExport({ mapPath })
+  } finally {
+    blockExternal()
+    await running.shutdown.shutdown(0)
+  }
+  const completed = {
+    ...readJson(progressPath), phase: 'complete', completedAt: new Date().toISOString(),
+    bundleSha256: sha256(bundlePath), databaseSha256: sha256(databasePath), result
+  }
+  saveJson(progressPath, completed)
+  process.stdout.write(`${JSON.stringify({ ok: true, userData, bundleSha256: completed.bundleSha256, ...result }, null, 2)}\n`)
+}
+
+try { await main() }
+catch (error) {
+  const userDataArg = valueAfter('--user-data-dir')
+  if (migrationAttemptStarted && userDataArg) {
+    const progressPath = join(resolve(userDataArg), 'v024-migration-progress.json')
+    const databasePath = join(resolve(userDataArg), 'eleckoi-common.sqlite3')
+    if (existsSync(progressPath) && existsSync(databasePath) && !existsSync(`${databasePath}-wal`)) {
+      const progress = readJson(progressPath)
+      if (progress.phase !== 'complete') saveJson(progressPath, {
+        ...progress, phase: 'failed', failedAt: new Date().toISOString(), databaseSha256: sha256(databasePath)
+      })
+    }
+  }
+  process.stderr.write(`${error?.stack ?? String(error)}\n`)
+  process.exitCode = 1
+}
diff --git a/scripts/rp-team-authoring-fixture.mjs b/scripts/rp-team-authoring-fixture.mjs
new file mode 100644
index 0000000..62b9f8f
--- /dev/null
+++ b/scripts/rp-team-authoring-fixture.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict'
+import { randomUUID } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+
+export const AUTHOR_ADAPTER_STEPS = String.raw`
+    if (promptText.includes('V030_AUTHOR_FIXTURE')) {
+      if (options.model === 'author-requester') {
+        const resumed = promptText.includes('handoff_result') || promptText.includes('TARGET_RESULT');
+        if (step === 0 && !resumed) {
+          yield* emitCalls([{name:'rp_team_request',args:{to:'author-target',handoffId:'lookup',summary:'LOOKUP',data:{query:'window'},reason:'authoring fixture'}}]); return;
+        }
+        if (!promptText.includes('TARGET_RESULT') && !promptText.includes('V030_MODE_RESUME')) throw new Error('Await result missing from same native Session request');
+        if (promptText.includes('PRIVATE_RESPONSE_SECRET')) throw new Error('Response selector leaked an omitted field');
+        if (step === 1 || resumed && step === 0) { yield* emitCalls([{name:'rp_team_submit_internal',args:{summary:resumed?'REQUESTER_RESUMED':'REQUESTER_CONTINUED',data:{ready:true}}}]); return; }
+      } else if (options.model === 'author-target') {
+        if (step === 0) { yield* emitCalls([{name:'rp_team_submit_internal',args:{summary:'TARGET_RESULT',data:{answer:'window is open',secret:'PRIVATE_RESPONSE_SECRET'}}}]); return; }
+      } else if (options.model === 'author-publisher' && step === 0) {
+        yield* emitCalls([{name:'rp_team_publish',args:{body:'V030_AUTHOR_PUBLICATION',selectedDraftIds:[]}}]); return;
+      }
+      const text='Local authoring member completed.';
+      yield {type:'block-start',index:0,blockType:'text'};
+      yield {type:'text-delta',index:0,text};
+      yield {type:'block-end',index:0,block:{type:'text',text}};
+      yield {type:'finish',reason:{kind:'stop'}}; return;
+    }
+`
+
+export async function runAuthoringScenarios({ctx,team,baseConfig,createScenarioConversation,promptOfficialTurn,waitForCompletedTurn,fixtureLog}) {
+ const results=[]
+ for (const concurrency of [1,4]) for (const mode of ['await','resume']) {
+  const config=structuredClone(baseConfig), seed=config.agents[0]
+  config.id=`author-fixture-${mode}-${concurrency}`;config.version='0.3.0'
+  const member=(id,model)=>({...structuredClone(seed),id,name:id,systemPrompt:`V030_AUTHOR_FIXTURE V030_MODE_${mode.toUpperCase()}`,modelRef:{provider:'rp-team-v024-fixture',model},presetId:'',parameters:{},capabilities:[],statePermissions:[],context:{sources:[{type:'current_input'},{type:'agent_messages'}]},communication:{sendTo:[],receiveFrom:['*'],requestTo:[],requestFrom:[]},triggers:[{type:'always'}],execution:{...seed.execution,after:[],onFailure:'continue',trustedTools:[]},outputAuthority:{internal:true,draft:false,state:false,user:false}})
+  const caller=member('author-requester','author-requester'),target=member('author-target','author-target'),publisher=member('author-publisher','author-publisher')
+  caller.communication.requestTo=['author-target'];caller.communication.handoffs=[{id:'lookup',to:'author-target',mode,timeoutMs:10000,onFailure:'stop',responseSelectors:['/summary','/data/answer']}]
+  target.communication.requestFrom=['author-requester'];target.communication.sendTo=['author-requester'];target.triggers=[{type:'requested_by_agent',from:['author-requester']}]
+  publisher.execution.after=['author-requester','author-target'];publisher.outputAuthority.user=true
+  config.agents=[caller,target,publisher];config.output={agentId:publisher.id};config.state={definitions:[{namespace:'shared',path:'/feeling',type:'string',default:'quiet',valueSchema:{type:'string'}},{namespace:'world',path:'/variables/fixture/actorCount',type:'number',valueSchema:{type:'number',minimum:0}}]};config.execution={...config.execution,concurrency,maxPerAgent:3}
+  const scenario=await createScenarioConversation(ctx,team,`Authoring ${mode} c${concurrency}`,config), conversationId=scenario.conversationId
+  const before=await ctx.sessionController.inspect(scenario.sessionId)
+  const catalog=await team.getContextCatalog({conversationId})
+  const preview=await team.previewConfig({conversationId,config,inputText:'test'})
+  assert.equal(preview.members.length,3);assert.equal(preview.members.find(x=>x.id===target.id).triggered,false)
+  assert.equal((await ctx.sessionController.inspect(scenario.sessionId)).events.length,before.events.length,'Preview mutated root native Session')
+  assert.ok(catalog.sources.some(x=>x.type==='character_card'))
+  const initial=await team.getState({conversationId}),operationId=randomUUID()
+  const edit={conversationId,operationId,expectedRevision:initial.revision,expectedWorldHash:initial.worldHash,anchor:initial.anchor,operations:[{namespace:'shared',path:'/feeling',operation:'set',value:'curious'},{namespace:'world',path:'/variables/fixture/actorCount',operation:'set',value:7}]}
+  const edited=await team.applyStateEdit(edit);assert.equal(edited.status,'committed')
+  assert.equal(edited.state.values.find(x=>x.namespace==='world'&&x.path==='/variables/fixture/actorCount').value,7,'Author world edit did not update native values')
+  assert.equal((await team.applyStateEdit(edit)).status,'committed','Duplicate edit was not idempotent')
+  assert.equal((await team.getState({conversationId})).values.find(x=>x.namespace==='shared'&&x.path==='/feeling').value,'curious')
+  await assert.rejects(team.applyStateEdit({...edit,operationId:randomUUID()}),/conflict|revision|changed/i)
+  const saved=await team.savePreset({config});assert.equal((await team.importPreset((await team.exportPreset({id:saved.id,version:saved.version})))).hash,saved.hash)
+  const prompt=await promptOfficialTurn(ctx,scenario.sessionId,`V030_AUTHOR_FIXTURE V030_MODE_${mode.toUpperCase()}`)
+  await prompt.work
+  const completed=await waitForCompletedTurn(ctx,scenario.sessionId,prompt.priorEnds,prompt.afterSeq)
+  const run=(await team.getStatus({conversationId})).run
+  assert.equal(run.phase,'complete')
+  const trace=await team.getTrace({conversationId,runId:run.runId})
+  const executions=trace.executions??trace.executionSessions??[]
+  const requests=readFileSync(fixtureLog,'utf8').trim().split(/\r?\n/).map(JSON.parse).filter(x=>x.messages&&x.messages.some(m=>m.text.includes('V030_AUTHOR_FIXTURE')))
+  const requester=requests.filter(x=>x.model==='author-requester'&&x.messages.some(m=>m.text.includes(run.runId)))
+  assert.ok(requester.length>=2)
+  const requesterIds=new Set(requester.map(x=>x.sessionId))
+  assert.equal(requesterIds.size,mode==='await'?1:2,`${mode} used incorrect native Session identity`)
+  const replies=completed.inspection.events.filter(x=>x.type==='assistant/message'&&x.seq>prompt.afterSeq)
+  assert.equal(replies.length,1,'Authoring round published multiple assistant messages')
+  let checkpointEvidence
+  if (concurrency===1 && mode==='await') {
+   const read=()=>team.getState({conversationId})
+   const setFeeling=async value=>{const current=await read();return team.applyStateEdit({conversationId,operationId:randomUUID(),expectedRevision:current.revision,expectedWorldHash:current.worldHash,anchor:current.anchor,operations:[{namespace:'shared',path:'/feeling',operation:'set',value}]})}
+   const past=await setFeeling('past checkpoint')
+   const checkpoint=(await team.listStateCheckpoints({conversationId})).checkpoints.find(item=>item.id===`author:${past.operationId}`)
+   assert.ok(checkpoint?.canRewind,'Native checkpoint could not be rewound')
+   await setFeeling('changed later')
+   const beforeValues=await ctx.sessionController.inspect(scenario.sessionId), current=await read()
+   await team.restoreStateCheckpoint({conversationId,checkpointId:checkpoint.id,mode:'values',operationId:randomUUID(),expectedRevision:current.revision,expectedWorldHash:current.worldHash,paths:[{namespace:'shared',path:'/feeling'}]})
+   assert.equal((await read()).values.find(x=>x.namespace==='shared'&&x.path==='/feeling').value,'past checkpoint')
+   assert.deepEqual((await ctx.sessionController.inspect(scenario.sessionId)).events,beforeValues.events,'Applying values changed native conversation history')
+   const second=await promptOfficialTurn(ctx,scenario.sessionId,'V030_AUTHOR_FIXTURE V030_MODE_AWAIT second turn')
+   await second.work;await waitForCompletedTurn(ctx,scenario.sessionId,second.priorEnds,second.afterSeq)
+   await setFeeling('after second turn')
+   const modelCalls=()=>readFileSync(fixtureLog,'utf8').trim().split(/\r?\n/).map(JSON.parse).filter(row=>row.provider&&row.sessionId&&Number.isFinite(row.step))
+   const rewindBase=await read(), callsBefore=modelCalls()
+   await team.restoreStateCheckpoint({conversationId,checkpointId:checkpoint.id,mode:'rewind',operationId:randomUUID(),expectedRevision:rewindBase.revision,expectedWorldHash:rewindBase.worldHash})
+   assert.equal((await ctx.sessionController.inspect(scenario.sessionId)).events.filter(x=>x.type==='assistant/message').length,1,'Official rewind did not restore the first-turn branch')
+   assert.equal((await read()).values.find(x=>x.namespace==='shared'&&x.path==='/feeling').value,'past checkpoint')
+   assert.deepEqual(modelCalls(),callsBefore,'State rewind invoked a model')
+   checkpointEvidence={id:checkpoint.id,valuesLeaveHistoryUnchanged:true,rewindRestoresFirstTurn:true,noModelOnRewind:true}
+  }
+  results.push({conversationId,runId:run.runId,mode,concurrency,requesterSessions:[...requesterIds],executionCount:executions.length,editOperationId:operationId,...(checkpointEvidence?{checkpointEvidence}:{})})
+ }
+ return results
+}
