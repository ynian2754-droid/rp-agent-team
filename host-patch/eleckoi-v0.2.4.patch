+    .filter(event => event.type === 'turn/start').map(event => event.data?.turn ?? 0)) + 1
+  if (expectedTurnNumber !== expectedTurn) throw new Error('历史重放轮次与稳定 Session 事件序号不一致。')
+  const turnEnded = deferred()
+  const requestId = randomUUID()
+  const disposeEvents = ctx.on('session/event', (session, event) => {
+    if (String(session.id) !== sessionId) return
+    if (event.type === 'turn/end' && event.data?.turn === expectedTurnNumber) turnEnded.resolve(event)
+  })
