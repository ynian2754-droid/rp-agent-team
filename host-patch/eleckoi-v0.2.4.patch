+    `${phase} synthetic world operation did not commit (actual and expected hashes differ)`)
+  const state = parseJson(statePath).conversations[conversationId]
+  assert.equal(state.namespaces.shared.migrationMarker, `team-${phase}`, `${phase} Team state did not commit`)
+  const requests = ctx.fixtureAdapterRequests
+  assert.ok(requests.some(row => row.model === 'worker' && row.messages.some(message => message.text.includes(`V024_MIGRATED_HISTORY_${phase}`))),
