diff --git a/packages/host/product-data/tests/helpers/schemaV16.ts b/packages/host/product-data/tests/helpers/schemaV16.ts
new file mode 100644
index 0000000..85c4aa0
--- /dev/null
+++ b/packages/host/product-data/tests/helpers/schemaV16.ts
@@ -0,0 +1,25 @@
+import type Database from 'better-sqlite3'
+import { commonSchemaSql } from '../../src/storage/sqlite/migrations/commonSchemaSql'
+
+export const stateOperationTables = ['conversation_state_operations', 'conversation_archive_imports'] as const
+
+export const schemaV17Sql = commonSchemaSql.split('\n')
+  .filter(line => !stateOperationTables.some(name => line.includes(name)))
+  .join('\n').replace(/PRAGMA user_version = \d+;/, 'PRAGMA user_version = 17;')
+
+export const schemaV16Sql = schemaV17Sql.replace('PRAGMA user_version = 17;', 'PRAGMA user_version = 16;')
+  .replace(", `identityJson` TEXT NOT NULL DEFAULT '{}'", '').replace(", `variableIdentityJson` TEXT NOT NULL DEFAULT '{}'", '')
+
+export function removeVariableIdentityColumns(database: Database.Database): void {
+  for (const [table, column] of [['chat_session_variable_states', 'identityJson'], ['conversation_state_snapshots', 'variableIdentityJson']]) {
+    if ((database.pragma(`table_info(${table})`) as { name: string }[]).some(item => item.name === column)) {
+      database.exec(`ALTER TABLE ${table} DROP COLUMN ${column}`)
+    }
+  }
+}
+
+/** Restore the storage columns and tables of the official pre-identity schema. */
+export function restoreV16Storage(database: Database.Database): void {
+  for (const name of stateOperationTables) database.exec(`DROP TABLE IF EXISTS ${name}`)
+  removeVariableIdentityColumns(database)
+}
