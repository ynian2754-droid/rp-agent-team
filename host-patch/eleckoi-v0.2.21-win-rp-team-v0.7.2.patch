diff --git a/apps/desktop-host/src/dshDesktopHeadlessProfile.ts b/apps/desktop-host/src/dshDesktopHeadlessProfile.ts
new file mode 100644
index 0000000..6e9388e
--- /dev/null
+++ b/apps/desktop-host/src/dshDesktopHeadlessProfile.ts
@@ -0,0 +1,66 @@
+import { delimiter } from 'node:path'
+import { loadLayeredEnv, loadProfileDirectory, reportSkippedBundles } from '@deepseek-ai/dsh-app-boot'
+import { runProfile } from '@deepseek-ai/dsh/profile-boot'
+import { ELECKOI_FAILURE_CODES } from '@shared/contracts/errors/codes'
+import { DesktopError } from '@shared/foundation/DesktopError'
+import { ELECKOI_INSTALL_ANCHOR } from './desktopPluginBundles'
+import {
+  prepareDshDesktopProfile,
+  type DshDesktopPluginHostEnvironment,
+  type DshDesktopProfilePaths,
+  type DshDesktopResourceDescriptors
+} from './desktopPluginHost'
+
+export interface DshDesktopHeadlessProfileOptions extends DshDesktopProfilePaths {
+  resources: DshDesktopResourceDescriptors
+  environment?: DshDesktopPluginHostEnvironment
+  profileDirectory?: string
+  bundles?: readonly string[]
+  patchFiles?: readonly string[]
+}
+
+export function resolveDshDesktopResources(environment: NodeJS.ProcessEnv = process.env): DshDesktopResourceDescriptors {
+  const presetTemplatePath = environment.ELECKOI_PRESET_TEMPLATE_PATH
+  const agentPatchPath = environment.ELECKOI_AGENT_PATCH_PATH
+  if (!presetTemplatePath || !agentPatchPath) throw new DesktopError(
+    ELECKOI_FAILURE_CODES.statePrecondition,
+    'DSH Host did not provide its desktop resource paths.',
+    { what: 'DSH 桌面宿主资源路径' }
+  )
+  const nodeBinPath = environment.ELECKOI_NODE_BIN_PATH
+  const packageManagerEntryPath = environment.ELECKOI_PACKAGE_MANAGER_ENTRY_PATH
+  return {
+    presetTemplatePath,
+    agentPatchPath,
+    hostModuleUrl: environment.ELECKOI_DESKTOP_HOST_MODULE_URL ?? new URL('./index.mjs', import.meta.url).href,
+    ...(nodeBinPath ? { nodeBinPath } : {}),
+    ...(packageManagerEntryPath ? { packageManagerEntryPath } : {})
+  }
+}
+
+/** Boots the desktop bundles in a dedicated worker process with its own profile and product paths. */
+export async function runDshDesktopHeadlessProfile(options: DshDesktopHeadlessProfileOptions) {
+  const { resources } = options
+  const launch = prepareDshDesktopProfile(options, resources, options.environment ?? {}, options.profileDirectory, options.bundles)
+  Object.assign(process.env, launch.environment)
+  const profile = loadProfileDirectory('dsh', launch.profile, ELECKOI_INSTALL_ANCHOR)
+  reportSkippedBundles('dsh', profile)
+  return runProfile({
+    environment: loadLayeredEnv('dsh'),
+    profile: 'desktop',
+    resolvedProfile: { profile, installAnchor: ELECKOI_INSTALL_ANCHOR },
+    patchFiles: [launch.overlayPath, ...(options.patchFiles ?? []), resources.agentPatchPath],
+    args: ['--no-open', '--port', '0'],
+    ...(resources.packageManagerEntryPath ? {
+      packageManager: {
+        command: process.execPath,
+        args: ['--expose-internals', resources.packageManagerEntryPath],
+        env: {
+          ELECTRON_RUN_AS_NODE: '1',
+          DSH_DESKTOP_NODE_EXECUTABLE: process.execPath,
+          PATH: [resources.nodeBinPath, process.env.PATH].filter(Boolean).join(delimiter)
+        }
+      }
+    } : {})
+  })
+}
