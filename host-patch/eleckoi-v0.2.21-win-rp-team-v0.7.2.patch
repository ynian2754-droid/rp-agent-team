+  /** @internal Current in-process operation, available before DSH persists its input. */
+  prepared(conversationId?: string, runtimeSessionId?: string): ConversationOperation | undefined {
+    if (!conversationId && !runtimeSessionId) return undefined
+    const entries = conversationId ? [this.current.get(conversationId)] : this.current.values()
+    for (const entry of entries) {
+      if (entry?.settled === false && (!runtimeSessionId || entry.input.runtimeSessionId === runtimeSessionId)) {
+        return entry.input
+      }
+    }
+  }
+
