{
  "name": "@rp-team/dsh-roleplay-team",
  "version": "0.7.2",
  "packageManager": "pnpm@11.22.0",
  "description": "Configurable agent teams for ElecKoi roleplay",
  "license": "AGPL-3.0-or-later",
  "licenseFile": "LICENSE",
  "type": "module",
  "main": "./dist/host/index.mjs",
  "exports": {
    ".": "./dist/host/index.mjs",
    "./client": "./dist/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./dist/host/remote-types.d.ts",
      "default": "./dist/host/remote-types.js"
    },
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "dist/host/remote-types.js",
    "dist/host/remote-types.d.ts",
    "src",
    "scripts",
    "test",
    "tests",
    "locale",
    "cordis.patch.yml",
    "patches",
    "pnpm-workspace.yaml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "pnpm-lock.yaml",
    "examples",
    "预设作者指南.md",
    "docs/authoring-0.4.0.md",
    "docs/implementation-0.4.0.md",
    "docs/tool-decoupling-0.4.1",
    "docs/adaptation-0.5.0",
    "docs/user-manual.zh-CN.md",
    "docs/install-guide.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:client": "node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs tests/*.test.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "preview:serve": "node scripts/serve-preview.mjs",
    "pack:dshbundle": "node scripts/build.mjs && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "esbuild": "0.25.12",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@eleckoi/dsh-client-conversations",
        "@eleckoi/dsh-client-roleplay",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "attachments",
        "kind": "service",
        "title": "DSH file attachments",
        "description": "Read an authorized current-input file through the official attachment store.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@deepseek-ai/dsh-attachment",
        "members": [
          "readFileStream"
        ]
      },
      {
        "id": "rpAgentTeam",
        "kind": "service",
        "title": "RP Agent Team Runtime",
        "description": "为一个稳定的产品会话提供 Team 配置、执行、重试和追踪方法。",
        "mode": "call",
        "scope": "host",
        "relation": "provides",
        "members": [
          "getConfig",
          "saveConfig",
          "getOptions",
          "getStatus",
          "cancel",
          "retry",
          "discardRetry",
          "exportConfig",
          "setManualAgents",
          "listTraces",
          "getTrace",
          "importConfig",
          "getContextCatalog",
          "previewConfig",
          "getState",
          "listStateCheckpoints",
          "applyStateEdit",
          "getStateEditStatus",
          "restoreStateCheckpoint",
          "listPresets",
          "getPreset",
          "savePreset",
          "copyPreset",
          "deletePreset",
          "exportPreset",
          "importPreset",
          "exportComponent",
          "prepareComponentImport",
          "previewParameters",
          "listTrialScenarios",
          "getTrialScenario",
          "saveTrialScenario",
          "deleteTrialScenario",
          "exportTrialScenario",
          "importTrialScenario",
          "freezeTrialSnapshot",
          "startTrial",
          "listTrials",
          "getTrial",
          "cancelTrial",
          "retryTrial",
          "getTrialTrajectory",
          "compareTrial"
        ]
      },
      {
        "id": "rpTeam",
        "kind": "remote",
        "title": "RP Agent Team",
        "description": "读取并维护 RP Agent Team 配置、运行状态与追踪记录。",
        "mode": "call",
        "scope": "host",
        "relation": "provides",
        "members": [
          "getConfig",
          "saveConfig",
          "getOptions",
          "getStatus",
          "cancel",
          "retry",
          "discardRetry",
          "exportConfig",
          "setManualAgents",
          "listTraces",
          "getTrace",
          "importConfig",
          "getContextCatalog",
          "previewConfig",
          "getState",
          "listStateCheckpoints",
          "applyStateEdit",
          "getStateEditStatus",
          "restoreStateCheckpoint",
          "listPresets",
          "getPreset",
          "savePreset",
          "copyPreset",
          "deletePreset",
          "exportPreset",
          "importPreset",
          "exportComponent",
          "prepareComponentImport",
          "previewParameters",
          "listTrialScenarios",
          "getTrialScenario",
          "saveTrialScenario",
          "deleteTrialScenario",
          "exportTrialScenario",
          "importTrialScenario",
          "freezeTrialSnapshot",
          "startTrial",
          "listTrials",
          "getTrial",
          "cancelTrial",
          "retryTrial",
          "getTrialTrajectory",
          "compareTrial"
        ]
      },
      {
        "id": "rpTeamSidebarTab",
        "kind": "contribution",
        "title": "RP Team 工作区标签",
        "description": "向官方右侧栏标签注册器注册 RP Team 工作区页面。",
        "mode": "register",
        "scope": "client",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar-right",
        "members": [
          "register"
        ]
      },
      {
        "id": "sidebar.right.pane.tab",
        "kind": "ui-slot",
        "title": "RP Team 工作区正文",
        "description": "在官方右侧栏编辑团队成员与配置。",
        "mode": "keyed",
        "scope": "session",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-client-ui-sidebar-right",
        "members": [
          "rp-team"
        ]
      },
      {
        "id": "eleckoiConversationsApi",
        "kind": "service",
        "title": "Official product conversation API",
        "description": "Read prepared turn identity and product data; stage state for normal turn commit and query durable outcomes.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@eleckoi/dsh-product-api",
        "members": [
          "list",
          "preparePrompt",
          "preparedTurn",
          "currentTurn",
          "stageTurnState",
          "turnCommitStatus",
          "authorState",
          "details",
          "editCurrentState",
          "stateEditStatus",
          "listStateEdits",
          "exportArchive",
          "importArchiveWithMapping"
        ]
      },
      {
        "id": "eleckoiCharactersApi",
        "kind": "service",
        "title": "eleckoiCharactersApi",
        "description": "Public product data used by runtime admission or isolated trial freeze/import.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@eleckoi/dsh-product-api",
        "members": [
          "export",
          "prepareImport",
          "commitImport"
        ]
      },
      {
        "id": "eleckoiConversationModelsApi",
        "kind": "service",
        "title": "eleckoiConversationModelsApi",
        "description": "Public product data used by runtime admission or isolated trial freeze/import.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@eleckoi/dsh-product-api",
        "members": [
          "current",
          "select"
        ]
      },
      {
        "id": "eleckoiAgentPresetsApi",
        "kind": "service",
        "title": "eleckoiAgentPresetsApi",
        "description": "Public product data used by runtime admission or isolated trial freeze/import.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@eleckoi/dsh-product-api",
        "members": [
          "read",
          "export",
          "prepareImport",
          "commitImport"
        ]
      },
      {
        "id": "eleckoiCharacterConfigurationApi",
        "kind": "service",
        "title": "eleckoiCharacterConfigurationApi",
        "description": "Public product data used by runtime admission or isolated trial freeze/import.",
        "mode": "call",
        "scope": "host",
        "relation": "consumes",
        "owner": "@eleckoi/dsh-product-api",
        "members": [
          "saveSettingLibrary"
        ]
      }
    ]
  },
  "repository": "https://github.com/ynian2754-droid/rp-agent-team.git",
  "homepage": "https://github.com/ynian2754-droid/rp-agent-team#readme",
  "bugs": {
    "url": "https://github.com/ynian2754-droid/rp-agent-team/issues"
  }
}
